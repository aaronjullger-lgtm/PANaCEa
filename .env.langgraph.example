# LangGraph Server Environment
# Copy to .env.langgraph and fill from 1Password
# This file is used by `langgraph dev` and `langgraph deploy`

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=panacea

GEMINI_API_KEY=

# For DeepInfra models (fine-tuned, future):
# DEEPINFRA_API_KEY=
