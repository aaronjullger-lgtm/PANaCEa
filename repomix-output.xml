  await fs.promises.writeFile(exportPath, JSON.stringify(exportData, null, 2));
  console.log(`\n✅ Full analysis exported to: ${exportPath}`);

  // Final summary
  console.log('\n═══════════════════════════════════════════════════════════════════');
