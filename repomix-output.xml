    );
  } catch (error) {
    log.error('Analytics aggregation failed', error);
    return new Response(
      JSON.stringify({
        error: 'Aggregation failed',
        message: error instanceof Error ? error.message : 'Unknown error',
      }),
      {
        status: 500,
        headers: { 'Content-Type': 'application/json' },
      }
    );
  } finally {
