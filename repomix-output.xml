const SPECIAL_CASES: Record<string, string> = {
  hctz: 'HCTZ',
  nsaid: 'NSAID',
  nsaids: 'NSAIDs',
  ace: 'ACE',
  arb: 'ARB',
  ssri: 'SSRI',
