        exit={{ opacity: 0, scale: 0.9, y: 10 }}
        transition={{ duration: 0.2 }}
        className="fixed z-[60] bg-[var(--color-bg-tertiary)] rounded-xl shadow-2xl border border-[var(--color-border)] overflow-hidden"
