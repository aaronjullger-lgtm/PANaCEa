      details: { deletedJobs: deletedJobs.count }, // , deletedChats: deletedChats.count },
      duration: Date.now() - start,
    });
    report.summary.completed++;
  } catch (error: any) {
    report.tasks.push({
      name: 'Database Cleanup',
      status: 'failed',
      message: `Failed: ${error.message}`,
      duration: Date.now() - start,
    });
    report.summary.failed++;
  }
}

/**
