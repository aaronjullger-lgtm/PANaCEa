          <div className="flex items-center gap-2 mb-3">
            <Stethoscope className="w-5 h-5 text-[var(--color-data-pass)]" />
            <h4 className="font-semibold text-[var(--color-text-primary)]">
              First-Line Treatment
            </h4>
