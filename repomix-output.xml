    Cardiovascular: { total: 8, correct: 6, accuracy: 75 }, // 4% actual vs 11% target = 7% DEFICIT
    Pulmonary: { total: 20, correct: 14, accuracy: 70 }, // 10% actual vs 9% target = +1%
