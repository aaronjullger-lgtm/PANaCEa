            } else {
              // Fallback to placeholder stats
              setStats({
                totalUsers: 150,
                activeUsers: 78,
                totalQuestions: 45230,
                avgAccuracy: 76.5,
                pendingFlags: 0,
              });
            }
          } catch (statsError) {
            console.error('Failed to fetch stats:', statsError);
            // Fallback to placeholder stats
            setStats({
              totalUsers: 150,
              activeUsers: 78,
              totalQuestions: 45230,
              avgAccuracy: 76.5,
              pendingFlags: 0,
