                              days
                            </p>
                            <p className="text-xs text-[var(--color-text-muted)] mt-1">
                              {selectedCondition.nextDue.toLocaleDateString('en-US', {
                                weekday: 'long',
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
