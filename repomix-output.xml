                              onTogglePin={(e) => handleTogglePin(calc.id, e)}
                            />
                          ))}
                        </div>
                      </section>
                    )}

                    {/* Recently Used Section */}
                    {!searchQuery && recentCalculatorData.length > 0 && (
                      <section>
                        <div className="flex items-center gap-2 mb-3">
