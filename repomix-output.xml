/**
 * Markdown Styling for Clinical Reference Library
 * 
 * Custom styles for rendering medical content with markdown formatting.
 * Handles bolding, bullet points, numbered lists, and inline code.
 */

/* Base markdown container */
.condition-markdown {
  color: var(--color-text-secondary);
  font-size: 0.875rem;
  line-height: 1.6;
}

/* Headings */
.condition-markdown h1,
.condition-markdown h2,
.condition-markdown h3,
.condition-markdown h4 {
  color: var(--color-text-primary);
  font-weight: 600;
  margin-top: 1rem;
  margin-bottom: 0.5rem;
}

.condition-markdown h1 {
  font-size: 1.5rem;
}
.condition-markdown h2 {
  font-size: 1.25rem;
}
.condition-markdown h3 {
  font-size: 1.125rem;
}
.condition-markdown h4 {
  font-size: 1rem;
}

/* Paragraphs */
.condition-markdown p {
  margin-bottom: 0.75rem;
}

.condition-markdown p:last-child {
  margin-bottom: 0;
}

/* Bold text - important for medical emphasis */
.condition-markdown strong,
.condition-markdown b {
  color: var(--color-text-primary);
  font-weight: 600;
}

/* Italic text */
.condition-markdown em,
.condition-markdown i {
  font-style: italic;
}

/* Lists */
.condition-markdown ul,
.condition-markdown ol {
  margin: 0.5rem 0;
  padding-left: 1.5rem;
}

.condition-markdown ul {
  list-style-type: disc;
}

.condition-markdown ol {
  list-style-type: decimal;
}

.condition-markdown li {
  margin-bottom: 0.25rem;
  color: var(--color-text-secondary);
}

.condition-markdown li::marker {
  color: var(--color-accent);
}

/* Nested lists */
.condition-markdown ul ul,
.condition-markdown ol ul {
  list-style-type: circle;
  margin: 0.25rem 0;
}

.condition-markdown ul ul ul {
  list-style-type: square;
}

/* Inline code - for medical terms, drug names, lab values */
.condition-markdown code {
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  border-radius: 0.25rem;
  padding: 0.125rem 0.375rem;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
