                            <h4 className="font-semibold text-[var(--color-text-primary)] mb-1">
                              Next Review Scheduled
                            </h4>
                            <p className="text-sm text-[var(--color-text-primary)]">
                              Due in{' '}
                              {Math.round(
                                (selectedCondition.nextDue.getTime() - Date.now()) /
                                  (1000 * 60 * 60 * 24)
