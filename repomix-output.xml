          )}

          {/* Weakest System */}
          {data.weakestSystem && (
            <div className="flex items-start gap-3">
              <div className="p-2 bg-[var(--color-warning)]/10 rounded-lg">
                <AlertCircle className="w-4 h-4 text-[var(--color-warning)]" />
