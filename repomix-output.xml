          <span className="font-bold text-yellow-600">
            {' '}
            {STREAK_FREEZE_CONFIG.coinsPerCorrectAnswer}
          </span>{' '}
          coins for correct answers
        </p>
      </div>
    </div>
  );
};

export default StreakFreezeShop;
