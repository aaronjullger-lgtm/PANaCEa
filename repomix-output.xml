          </div>

          {/* Scale labels */}
          <div className="flex justify-between mt-2 text-xs text-[var(--color-text-muted)]">
            <span>{SCALE_MIN}</span>
            <span>{SCALE_MAX}</span>
          </div>
        </div>
      )}

      {/* Projected Pass Date (if not ready) */}
      {prediction.projectedDate && (
