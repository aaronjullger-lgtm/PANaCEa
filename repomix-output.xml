// Answer-revealing keywords to detect in images
const ANSWER_KEYWORDS = [
  // Disease names
  'melanoma',
  'carcinoma',
  'psoriasis',
  'eczema',
  'herpes',
  'shingles',
  'fibrillation',
  'tachycardia',
  'infarction',
  'stemi',
  'nstemi',
  'pneumonia',
  'tuberculosis',
