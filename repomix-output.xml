        </div>
      )}

      {/* Test-Taking Patterns */}
      <div className="bg-[var(--color-bg-primary)] rounded-xl p-4 border border-[var(--color-border)]">
        <h3 className="text-sm font-medium text-[var(--color-text-muted)] mb-4 flex items-center gap-2">
