  const [preceptorFeedback, setPreceptorFeedback] = useState<PreceptorFeedback | null>(null);

  // Clinical Fidelity Mode
  const [clinicalFidelity, setClinicalFidelity] = useState<ClinicalFidelitySettings>(() =>
