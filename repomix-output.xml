function toSlug(text: string): string {
  return text
    .toLowerCase()
    .replace(/\s+/g, '_')
    .replace(/[^a-z0-9_]/g, '');
}

function buildConditionId(system: string, subcategory: string, condition: string): string {
  return `${system}__${toSlug(subcategory)}__${toSlug(condition)}`;
}

