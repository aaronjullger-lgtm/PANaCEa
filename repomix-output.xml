                              bar.isOver
                                ? 'bg-[var(--color-data-provisional)]'
                                : bar.isUnder
                                  ? 'bg-[var(--color-accent)]'
                                  : 'bg-[var(--color-data-pass)]'
                            }`}
                            style={{ width: `${Math.min(bar.percent, 100)}%` }}
                          />
                        </div>
                        <span className="text-xs text-action-muted w-8 text-right">
                          {bar.count}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    </motion.div>
  );
};

