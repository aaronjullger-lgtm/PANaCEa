-- =============================================================================

CREATE TABLE IF NOT EXISTS "UserRolling360Stats" (
    "id" TEXT NOT NULL PRIMARY KEY DEFAULT gen_random_uuid()::text,
    "userId" TEXT NOT NULL,
    
    -- Rolling Aggregates (max 360)
    "totalInWindow" INTEGER NOT NULL DEFAULT 0,
