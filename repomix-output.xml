            </>
          )}
          {!canPurchase && userCoins < STREAK_FREEZE_CONFIG.costPerFreeze && (
            <>
              <AlertCircle className="w-5 h-5" />
              Not Enough Coins
            </>
          )}
          {canPurchase && (
            <>
              <Coins className="w-5 h-5" />
              Purchase Streak Freeze
            </>
          )}
