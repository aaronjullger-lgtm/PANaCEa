    console.log('║                         SUMMARY                                  ║');
    console.log('╚══════════════════════════════════════════════════════════════════╝');
    console.log(`Created: ${success}`);
    console.log(`Failed: ${failed}`);
    console.log(`Total special tests now: ${existing.length + success}`);
  } finally {
    await prisma.$disconnect();
  }
}

main();
