                    </div>
                  </div>

                  {/* Cards Grid */}
                  <div className="flex flex-col gap-4">
                    {group.items.map((drug) => {
                      const globalIndex = filteredDrugs.indexOf(drug);
                      return (
                        <DrugCard
                          key={drug.id}
                          drug={drug}
                          isSelected={selected?.id === drug.id}
                          onClick={() => handleDrugSelect(drug, globalIndex)}
