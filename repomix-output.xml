        averageSessionDuration: sessionMetrics.averageSessionDuration,
        totalStudyTime: sessionMetrics.totalStudyTime,
        fsrsCardsReviewed: fsrsMetrics.fsrsCardsReviewed,
        fsrsCardsMature: fsrsMetrics.fsrsCardsMature,
