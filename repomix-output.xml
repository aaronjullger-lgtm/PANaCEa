  console.log('╚══════════════════════════════════════════════════════════════════╝\n');

  try {
    const existing = await prisma.specialTest.findMany({ select: { name: true } });
    const existingNames = new Set(existing.map((e) => e.name.toLowerCase()));

    const missing = PANCE_SPECIAL_TESTS.filter(
