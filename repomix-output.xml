model QuestionAttempt {
  // ... existing fields ...
  
  // === NEW COMPOSITE INDEXES FOR ROLLING 360 & ANALYTICS ===
  
  // 1. Rolling 360 queries (userId + isMainSession + createdAt)
  @@index([userId, isMainSession, createdAt(sort: Desc)])
  
  // 2. System-level time-series (for system breakdowns)
  @@index([userId, systemNormalized, createdAt])
  
  // 3. Correctness analysis over time
  @@index([userId, wasCorrect, createdAt])
  
  // 4. Question type analytics
  @@index([userId, questionType, createdAt])
  
  // 5. Mode-specific queries (drill vs exam mode)
  @@index([userId, mode, createdAt])
  
