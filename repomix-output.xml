    try {
      // Remove any relation fields that AI might have included
      const { FindingConditionLink, ...createData } = data as any;

      // Clean numeric fields - convert "Not applicable" or other strings to null
      const cleanNumeric = (val: any): number | null => {
        if (typeof val === 'number' && !isNaN(val)) return val;
        if (typeof val === 'string') {
          const num = parseFloat(val);
          if (!isNaN(num)) return num;
        }
        return null;
      };

      const cleanedData = {
        ...createData,
        negativeLR: cleanNumeric(createData.negativeLR),
        positiveLR: cleanNumeric(createData.positiveLR),
        sensitivity: cleanNumeric(createData.sensitivity),
        specificity: cleanNumeric(createData.specificity),
        panceYield: cleanNumeric(createData.panceYield) ?? 0,
      };

      await prisma.physicalExamFinding.create({
        data: {
