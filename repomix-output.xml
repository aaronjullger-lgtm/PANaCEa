  AllContentSchema,
  async (context) => {
    const { env } = context;
    const logger = createEndpointLogger('/api/content/all');
    const prisma = createEdgePrismaClient(env.DATABASE_URL);

    try {
      const allContent = await prisma.medicalContent.findMany({
        where: { status: 'published' },
