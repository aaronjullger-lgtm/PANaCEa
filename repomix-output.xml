    jsonStr = jsonStr.substring(firstBracket, lastBracket + 1);

    // Fix common JSON issues
    jsonStr = jsonStr
      .replace(/['']/g, "'")
      .replace(/[""]/g, '"')
      .replace(/,(\s*[\]}])/g, '$1');

    let parsed: Array<{
      conditionName: string;
      relationshipType: string;
      findingDescription: string;
      isFirstLine: boolean;
