    );
    console.log(`   Sessions Started: ${sessionMetrics.sessionsStarted}`);
    console.log(`   FSRS Cards Reviewed: ${fsrsMetrics.fsrsCardsReviewed}`);

    // Upsert platform statistics
    const stats = await prisma.platformStatistics.upsert({
