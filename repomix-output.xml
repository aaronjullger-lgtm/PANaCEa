      (p) => p.conceptA === conceptId || p.conceptB === conceptId
    );
  }
}

// ============================================================================
// Singleton Export
// ============================================================================

export const learningPatternEngine = new LearningPatternEngine();

// Export class for testing
export { LearningPatternEngine };
