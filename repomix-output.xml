  protocol: string;
  radiationDose: string;
  renalConsiderations: string;
  reportTemplate: string;
  scanDuration: string;

  // Array fields
  alternativeTo: string[];
  boardYieldFacts: string[];
  commonMistakes: string[];
  testQuestionTips: string[];
  whenToAvoid: string[];
  firstLineFor: string[];
  classicSigns: string[];
  indications: string[];

  // JSON field
  keyFindings: Record<string, string>;
}

