          left: position ? `${position.x}px` : '50%',
          top: position ? `${position.y}px` : '50%',
          transform: position ? 'translateY(-100%) translateX(-50%)' : 'translate(-50%, -50%)',
          minWidth: '280px',
          maxWidth: '340px',
        }}
