    >
      {/* Main review schedule badge */}
      <div
        className={`inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border ${
          isCorrect
            ? 'bg-[var(--color-data-pass)]/10 border-[var(--color-data-pass)]/30'
