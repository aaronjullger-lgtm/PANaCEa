// Good pathognomonic examples to keep
const DEFINITELY_GOOD_PATTERNS = [
  /kayser.?fleischer/i,
  /target.?lesion/i,
  /bull.?s?.?eye/i,
  /currant.?jelly/i,
  /cobblestone/i,
