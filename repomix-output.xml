  "whenToOrder": [
    "Clinical indication 1",
    "Clinical indication 2",
    "Include 5-8 indications"
  ],
  "relatedTests": [
    "Related lab test 1 to order together",
    "Related lab test 2",
    "Include 3-5 related tests"
  ],
  "followUpTests": [
    "What to order if this is abnormal",
    "Include 3-5 follow-up tests"
  ],
  
  "clinicalPearls": [
