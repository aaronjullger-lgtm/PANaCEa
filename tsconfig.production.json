{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "App.tsx",
    "main.tsx",
    "vite.config.ts",
    "types",
    "lib/modes",
    "lib/api",
    "lib/sdk",
    "lib/services/dashboardAnalyticsService.ts",
    "lib/services/studyPlanService.ts",
    "lib/services/userProgressService.ts",
    "lib/services/drillReviewService.ts",
    "lib/services/conceptQuestionSelector.ts",
    "lib/conditionSearch.ts",
    "lib/drugSearch.ts",
    "lib/unifiedSearch.ts",
    "lib/utils/apiConfig.ts",
    "functions/api/health.ts",
    "functions/api/conditions/search.ts",
    "functions/api/content/search.ts",
    "functions/api/content/condition/[conditionId].ts",
    "functions/api/drugs/[drugId].ts",
    "functions/api/drugs/search.ts",
    "functions/api/drills/submit-review.ts",
    "functions/api/dashboard/stats.ts",
    "functions/api/dashboard/review-queue.ts",
    "functions/api/questions/attempt.ts",
    "functions/api/questions/explain-rag.ts",
    "functions/api/study/session/generate.ts",
    "functions/api/study/session-summary.ts",
    "functions/api/study-plan/today.ts",
    "functions/api/user/preferences.ts",
    "functions/api/user/stats.ts",
    "functions/api/users/me/daily-plan.ts",
    "services/core/attemptService.ts",
    "services/domain/drugService.ts",
    "services/domain/labService.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".wrangler",
    "routes/**/*",
    "scripts/**/*",
    "e2e/**/*",
    "tests/**/*",
    "docs/**/*",
    "plans/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**/*",
    "**/*.old.*",
    "**/*-Example.*"
  ]
}
