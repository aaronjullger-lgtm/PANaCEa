{
  "name": "@panacea/agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LangGraph agent orchestration layer for StudyPANaCEa dev/ops + content automation. Traced with Langfuse + LangSmith, long-term memory in Qdrant.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/server/api.ts",
    "start": "node dist/server/api.js",
    "run": "tsx src/cli.ts",
    "run:content-audit": "tsx src/cli.ts content-audit",
    "run:pr-triage": "tsx src/cli.ts pr-triage",
    "run:incident-responder": "tsx src/cli.ts incident-responder",
    "run:content-enrichment": "tsx src/cli.ts content-enrichment",
    "run:weekly-report": "tsx src/cli.ts weekly-report",
    "smoke": "tsx src/cli.ts --smoke",
    "ensure-collections": "tsx src/cli.ts --ensure-collections",
    "monitors:provision": "tsx src/cli.ts --monitors",
    "langgraph:dev": "langgraph dev",
    "eval:judge": "tsx src/eval/cli.ts judge",
    "eval:datasets": "tsx src/eval/cli.ts datasets",
    "eval:run": "tsx src/eval/cli.ts run",
    "eval:all": "tsx src/eval/cli.ts all",
    "prompts:push": "tsx src/clients/prompts.cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.0",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/langgraph-supervisor": "^1.1.3",
    "@langchain/openai": "^1.7.0",
    "@langchain/qdrant": "^1.0.3",
    "@langfuse/langchain": "^5.9.1",
    "@linear/sdk": "^88.3.0",
    "@qdrant/js-client-rest": "^1.20.0",
    "composio-core": "^0.5.39",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "langfuse": "^3.39.2",
    "langsmith": "^0.11.0",
    "openai": "^4.95.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.7",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
