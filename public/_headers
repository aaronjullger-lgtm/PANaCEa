# Security Headers for PANaCEa
# This file is automatically deployed to Cloudflare Pages
# See: https://developers.cloudflare.com/pages/platform/headers/

/*
  # Content Security Policy
  # Protects against XSS and other code injection attacks
  # Note: Cloudflare Pages requires CSP on a single line
  # Permits: Vite, Clerk auth, Cloudflare features, Supabase backend
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.clerk.com https://*.cloudflare.com https://challenges.cloudflare.com; connect-src 'self' https://*.clerk.com https://*.supabase.co https://*.studypanacea.com https://clerk.studypanacea.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; frame-src 'self' https://*.clerk.com https://challenges.cloudflare.com;
  
  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff
  
  # Prevent clickjacking attacks
  X-Frame-Options: DENY
  
  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Permissions Policy (restrict sensitive browser APIs)
  Permissions-Policy: geolocation=(self), microphone=(), camera=(), payment=()
  
  # Cache Control for static assets
  Cache-Control: public, max-age=31536000, immutable

# Vite-generated assets - Apply specific CSP for hashed JavaScript chunks
/assets/*
  # Allow all scripts from assets directory (includes Vite content-hashed chunks)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://*.clerk.com https://*.supabase.co https://*.studypanacea.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:;
  Cache-Control: public, max-age=31536000, immutable

# Vendor chunks - shorter cache to handle updates better
/assets/vendor*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Index chunk - shorter cache
/assets/index-*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# Service Worker - Allow service worker to load with appropriate CSP
/sw.js
  Content-Type: application/javascript
  # Service worker-specific CSP with worker-src
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; worker-src 'self' blob:; connect-src 'self' https://*.clerk.com https://*.supabase.co https://*.studypanacea.com;
  Cache-Control: no-cache, no-store, must-revalidate

# Service Worker Registration - Allow registration script to load
/registerSW.js
  Content-Type: application/javascript
  # Registration script CSP
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; worker-src 'self' blob:; connect-src 'self' https://*.clerk.com https://*.supabase.co https://*.studypanacea.com;
  Cache-Control: no-cache, no-store, must-revalidate

# Manifest
/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

# HTML files - no caching (must be before the /* rule)
/
  Cache-Control: no-cache, no-store, must-revalidate
  
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
