### 1.2 Create Safe JSON Parser Utility

```typescript
// lib/utils/jsonParser.ts
export function safeParseJson<T>(value: unknown, fallback: T): T {
  if (value === null || value === undefined) return fallback;
  if (typeof value === 'string') {
    try { return JSON.parse(value); } catch { return fallback; }
  }
  return value as T;
}

export function normalizeToStringArray(value: unknown): string[] {
  if (!value) return [];
  if (Array.isArray(value)) return value.filter(Boolean).map(String);
  if (typeof value === 'string') return [value];
  if (typeof value === 'object') return Object.values(value).filter(Boolean).map(String);
  return [];
}
```

