{
  "extends": "./tsconfig.json",
  "include": [
    // ─── FSRS core ────────────────────────────────────────────────────────────
    "lib/fsrs.ts",
    "lib/fsrs-optimizer-bridge.ts",
    "lib/fsrs-optimizer.ts",
    "lib/fsrs/retrievability.ts",
    "lib/fsrs/eorScheduler.ts",
    "lib/fsrs/simulator.ts",
    "lib/eorFsrsScheduler.ts",
    "lib/fsrsQuestionLinking.ts",

    // ─── Sprint 7: deploy-critical paths ─────────────────────────────────────
    // Behavioral rating (upstream of every FSRS update)
    "lib/implicit-metrics.ts",
