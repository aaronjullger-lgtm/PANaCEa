# =============================================================================
# PANaCEa Environment Variables
# =============================================================================
# Copy this file to .env:  cp env.example .env
# Fill in values. For Cloudflare Pages, configure in Dashboard > Environment Variables.
# NEVER commit .env or real secrets.
# =============================================================================

# Authentication (Clerk)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Database (Prisma Accelerate for Edge: prisma://accelerate.prisma-data.net/?api_key=YOUR_KEY)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key
# Optional: pre-created context cache name (cachedContents/xxx) for PANCE blueprint; used by /api/gemini/stream when client does not send cachedContent
# PANCE_BLUEPRINT_CACHE_NAME=cachedContents/xxx

# Supabase (optional)
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Sentry (optional)
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_UPLOAD=true

# Build/Runtime
VITE_API_URL=https://studypanacea.com

# Adobe (IMS, Firefly, PDF Services)
# Allow-list hosts before use: see docs/deployment/ADOBE_ALLOWLIST.md
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret
# Optional: pre-obtained token (avoids IMS call)
# ADOBE_ACCESS_TOKEN=
# Client-side (e.g. same or separate ID for Embed / Firefly in browser)
VITE_ADOBE_CLIENT_ID=your_adobe_client_id
# PDF Embed API for SmartPDFViewer (optional)
VITE_ADOBE_PDF_EMBED_CLIENT_ID=your_adobe_pdf_embed_client_id
# Document Generation: pre-uploaded template asset ID (study guide / mock exam)
DOC_GEN_TEMPLATE_ASSET_ID=urn:aaid:AS:UE1:your-template-asset-id

# Admin (optional)
ADMIN_USER_IDS=user_clerk_id_1
SUPERADMIN_USER_IDS=user_clerk_id
ENVIRONMENT=development
