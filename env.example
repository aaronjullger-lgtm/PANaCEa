# =============================================================================
# PANaCEa Environment Variables
# =============================================================================
# Copy this file to .env:  cp env.example .env
# Fill in values. For Cloudflare Pages, configure in Dashboard > Environment Variables.
# NEVER commit .env or real secrets.
# =============================================================================

# Authentication (Clerk)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Database (Prisma Accelerate for Edge: prisma://accelerate.prisma-data.net/?api_key=YOUR_KEY)
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Direct database URL for scripts and migrations (non-pooled connection)
DIRECT_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key
# Optional: pre-created context cache name (cachedContents/xxx) for PANCE blueprint; used by /api/gemini/stream when client does not send cachedContent
# PANCE_BLUEPRINT_CACHE_NAME=cachedContents/xxx
# Alternative key name (for backwards compatibility)
# GOOGLE_API_KEY=your_gemini_api_key
# Client-side Gemini key (only if needed for specific features, not recommended)
# VITE_GEMINI_API_KEY=your_gemini_api_key

# Supabase (Storage & Services)
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-side Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key for admin operations (upload, delete, etc.)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Sentry (optional)
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_UPLOAD=true

# Build/Runtime
VITE_API_URL=https://studypanacea.com
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Adobe (IMS, Firefly, PDF Services)
# Allow-list hosts before use: see docs/deployment/ADOBE_ALLOWLIST.md
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret
# Optional: pre-obtained token (avoids IMS call)
# ADOBE_ACCESS_TOKEN=
# Client-side (e.g. same or separate ID for Embed / Firefly in browser)
VITE_ADOBE_CLIENT_ID=your_adobe_client_id
# PDF Embed API for SmartPDFViewer (optional)
VITE_ADOBE_PDF_EMBED_CLIENT_ID=your_adobe_pdf_embed_client_id
# Document Generation: pre-uploaded template asset ID (study guide / mock exam)
DOC_GEN_TEMPLATE_ASSET_ID=urn:aaid:AS:UE1:your-template-asset-id

# Todoist Integration (optional)
VITE_TODOIST_CLIENT_ID=your_todoist_client_id
VITE_TODOIST_CLIENT_SECRET=your_todoist_client_secret

# Admin & Security
ADMIN_USER_IDS=user_clerk_id_1
SUPERADMIN_USER_IDS=user_clerk_id
ENVIRONMENT=development
# Cron job authentication secret
CRON_SECRET=your_secure_random_string

# Email (SMTP - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379

# FSRS Optimizer Service (optional)
FSRS_OPTIMIZER_URL=http://localhost:8080

# Google Cloud (optional - for TTS/other services)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Veo API (optional - for video generation)
# VEO_API_KEY=your_veo_api_key

# Development/Testing
VITE_USE_MOCK=false
BASE_URL=http://localhost:3000

# MCP Server Authentication (for Cursor MCP servers)
# GitHub MCP (create at: GitHub → Settings → Developer settings → Personal access tokens)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
# Supabase Database Access Token (for Postgres MCP - use your Supabase DB password)
SUPABASE_ACCESS_TOKEN=your_supabase_password_here
# Cloudflare MCP
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# Optional MCP servers
FIRECRAWL_API_KEY=your_firecrawl_api_key
CONTEXT7_API_KEY=your_context7_api_key
