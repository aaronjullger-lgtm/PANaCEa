# Clerk Authentication (Get these from https://clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Database (PostgreSQL via Supabase)
# Get connection strings from: Supabase Dashboard > Project Settings > Database
# Use Transaction pooler with ?pgbouncer=true for serverless deployments
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (for migrations) - use Session pooler or direct connection
DIRECT_DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase Configuration (Get these from https://supabase.com/dashboard)
# Project Settings > API
# Server-side (Node.js) configuration
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Client-side (Vite) configuration - needed for browser
# These are the same values as above, but prefixed with VITE_ for client access
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Gemini API (existing)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Background Worker Configuration (Phase 3-5)
BACKGROUND_WORKER_ENABLED=true
JOB_QUEUE_POLL_INTERVAL=5000
HEALTH_CHECK_SCHEDULE=0 3 * * *
MAX_JOB_ATTEMPTS=3
SYNC_DEBOUNCE_DELAY=500

# Node Environment
NODE_ENV=development
PORT=3001

# Email Configuration (Phase 10 - Task 42: Feedback Loop)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=PANaCEa <noreply@panacea.app>
ADMIN_EMAIL=admin@panacea.app

# Multi-Region Configuration (Phase 10 - Task 45)
AWS_REGION=us-west-2
DATABASE_READ_REPLICA_US_WEST=postgresql://user:pass@west-replica.db/panacea
DATABASE_READ_REPLICA_US_EAST=postgresql://user:pass@east-replica.db/panacea

# Application URLs
VITE_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
