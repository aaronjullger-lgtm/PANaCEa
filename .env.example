# Clerk Authentication (Get these from https://clerk.com)
# CRITICAL: Both keys MUST belong to the SAME Clerk application/instance
# Mismatched keys will cause token verification to fail with 401 errors
# - VITE_CLERK_PUBLISHABLE_KEY: Used by frontend to sign tokens
# - CLERK_SECRET_KEY: Used by backend to verify tokens
# Verify pairing: Check that both pk_* and sk_* have matching environment (test/live)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Clerk Routing Configuration (ClerkProvider props — see App.tsx)
# Sign-in and sign-up URLs are configured in the ClerkProvider component, not via env vars

# Clerk Auth Debug Mode (set to 'true' to enable detailed auth logging)
# This helps diagnose issues like "token-not-active-yet" which can be caused by clock skew
# Backend debug (server-side auth middleware)
CLERK_AUTH_DEBUG=false
# Frontend debug (client-side ClerkProvider - auto-enabled in dev mode)
VITE_CLERK_DEBUG=false

# Optional authenticated E2E smoke credentials.
# Used by e2e/production-smoke/core-launch.spec.ts and e2e/auth.setup.ts when E2E_REQUIRE_AUTH=1.
#
# Recommended (backend-based, bypasses MFA):
#   Set E2E_CLERK_TEST_EMAIL + CLERK_SECRET_KEY (already configured above).
#   @clerk/testing/playwright uses the Clerk Backend API to create a sign-in token,
#   completely bypassing the browser sign-in UI and MFA/second-factor requirements.
#   The test user only needs to exist in Clerk — no password or MFA config needed.
#
# Legacy (browser-based, requires MFA disabled):
#   Also set E2E_CLERK_TEST_PASSWORD. The test uses the Clerk sign-in form,
#   so the user must have MFA / Client Trust disabled in the Clerk Dashboard.
#
# Use a dedicated Clerk test user. Never use a production learner or admin account.
# These are server/test-only values and must not be prefixed with VITE_.
E2E_REQUIRE_AUTH=0
E2E_CLERK_TEST_EMAIL=
E2E_CLERK_TEST_PASSWORD=

# Database (PostgreSQL via Supabase)
# Get connection strings from: Supabase Dashboard > Project Settings > Database
# Use Transaction pooler with ?pgbouncer=true for serverless deployments
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (for local Express dev and migrations) - use Session pooler or direct connection
# Local PG-adapter dev adds uselibpqcompat=true at runtime for sslmode=require URLs.
DIRECT_DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# For Cloudflare Pages Functions (Edge Runtime):
# If using Prisma Accelerate for edge compatibility, use prisma:// connection string:
# DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=your_accelerate_api_key"
# 
# Otherwise, standard PostgreSQL connection strings work but without Accelerate features:
# DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Configuration (Get these from https://supabase.com/dashboard)
# Project Settings > API
# Server-side (Node.js) configuration
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Client-side (Vite) configuration - needed for browser
# These are the same values as above, but prefixed with VITE_ for client access
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI Provider Keys (server-side only; do not expose with a VITE_ prefix)
# Multi-provider routing is active — Gemini is FALLBACK only, not primary.
# See lib/langchain/config.ts TASK_MODEL_MAP for task→model routing.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Background Worker Configuration (Phase 3-5)
BACKGROUND_WORKER_ENABLED=true
JOB_QUEUE_POLL_INTERVAL=5000
HEALTH_CHECK_SCHEDULE=0 3 * * *
MAX_JOB_ATTEMPTS=3
SYNC_DEBOUNCE_DELAY=500
CRON_SECRET=replace-with-long-random-token

# Node Environment
NODE_ENV=development
PORT=3001

# Email Configuration (optional — feedback loop)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=PANaCEa <noreply@panacea.app>
ADMIN_EMAIL=admin@panacea.app

# Application URLs
VITE_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ================================================
# Sentry Error Tracking & Monitoring (Sprint 5)
# ================================================
# Get these from: https://sentry.io → Settings → Projects → Your Project → Client Keys
# Client-side error tracking (React app)
VITE_SENTRY_DSN=https://[key]@[org].ingest.sentry.io/[project-id]

# Enable Sentry in development (default: disabled)
VITE_SENTRY_ENABLE_DEV=false

# Source map upload (optional - for production debugging)
# Get auth token from: Sentry → Settings → Auth Tokens → Create New Token
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=panacea
SENTRY_AUTH_TOKEN=sntrys_xxxxx

# CloudFlare Functions error tracking (same DSN or separate project)
SENTRY_DSN=https://[key]@[org].ingest.sentry.io/[project-id]

# Application version (for release tracking)
APP_VERSION=1.0.0
