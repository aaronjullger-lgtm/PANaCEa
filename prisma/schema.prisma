  createdAt    DateTime      @default(now())
  updatedAt    DateTime

  outgoingEdges GraphEdge[] @relation("OutgoingEdges")
  incomingEdges GraphEdge[] @relation("IncomingEdges")

  @@unique([sourceType, sourceId])
  @@index([nodeType])
  @@index([sourceType, sourceId])
  @@index([systemCodes])
  @@index([taxonomyCode])
}

model GraphEdge {
  id            String        @id @default(cuid())
  sourceId      String
  targetId      String
  edgeType      GraphEdgeType
  weight        Float?        @default(1.0)
  description   String?
  evidenceCount Int?          @default(0)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime

  source GraphNode @relation("OutgoingEdges", fields: [sourceId], references: [id], onDelete: Cascade)
  target GraphNode @relation("IncomingEdges", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, edgeType])
  @@index([sourceId])
  @@index([targetId])
  @@index([edgeType])
  @@index([weight])
}

model Alias {
  id         String   @id @default(cuid())
  entityType String // 'Drug', 'Condition', 'AnatomyStructure', 'MedicalContent', …
  entityId   String // ID of the referenced entity
  alias      String // the alias text
  language   String   @default("en")
  isPrimary  Boolean  @default(false) // whether this is the preferred alias
  addedBy    String? // user ID or system source
  addedAt    DateTime @default(now())

  @@unique([entityType, entityId, alias])
  @@index([entityType, entityId])
  @@index([alias]) // for search
}

