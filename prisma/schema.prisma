// ============================================================================
// AI TOKEN USAGE TRACKING
// Phase 1.1: Persist token counts per-endpoint for cost observability.
// Enables per-user, per-model, per-endpoint cost analysis.
// ============================================================================
model AITokenUsage {
  id                   String   @id @default(cuid())
  userId               String?
  endpoint             String /// e.g. '/api/gemini', '/api/gemini/stream', '/api/ai/generate-mnemonic'
  model                String /// e.g. 'gemini-2.5-flash', 'gemini-2.0-flash'
  promptTokenCount     Int      @default(0)
  candidatesTokenCount Int      @default(0)
  totalTokenCount      Int      @default(0)
  /// Estimated cost in USD (computed from model pricing table)
  estimatedCostUsd     Float?
  /// Whether this was a cache hit (semantic cache), useful for measuring savings
  cacheHit             Boolean  @default(false)
  /// Duration of the API call in ms
  latencyMs            Int?
  /// HTTP status code returned
  statusCode           Int?
  createdAt            DateTime @default(now())

  @@index([userId])
  @@index([endpoint])
  @@index([model])
  @@index([createdAt])
  /// Composite index for cost dashboards: cost per user per day
  @@index([userId, createdAt])
  /// Composite for cost per endpoint per day
  @@index([endpoint, createdAt])
}

// ─── IRT/Elo Models (Tier 2, Feature 6) ──────────────────────────

/// Per-item Elo difficulty estimate for adaptive session ordering.
/// Tracks how hard each card is to answer correctly right now (distinct from FSRS D).
model ItemDifficulty {
  id              String   @id @default(cuid())
  cardId          String   @unique
  /// Elo-estimated difficulty on logit scale (0 = average)
  eloDifficulty   Float    @default(0)
  /// IRT 2PL discrimination parameter
  discrimination  Float    @default(1.0)
  /// Glicko-style uncertainty (decreases with observations)
  uncertainty     Float    @default(2.0)
  /// Total student responses for this item
  responseCount   Int      @default(0)
  lastUpdated     DateTime @default(now())

  Card            Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([eloDifficulty])
  @@index([responseCount])
}

/// Per-student, per-domain Elo ability estimate.
/// Tracks student performance level within each PANCE organ system.
model StudentAbility {
  id              String   @id @default(cuid())
  userId          String
  /// PANCE organ system domain (e.g., 'Cardiovascular', 'Pulmonary')
  domain          String
  /// Elo-estimated ability on logit scale (0 = average)
  eloAbility      Float    @default(0)
  /// Glicko-style uncertainty
  uncertainty     Float    @default(2.0)
  /// Total responses in this domain
  responseCount   Int      @default(0)
  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId])
  @@index([userId, domain])
}

/// Question-level embedding for KARL-inspired semantic spacing.
/// Stores Gemini text-embedding-004 vectors (768 dims) for each question.
/// Embedding column is vector(768) managed via raw SQL (pgvector).
model QuestionEmbedding {
  id          String               @id @default(cuid())
  questionId  String               @unique
  /// Embedding model used (for future multi-model support)
  model       String               @default("text-embedding-004")
  /// Source text that was embedded (for debugging/re-embedding)
  embeddedText String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  question    PreGeneratedQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ============================================================================
// A/B TESTING
// Manages experiments, user assignment, exposure tracking, and conversions.
// ============================================================================

enum ABExperimentStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

/// An A/B experiment with one or more variants and optional targeting rules.
model ABExperiment {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  status      ABExperimentStatus @default(DRAFT)
  /// JSON array of { name: string, weight: number, config?: object }
  variants    Json               @default("[]")
  /// Percentage of traffic to include (0-100). 100 = all users.
  trafficPercentage Int           @default(100)
  /// JSON array of learner stage filters, e.g. ["DIDACTIC", "CLINICAL"]. Empty = all stages.
  targetLearnerStages Json        @default("[]")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  exposures   ABExposure[]
  conversions ABConversion[]

  @@index([status])
  @@index([createdAt])
}

/// Records the first time a user sees a variant in an experiment.
/// Deduped per (userId, experimentId) — subsequent exposures are ignored.
model ABExposure {
  id            String       @id @default(cuid())
  userId        String
  experimentId  String
  variantName   String
  createdAt     DateTime     @default(now())
  experiment    ABExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([userId, experimentId])
  @@index([userId])
  @@index([experimentId])
  @@index([variantName])
  @@index([createdAt])
}

/// Records a conversion event for a user in a specific experiment variant.
/// One user may have multiple conversion events per experiment (e.g. multiple sessions).
model ABConversion {
  id            String       @id @default(cuid())
  userId        String
  experimentId  String
  variantName   String
  /// The event name, e.g. "question_answered", "review_completed"
  eventName     String
  /// Optional numeric value (e.g. accuracy, time spent)
  value         Float?
  metadata      Json?
  createdAt     DateTime     @default(now())
  experiment    ABExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([experimentId])
  @@index([eventName])
  @@index([experimentId, variantName])
  @@index([createdAt])
}

// ============================================================================
// CONTENT QUALITY FEEDBACK LOOP
// Flags questions failing psychometric thresholds, triggers AI self-refine,
// and tracks the regeneration → human review pipeline.
// ============================================================================

enum ContentQualityFlagType {
  NON_DISCRIMINATING
  NEGATIVE_DISCRIMINATION
  NEGATIVE_RPB
  TOO_EASY
  TOO_HARD
  NON_FUNCTIONING_DISTRACTOR
  INSUFFICIENT_DATA
}

enum ContentQualityFlagStatus {
  FLAGGED
  REGENERATING
  REVIEWED
  RESOLVED
}

/// Psychometric quality flag for a question. Created by the content quality
/// feedback loop cron job when an item fails discrimination, point-biserial,
/// or distractor analysis thresholds. Tracks status through regeneration.
model ContentQualityFlag {
  id                 String                   @id @default(cuid())
  questionId         String
  /// Which quality criterion failed (matches ItemFlagType from itemAnalysisService)
  flagType           ContentQualityFlagType
  /// Full ItemAnalysis metrics JSON (discrimination, pointBiserial, difficulty, flags, grade)
  metrics            Json
  /// Pipeline status: flagged → regenerating → reviewed → resolved
  status             ContentQualityFlagStatus @default(FLAGGED)
  /// AI-generated improved question content (from selfRefineService), null until regeneration
  regeneratedContent Json?
  /// Critique feedback from the AI self-refine step
  critiqueFeedback   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  resolvedAt         DateTime?
  /// Clerk ID of the human who resolved this flag
  resolvedBy         String?

  @@index([questionId])
  @@index([status])
  @@index([flagType])
  @@index([createdAt])
  @@index([status, createdAt])
}
