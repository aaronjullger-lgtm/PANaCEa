// =============================================================================
// JUNCTION TABLES: Content-Condition Relationships
// =============================================================================

/// Links Drugs to Conditions with relationship type
model DrugConditionLink {
  id               String  @id @default(uuid())
  drugId           String
  conditionId      String
  relationshipType String // "first_line", "second_line", "adjunct", "contraindicated", "caution"
  evidenceLevel    String? // A, B, C, D
  notes            String? @db.Text
  isFirstLine      Boolean @default(false)

  drug      Drug      @relation(fields: [drugId], references: [id], onDelete: Cascade)
  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([drugId, conditionId, relationshipType])
  @@index([conditionId])
  @@index([relationshipType])
}

/// Links Labs to Conditions with diagnostic context
model LabConditionLink {
  id               String  @id @default(uuid())
  labTestId        String
  conditionId      String
  relationshipType String // "diagnostic", "screening", "monitoring", "prognostic"
  expectedResult   String? // "elevated", "decreased", "normal", "variable"
  significance     String? @db.Text // Clinical significance of result
  sensitivity      Float? // For this condition
  specificity      Float? // For this condition

  labTest   LabTest   @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labTestId, conditionId, relationshipType])
  @@index([conditionId])
  @@index([relationshipType])
}

/// Links Imaging to Conditions with findings
model ImagingConditionLink {
  id               String   @id @default(uuid())
  imagingId        String
  conditionId      String
  relationshipType String // "first_line", "gold_standard", "adjunct", "follow_up"
  expectedFindings String[] @default([]) // What you'd expect to see
  classicFindings  String? // Pathognomonic finding
  sensitivity      Float?
  specificity      Float?

  imaging   ImagingStudy @relation(fields: [imagingId], references: [id], onDelete: Cascade)
  condition Condition    @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([imagingId, conditionId, relationshipType])
  @@index([conditionId])
  @@index([relationshipType])
}

/// Links Physical Exam Findings to Conditions
model FindingConditionLink {
  id               String  @id @default(uuid())
  findingId        String
  conditionId      String
  relationshipType String // "pathognomonic", "common", "occasional", "rare"
  clinicalContext  String? @db.Text
  sensitivity      Float?
  specificity      Float?

  finding   PhysicalExamFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  condition Condition           @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([findingId, conditionId])
  @@index([conditionId])
  @@index([relationshipType])
}

/// Links Anatomy to Conditions
model AnatomyConditionLink {
  id               String  @id @default(uuid())
  anatomyId        String
  conditionId      String
  relationshipType String // "affected", "injured", "involved", "preserved"
  clinicalContext  String? @db.Text

  anatomy   AnatomyStructure @relation(fields: [anatomyId], references: [id], onDelete: Cascade)
  condition Condition        @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([anatomyId, conditionId])
  @@index([conditionId])
  @@index([relationshipType])
}

/// Links Physiology Concepts to Conditions
model PhysiologyConditionLink {
  id               String  @id @default(uuid())
  physiologyId     String
  conditionId      String
  relationshipType String // "underlying", "compensatory", "impaired", "relevant"
  explanation      String? @db.Text

  physiology PhysiologyConcept @relation(fields: [physiologyId], references: [id], onDelete: Cascade)
  condition  Condition         @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([physiologyId, conditionId])
  @@index([conditionId])
  @@index([relationshipType])
}

/// Links Treatments to Conditions
model TreatmentConditionLink {
  id               String  @id @default(uuid())
  treatmentId      String
  conditionId      String
  relationshipType String // "first_line", "second_line", "adjunct", "salvage", "contraindicated"
  evidenceLevel    String?
  isFirstLine      Boolean @default(false)
  notes            String? @db.Text

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([treatmentId, conditionId, relationshipType])
  @@index([conditionId])
  @@index([relationshipType])
  @@index([isFirstLine])
}

/// Links Procedures to Conditions
model ProcedureConditionLink {
  id               String  @id @default(uuid())
  procedureId      String
  conditionId      String
  relationshipType String // "diagnostic", "therapeutic", "both"
  indication       String? @db.Text
  isFirstLine      Boolean @default(false)

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([procedureId, conditionId])
  @@index([conditionId])
  @@index([relationshipType])
}
