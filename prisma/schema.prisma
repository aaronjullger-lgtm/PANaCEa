/// Shadow/offline calibration telemetry for FSRS scheduling evaluation.
/// One row per ReviewLog emission — captures predicted retrievability at the
/// moment of grading so Brier / log-loss / ECE can be computed against the
/// *realized* outcome on the next review of the same (userId, questionId).
/// NOT used by the scheduler. Fire-and-forget. Safe to truncate.
model CalibrationLog {
  id                       String      @id @default(cuid())
  userId                   String
  questionId               String?
  conditionId              String?
  /// FK (soft) to the ReviewLog that PRODUCED this prediction
  reviewLogId              String?
  /// FK (soft) to the prior ReviewLog whose scheduled retrievability was realized here
  outcomeReviewLogId       String?
  /// Predicted retrievability the scheduler would have assigned at this review's time
  predictedRetrievability  Float
  stabilityAtPrediction    Float
  difficultyAtPrediction   Float
  intervalDaysAtPrediction Float
  /// Rating actually fed to FSRS (binary: 1=Again, 3=Good)
  ratingFed                Int
  elapsedDaysAtOutcome     Float
  actualOutcome            Boolean
  implicitConfidence       Float?
  rapidGuess               Boolean     @default(false)
  /// One of: 'indecision' | 'hint_assisted' | 'confidence_boost' | 'elimination_boost' | 'elimination_penalty' | 'none'
  ghostGraderRule          String?
  /// One of: 'full' | 'partial' | 'minimal'
  telemetryQuality         String?
  /// Wilson score lower bound (90% CI) of recency-weighted accuracy at time of review
  wilsonLower              Float?
  isMastered               Boolean?
  /// True when the prior review was a high-confidence error AND this review was correct
  hypercorrectionEligible  Boolean     @default(false)
  sessionType              SessionType @default(MAIN)
  fsrsVersion              String      @default("6.0")
  createdAt                DateTime    @default(now())
  User                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, questionId])
  @@index([conditionId, createdAt])
  @@index([hypercorrectionEligible, createdAt])
}

