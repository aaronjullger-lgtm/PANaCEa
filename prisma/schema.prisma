/// Represents a physical exam finding
model PhysicalExamFinding {
  id                   String  @id @default(uuid())
  name                 String  @unique
  system               String // CV, PULM, GI, NEURO, etc.
  description          String? @db.Text
  clinicalSignificance String? @db.Text

  // ===== NEW: PANCE Prioritization =====
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // ===== NEW: Classification =====
  category      String? // Inspection, Palpation, Percussion, Auscultation
  findingType   String? // Sign, symptom, maneuver result
  aliases       String[] @default([]) // Alternative names
  eponymousName String? // Named after whom (e.g., "Chvostek sign")

  // ===== NEW: Technique =====
  howToElicit     String?  @db.Text // How to look for/produce this finding
  equipmentNeeded String[] @default([])
  patientPosition String? // Position required
  videoUrl        String? // Link to demonstration video
  imageUrl        String? // Link to image

  // ===== NEW: Clinical Correlation =====
  positiveIndicates  String[] @default([]) // Conditions if positive
  negativeIndicates  String[] @default([]) // Conditions if negative
  differentialFor    String[] @default([]) // What conditions to consider
  associatedFindings String[] @default([]) // Other findings often present

  // ===== NEW: Test Characteristics =====
  sensitivity     Float? // 0-100
  specificity     Float? // 0-100
  positiveLR      Float? // Positive likelihood ratio
  negativeLR      Float? // Negative likelihood ratio
  evidenceQuality String? // Strong, moderate, limited, expert opinion

  // ===== NEW: Documentation =====
  howToDocument  String?  @db.Text // How to chart this finding
  gradingScale   String? // How to grade severity
  normalVariants String[] @default([])

  // ===== NEW: Teaching Points =====
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])

  // ===== NEW: Relations =====
  conditionLinks FindingConditionLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([system])
  @@index([category])
  @@index([panceYield])
}

/// Represents a clinical practice guideline (e.g. USPSTF, AHA)
model PracticeGuideline {
  id              String   @id @default(uuid())
  name            String   @unique
  organization    String
  category        String
  year            Int?
  summary         String?  @db.Text
  recommendations String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
}

/// Represents a physiology concept
model PhysiologyConcept {
  id                   String   @id @default(uuid())
  name                 String   @unique
  displayName          String?
  aliases              String[]
  system               String? // CV, PULM, RENAL, etc.
  category             String // Cellular, Organ System, Regulatory, etc.
  description          String?
  mechanism            String?  @db.Text
  clinicalSignificance String?  @db.Text
  relatedConditions    String[]
  relatedDrugs         String[]

  // ===== NEW: PANCE Prioritization =====
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // ===== NEW: Detailed Mechanism =====
  molecularBasis     String?  @db.Text // Molecular/cellular level
  signalTransduction String?  @db.Text // Signaling pathways involved
  regulatoryFactors  String[] @default([]) // What regulates this
  feedbackLoops      String?  @db.Text // Positive/negative feedback
  normalValues       String? // Normal physiologic values

  // ===== NEW: Pathophysiology Links =====
  pathophysiology        String?  @db.Text // What happens when it goes wrong
  compensatoryMechanisms String[] @default([])
  decompensationSigns    String[] @default([])

  // ===== NEW: Drug Effects =====
  drugTargets String[] @default([]) // Drugs that affect this
  drugEffects Json? // [{ drug, effect, mechanism }]

  // ===== NEW: Lab Correlates =====
  associatedLabs String[] @default([]) // Labs that measure/reflect this
  labChanges     Json? // [{ condition, labChanges }]

  // ===== NEW: Graphs & Curves =====
  curveType        String? // Frank-Starling, Oxygen-Hemoglobin, etc.
  curveDescription String? @db.Text
  curveShifts      Json? // [{ factor, direction, clinicalExample }]
  graphUrl         String? // URL to physiologic graph

  // ===== NEW: Equations =====
  keyEquations Json? // [{ name, formula, variables, clinicalUse }]

  // ===== NEW: Comparisons =====
  compareContrast Json? // [{ concept, similarities, differences }]

  // ===== NEW: Teaching Points =====
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])

  // ===== NEW: Relations =====
  conditionLinks PhysiologyConditionLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([system])
  @@index([category])
  @@index([panceYield])
}

/// Represents a treatment or intervention
model Treatment {
  id                String   @id @default(uuid())
  name              String   @unique
  displayName       String?
  aliases           String[]
  category          String // Medical, Surgical, Procedural, Physical Therapy, Lifestyle
  type              String? // First-line, Second-line, Adjunct, Salvage
  description       String?
  mechanism         String?  @db.Text
  dosing            String?  @db.Text
  sideEffects       String[]
  indications       String[]
  contraindications String[]
  complications     String[]

  // ===== NEW: PANCE Prioritization =====
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  isFirstLine     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // ===== NEW: Evidence & Guidelines =====
  evidenceLevel   String? // A, B, C, D or Grade I, II, III
  guidelineSource String? // AHA, ACS, IDSA, etc.
  guidelineYear   Int?
  recommendation  String? @db.Text

  // ===== NEW: Timing & Duration =====
  timing       String? // Acute, chronic, maintenance
  duration     String? // How long to treat
  timeToEffect String? // When to expect improvement
  followUp     String? @db.Text // Required follow-up

  // ===== NEW: Comparison =====
  alternativeTo       String[] @default([])
  advantages          String[] @default([])
  disadvantages       String[] @default([])
  comparativeEfficacy String?  @db.Text

  // ===== NEW: Special Populations =====
  pregnancySafe     Boolean?
  pregnancyNotes    String?  @db.Text
  pediatricUse      String?  @db.Text
  geriatricUse      String?  @db.Text
  renalDoseAdjust   String?  @db.Text
  hepaticDoseAdjust String?  @db.Text

  // ===== NEW: Cost & Access =====
  estimatedCost     String? // $, $$, $$$, $$$$
  insuranceCoverage String?
  genericAvailable  Boolean @default(false)

  // ===== NEW: Teaching Points =====
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])

  // ===== NEW: Relations =====
  conditionLinks TreatmentConditionLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([type])
  @@index([panceYield])
  @@index([isFirstLine])
}

/// Represents a differential diagnosis entry
model DifferentialDiagnosis {
  id                  String   @id @default(uuid())
  presentingComplaint String   @unique // e.g., "Chest Pain", "Dyspnea"
  category            String // System category
  isEmergency         Boolean  @default(false)
  differentialList    String[]
  mustNotMiss         String[]
  workup              String?  @db.Text
  pearls              String?  @db.Text

  // ===== NEW: PANCE Prioritization =====
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // ===== NEW: Clinical Presentation =====
  aliases             String[] @default([]) // Other terms for same complaint
  typicalPresentation String?  @db.Text
  redFlags            String[] @default([]) // Alarming features
  reassuringFeatures  String[] @default([]) // Benign indicators

  // ===== NEW: Organized Differentials =====
  mostCommon    String[] @default([]) // Most likely diagnoses
  mostDangerous String[] @default([]) // Life-threatening
  oftenMissed   String[] @default([]) // Frequently overlooked
  byAge         Json? // { pediatric: [], adult: [], geriatric: [] }
  byAcuity      Json? // { emergent: [], urgent: [], nonurgent: [] }

  // ===== NEW: Diagnostic Approach =====
  keyQuestions        String[] @default([]) // History questions to ask
  keyExamFindings     String[] @default([]) // PE findings to look for
  initialWorkup       String[] @default([]) // First-line tests
  advancedWorkup      String[] @default([]) // Second-line tests
  diagnosticAlgorithm String?  @db.Text

  // ===== NEW: Distinguishing Features =====
  distinguishingFeatures Json? // [{ condition, keyFeatures, helps differentiate from }]

  // ===== NEW: Clinical Decision Rules =====
  applicableRules     String[] @default([]) // e.g., Wells criteria, PERC rule
  dispositionGuidance String?  @db.Text

  // ===== NEW: Teaching Points =====
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([panceYield])
  @@index([isEmergency])
}

model FirstLineTreatment {
  id        String   @id @default(uuid())
  condition String
  treatment String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Represents a seed for generating question variations
model QuestionSeed {
  id            String    @id @default(uuid())
  conditionId   String
  questionType  String
  system        String?
  corePathology String
  variables     Json
  template      String
  correctAnswer String
  distractors   String[]
  explanation   String
  difficulty    String
  tags          String[]
  usageCount    Int       @default(0)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([conditionId])
  @@index([system])
}

/// Tracks user interactions with clinical pearls
model UserPearl {
  id           String    @id @default(uuid())
  userId       String
  pearlId      String
  isSaved      Boolean   @default(false)
  savedAt      DateTime?
  viewedAt     DateTime?
  markedUseful Boolean   @default(false)
  notes        String?

  user  User          @relation(fields: [userId], references: [id])
  pearl ClinicalPearl @relation(fields: [pearlId], references: [id])

  @@unique([userId, pearlId])
