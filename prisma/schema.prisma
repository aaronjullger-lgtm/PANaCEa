generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ACLSAlgorithm {
  id                  String   @id(map: "ACLSQuestion_pkey")
  algorithm           String
  correctIndex        Int
  category            String
  explanation         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  algorithmName       String?
  algorithmStep       Int?
  boardYieldFacts     String[] @default([])
  clinicalContext     String?
  clinicalPearls      String[] @default([])
  commonMistakes      String[] @default([])
  correctIntervention String?
  cprGuidance         String?
  criticalActions     String[] @default([])
  drugDose            String?
  drugTiming          String?
  ecgFindings         String[] @default([])
  energyDose          String?
  isHighYield         Boolean  @default(false)
  mnemonics           String[] @default([])
  panceYield          Int?
  patientAge          String?
  relatedAlgorithms   String[] @default([])
  rhythm              String?
  rhythmDescription   String?
  testQuestionTips    String[] @default([])
  videoUrl            String?

  @@index([algorithmName], map: "ACLSQuestion_algorithmName_idx")
  @@index([category], map: "ACLSQuestion_category_idx")
  @@index([panceYield], map: "ACLSQuestion_panceYield_idx")
  @@index([rhythm], map: "ACLSQuestion_rhythm_idx")
}

model AnatomyConditionLink {
  id               String           @id
  anatomyId        String
  conditionId      String
  relationshipType String
  clinicalContext  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  medicalContentId String?
  AnatomyStructure AnatomyStructure @relation(fields: [anatomyId], references: [id], onDelete: Cascade)
  Condition        Condition        @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  MedicalContent   MedicalContent?  @relation(fields: [medicalContentId], references: [id], onDelete: Cascade)

  @@unique([anatomyId, conditionId])
  @@index([conditionId])
  @@index([medicalContentId])
  @@index([relationshipType])
}

model AnatomyStructure {
  id                   String                 @id
  name                 String                 @unique
  system               String
  region               String?
  type                 String?
  description          String?
  function             String?
  innervation          String?
  bloodSupply          String?
  clinicalSignificance String?
  imageUrl             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  abbreviation         String?
  aliases              String[]               @default([])
  anastomoses          String[]               @default([])
  attachments          String[]               @default([])
  autonomicFunction    String?
  boardYieldFacts      String[]               @default([])
  borders              String?
  branches             String[]               @default([])
  clinicalPearls       String[]               @default([])
  commonMistakes       String[]               @default([])
  commonPathology      String[]               @default([])
  contents             String[]               @default([])
  dermatome            String?
  diagramUrl           String?
  examFindings         String[]               @default([])
  imagingFindings      String[]               @default([])
  injuryMechanism      String?
  insertion            String?
  isHighYield          Boolean                @default(false)
  latinName            String?
  layers               String[]               @default([])
  mnemonics            String[]               @default([])
  modelUrl             String?
  motorFunction        String?
  myotome              String?
  nervePath            String?
  nerveRoots           String?
  origin               String?
  palpationTips        String?
  panceYield           Int?
  relations            String?
  sensoryFunction      String?
  surfaceLandmarks     String[]               @default([])
  surgicalApproach     String?
  testQuestionTips     String[]               @default([])
  tributaries          String[]               @default([])
  vesselPath           String?
  videoUrl             String?
  AnatomyConditionLink AnatomyConditionLink[]
  MediaAsset           MediaAsset[]
  Condition            Condition[]            @relation("AnatomyStructureToCondition")
  anatomyModelId       String?
  AnatomyModel         AnatomyModel?          @relation("AnatomyStructureToAnatomyModel", fields: [anatomyModelId], references: [id])

  @@index([name])
  @@index([panceYield])
  @@index([region])
  @@index([system])
}

model AnatomyModel {
  id          String   @id @default(cuid())
  name        String   @unique
  system      String
  modelUrl    String // URL to .glb/.glTF file
  citation    String? // NIH citation or source
  structures  Json? // string[] (references AnatomyStructure.id)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  AnatomyStructures AnatomyStructure[] @relation("AnatomyStructureToAnatomyModel")

  @@index([system])
}

model AntibioticConditionLink {
  id                  String              @id
  antibioticId        String
  conditionId         String
  isFirstLine         Boolean             @default(false)
  evidenceLevel       String?
  dosing              String?
  duration            String?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now())
  medicalContentId    String?
  AntibioticGuideline AntibioticGuideline @relation(fields: [antibioticId], references: [id], onDelete: Cascade)
  Condition           Condition           @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  MedicalContent      MedicalContent?     @relation(fields: [medicalContentId], references: [id], onDelete: Cascade)

  @@unique([antibioticId, conditionId])
  @@index([antibioticId])
  @@index([conditionId])
  @@index([isFirstLine])
  @@index([medicalContentId])
}

model AntibioticGuideline {
  id                      String                    @id
  organism                String
  class                   String
  effective               Json
  resistant               Json
  notes                   String?
  description             String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  aliases                 String[]                  @default([])
  alternativeAntibiotics  String[]                  @default([])
  arrangement             String?
  boardYieldFacts         String[]                  @default([])
  carbapenemResistant     Boolean                   @default(false)
  classicPresentation     String?
  clinicalPearls          String[]                  @default([])
  commonInfections        String[]                  @default([])
  commonMistakes          String[]                  @default([])
  cultureCharacteristics  String?
  deEscalationGuidance    String?
  diagnosticClues         String[]                  @default([])
  doseRecommendations     Json?
  emergingResistance      String[]                  @default([])
  esblProducer            Boolean                   @default(false)
  firstLineAntibiotics    String[]                  @default([])
  gramStain               String?
  growthConditions        String?
  infectionControl        String[]                  @default([])
  isHighYield             Boolean                   @default(false)
  mnemonics               String[]                  @default([])
  morphology              String?
  mrResistance            Boolean                   @default(false)
  panceYield              Int?
  prophylaxis             String?
  reservoirs              String[]                  @default([])
  resistanceMechanisms    String[]                  @default([])
  testQuestionTips        String[]                  @default([])
  transmission            String[]                  @default([])
  treatmentDuration       String?
  vaccines                String[]                  @default([])
  vancomycinResistant     Boolean                   @default(false)
  virulenceFactors        String[]                  @default([])
  AntibioticConditionLink AntibioticConditionLink[]

  @@index([class])
  @@index([gramStain])
  @@index([organism])
  @@index([panceYield])
}

model AuditLog {
  id         String   @id
  action     String
  entityType String   @default("SYSTEM")
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([entityId])
}

model BackgroundJob {
  id           String    @id
  jobType      String
  status       String    @default("pending")
  priority     Int       @default(5)
  payload      Json
  result       Json?
  error        String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  scheduledFor DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([jobType])
  @@index([priority, status])
  @@index([scheduledFor])
  @@index([status])
}

model BaselineAssessment {
  id               String   @id
  userId           String   @unique
  completedAt      DateTime @default(now())
  totalQuestions   Int
  correctAnswers   Int
  accuracy         Float
  systemBreakdown  Json
  weakestSystems   String[]
  strongestSystems String[]

  @@index([userId])
}

model BehaviorLog {
  id                String          @id
  questionAttemptId String
  confidenceScore   Float
  impliedRating     Int?
  rawResponse       String?
  createdAt         DateTime        @default(now())
  QuestionAttempt   QuestionAttempt @relation(fields: [questionAttemptId], references: [id], onDelete: Cascade)

  @@index([questionAttemptId])
}

model BranchChange {
  id            String        @id
  branchId      String
  contentId     String
  conditionId   String
  changeType    String
  contentData   Json
  previousData  Json?
  createdBy     String
  createdAt     DateTime      @default(now())
  ContentBranch ContentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([conditionId])
  @@index([contentId])
  @@index([createdAt])
}

model Buzzword {
  id          String        @id
  buzzword    String
  condition   String
  system      String
  subcategory String?
  explanation String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  DailyWordle DailyWordle[]

  @@index([condition])
  @@index([system])
}

/// Canonical FSRS card model. Maps 1:1 to ts-fsrs FSRSCard interface.
/// state: 0=New, 1=Learning, 2=Review, 3=Relearning (FSRSState)
/// progressContext partitions FSRS state. Under the three-mode taxonomy (April 2026):
/// TARGETED is the sole canonical FSRS writer. READINESS is vestigial (retained for schema compat).
model Card {
  id              String          @id
  userId          String
  questionId      String
  progressContext ProgressContext @default(READINESS)
  due             DateTime
  stability       Float           @default(0.0)
  difficulty      Float           @default(0.0)
  elapsed_days    Float           @default(0.0)
  scheduled_days  Float           @default(0.0)
  reps            Int             @default(0)
  lapses          Int             @default(0)
  state           Int             @default(0)
  last_review     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  ItemDifficulty  ItemDifficulty?
  Question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId, progressContext])
  @@index([questionId])
  @@index([userId, due])
  @@index([userId, state])
  @@index([userId, progressContext, due])
}

model CaseRubric {
  id                   String               @id
  caseId               String               @unique
  checklist            Json
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  PatientEncounterCase PatientEncounterCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model ClinicalGuideline {
  id              String   @id
  name            String
  description     String
  clinicalContext String?
  maxScore        Int
  components      Json
  scoringMap      Json?
  vignettes       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model ClinicalPearl {
  id                 String               @id
  system             String
  createdAt          DateTime             @default(now())
  category           String?
  extractedAt        DateTime             @default(now())
  fullExplanation    String?
  pearlText          String
  questionId         String?
  updatedAt          DateTime
  usefulVotes        Int                  @default(0)
  viewCount          Int                  @default(0)
  tags               String[]
  conditionId        String?
  medicalContentId   String?
  Condition          Condition?           @relation(fields: [conditionId], references: [id])
  MedicalContent     MedicalContent?      @relation(fields: [medicalContentId], references: [id])
  PearlConditionLink PearlConditionLink[]
  UserPearl          UserPearl[]

  @@index([category])
  @@index([conditionId])
  @@index([medicalContentId])
  @@index([questionId])
  @@index([system])
}

model Cohort {
  id            String          @id
  name          String
  code          String          @unique
  description   String?
  institution   String?
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  CohortMember  CohortMember[]
  PeerStatistic PeerStatistic[]

  @@index([isPublic])
  @@index([name])
}

model CohortMember {
  id       String     @id
  userId   String
  cohortId String
  role     CohortRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  Cohort   Cohort     @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  User     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([cohortId])
  @@index([userId])
}

model ConceptGap {
  id         String   @id
  userId     String
  system     String // e.g. "cardiovascular", "pulmonary" (lowercase, matches inferSystemFromCase in grade API)
  sourceType String
  sourceId   String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, system])
}

model Condition {
  id                                                          String                       @id
  name                                                        String
  system                                                      String
  createdAt                                                   DateTime                     @default(now())
  updatedAt                                                   DateTime
  aliases                                                     String[]                     @default([])
  content                                                     Json?
  displayName                                                 String?
  parentId                                                    String?
  relatedSystems                                              String[]                     @default([])
  status                                                      String                       @default("published")
  subcategory                                                 String?
  icd10Code                                                   String?
  conditionType                                               String?                      @default("diagnosis")
  media_url                                                   String?
  parent_category                                             String?
  AnatomyConditionLink                                        AnatomyConditionLink[]
  AntibioticConditionLink                                     AntibioticConditionLink[]
  ClinicalPearl                                               ClinicalPearl[]
  Condition                                                   Condition?                   @relation("ConditionToCondition", fields: [parentId], references: [id], onDelete: Cascade)
  other_Condition                                             Condition[]                  @relation("ConditionToCondition")
  ConditionRelation_ConditionRelation_conditionId1ToCondition ConditionRelation[]          @relation("ConditionRelation_conditionId1ToCondition")
  ConditionRelation_ConditionRelation_conditionId2ToCondition ConditionRelation[]          @relation("ConditionRelation_conditionId2ToCondition")
  ConfusionPair_ConfusionPair_mistakenForIdToCondition        ConfusionPair[]              @relation("ConfusionPair_mistakenForIdToCondition")
  ConfusionPair_ConfusionPair_realConditionIdToCondition      ConfusionPair[]              @relation("ConfusionPair_realConditionIdToCondition")
  DifferentialConditionLink                                   DifferentialConditionLink[]
  DifferentialDiagnosis                                       DifferentialDiagnosis[]
  DrugConditionLink                                           DrugConditionLink[]
  ECGConditionLink                                            ECGConditionLink[]
  FindingConditionLink                                        FindingConditionLink[]
  Guideline                                                   Guideline[]
  ImagingConditionLink                                        ImagingConditionLink[]
  LabConditionLink                                            LabConditionLink[]
  MediaAsset                                                  MediaAsset[]
  PearlConditionLink                                          PearlConditionLink[]
  PhysiologyConditionLink                                     PhysiologyConditionLink[]
  PreGeneratedQuestion                                        PreGeneratedQuestion[]
  ProcedureConditionLink                                      ProcedureConditionLink[]
  Question                                                    Question[]
  QuestionAttempt                                             QuestionAttempt[]
  QuestionSeed                                                QuestionSeed[]
  ReviewLog                                                   ReviewLog[]
  SavedQuestion                                               SavedQuestion[]
  ScoringSystem                                               ScoringSystem[]
  ScoringSystemConditionLink                                  ScoringSystemConditionLink[]
  TreatmentConditionLink                                      TreatmentConditionLink[]
  VitalSignConditionLink                                      VitalSignConditionLink[]
  WeaknessPattern                                             WeaknessPattern[]
  AnatomyStructure                                            AnatomyStructure[]           @relation("AnatomyStructureToCondition")
  SpecialTest                                                 SpecialTest[]                @relation("ConditionToSpecialTest")
  DiagnosticPuzzle                                            DiagnosticPuzzle[]
  ExamBlueprintCondition                                      ExamBlueprintCondition[]

  @@index([displayName])
  @@index([name])
  @@index([parentId])
  @@index([parent_category])
  @@index([status])
  @@index([subcategory])
  @@index([system])
  @@index([system, parent_category])
  @@index([system, subcategory, parent_category])
  @@index([icd10Code])
  @@index([conditionType])
}

model ConditionRelation {
  id                                                  String    @id
  conditionId1                                        String
  conditionId2                                        String
  relationType                                        String
  bidirectional                                       Boolean   @default(true)
  clinicalContext                                     String?
  createdAt                                           DateTime  @default(now())
  Condition_ConditionRelation_conditionId1ToCondition Condition @relation("ConditionRelation_conditionId1ToCondition", fields: [conditionId1], references: [id], onDelete: Cascade)
  Condition_ConditionRelation_conditionId2ToCondition Condition @relation("ConditionRelation_conditionId2ToCondition", fields: [conditionId2], references: [id], onDelete: Cascade)

  @@unique([conditionId1, conditionId2, relationType])
  @@index([conditionId1])
  @@index([conditionId2])
  @@index([relationType])
}

model ConfusionPair {
  id                                                               String          @id @default(cuid())
  userId                                                           String
  realCondition                                                    String
  mistakenFor                                                      String
  count                                                            Int             @default(1)
  lastOccurrence                                                   DateTime        @default(now())
  createdAt                                                        DateTime        @default(now())
  mistakenForId                                                    String?
  realConditionId                                                  String?
  correctConditionId                                               String?
  selectedConditionId                                              String?
  MedicalContent_ConfusionPair_correctConditionIdToMedicalContent  MedicalContent? @relation("ConfusionPair_correctConditionIdToMedicalContent", fields: [correctConditionId], references: [id])
  Condition_ConfusionPair_mistakenForIdToCondition                 Condition?      @relation("ConfusionPair_mistakenForIdToCondition", fields: [mistakenForId], references: [id])
  Condition_ConfusionPair_realConditionIdToCondition               Condition?      @relation("ConfusionPair_realConditionIdToCondition", fields: [realConditionId], references: [id])
  MedicalContent_ConfusionPair_selectedConditionIdToMedicalContent MedicalContent? @relation("ConfusionPair_selectedConditionIdToMedicalContent", fields: [selectedConditionId], references: [id])
  User                                                             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, correctConditionId, selectedConditionId])
  @@unique([userId, realCondition, mistakenFor])
  @@index([correctConditionId])
  @@index([mistakenForId])
  @@index([realConditionId])
  @@index([realCondition])
  @@index([selectedConditionId])
  @@index([userId, correctConditionId])
  @@index([userId])
  @@index([userId, realCondition])
  @@index([userId, count(sort: Desc), lastOccurrence(sort: Desc)])
}

model ContentAuditLog {
  id                String         @id
  contentId         String
  conditionId       String
  version           Int
  changeType        String
  changeDescription String?
  changedFields     String[]
  oldValues         Json?
  newValues         Json?
  changedBy         String
  changedByRole     String
  changedAt         DateTime       @default(now())
  ipAddress         String?
  userAgent         String?
  MedicalContent    MedicalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([changeType])
  @@index([changedAt])
  @@index([changedBy])
  @@index([conditionId])
  @@index([contentId])
}

model ContentBranch {
  id            String         @id
  name          String         @unique
  description   String?
  baseBranch    String?
  status        String         @default("active")
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  mergedAt      DateTime?
  mergedBy      String?
  mergeCommitId String?
  contentCount  Int            @default(0)
  changeCount   Int            @default(0)
  BranchChange  BranchChange[]

  @@index([createdAt])
  @@index([createdBy])
  @@index([status])
}

model ContentHealthReport {
  id                  String   @id
  timestamp           DateTime @default(now())
  totalContent        Int
  missingExplanations Int      @default(0)
  brokenMediaLinks    Int      @default(0)
  invalidFields       Int      @default(0)
  outdatedContent     Int      @default(0)
  reportData          Json

  @@index([timestamp])
}

model ContentIndex {
  id           String   @id
  entityId     String
  entityType   String
  title        String
  body         String
  panceYield   Int?
  system       String?
  searchVector String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([entityType, entityId])
  @@index([entityType, panceYield])
  @@index([system])
  @@index([title])
}

model ContentLock {
  id        String   @id
  contentId String   @unique
  lockedBy  String
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([contentId])
  @@index([expiresAt])
  @@index([lockedBy])
}

model ContentStatistics {
  id                String         @id
  conditionId       String
  date              DateTime       @db.Date
  views             Int            @default(0)
  questionsAnswered Int            @default(0)
  questionsCorrect  Int            @default(0)
  uniqueUsers       Int            @default(0)
  averageAccuracy   Decimal?       @db.Decimal(5, 4)
  averageTimeSpent  Int?
  bookmarkCount     Int            @default(0)
  flagCount         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  MedicalContent    MedicalContent @relation(fields: [conditionId], references: [conditionId], onDelete: Cascade)

  @@unique([conditionId, date])
  @@index([conditionId])
  @@index([date])
  @@index([questionsAnswered])
  @@index([uniqueUsers])
  @@index([views])
}

model ContentVersion {
  id                String         @id
  contentId         String
  version           Int
  content           Json
  changeType        String
  changeDescription String?
  changedBy         String
  changedAt         DateTime       @default(now())
  MedicalContent    MedicalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([changedAt])
  @@index([changedBy])
  @@index([contentId])
}

model ContrastiveDrillAttempt {
  id               String         @id
  userId           String
  setId            String
  questionsAsked   Int            @default(0)
  correctAnswers   Int            @default(0)
  conditionsMissed String[]
  timeSpentMs      Int?
  completedAt      DateTime       @default(now())
  ContrastiveSet   ContrastiveSet @relation(fields: [setId], references: [id])
  User             User           @relation(fields: [userId], references: [id])

  @@index([userId, setId])
}

model ContrastiveSet {
  id                      String                    @id
  symptom                 String
  conditionIds            String[]
  distinguishers          Json
  system                  String?
  difficulty              String                    @default("medium")
  highYield               Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  ContrastiveDrillAttempt ContrastiveDrillAttempt[]

  @@index([symptom])
  @@index([system])
}

model CuratedPassage {
  id           String   @id
  title        String
  body         String
  source       String
  sourceUrl    String
  license      String
  systemCodes  String[] @default([])
  conditionIds String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([conditionIds])
  @@index([source])
  @@index([systemCodes])
}

model DailyStreak {
  id                String   @id
  userId            String
  date              DateTime @db.Date
  questionsAnswered Int      @default(0)
  accuracyPercent   Float
  studyMinutes      Int      @default(0)
  createdAt         DateTime @default(now())
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

model DailyUserAnalytics {
  id                String   @id
  userId            String
  sessionDate       DateTime @db.Date
  questionsAnswered Int      @default(0)
  correctAnswers    Int      @default(0)
  accuracy          Float    @default(0)
  avgResponseTimeMs Int?
  systemsStudied    String[] @default([])
  updatedAt         DateTime
  accuracyBySystem  Json?
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionDate])
  @@index([sessionDate])
  @@index([userId])
}

model DailyWordle {
  id        String   @id
  date      DateTime @unique @db.Date
  wordId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Buzzword  Buzzword @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

model TargetedDailyAttempt {
  id          String    @id
  userId      String
  date        DateTime  @db.Date
  systems     String[]  @default([])
  questionId  String
  answerIndex Int?
  isCorrect   Boolean?
  timeSpentMs Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, date], name: "userId_date")
  @@index([userId])
  @@index([date])
}

model DifferentialConditionLink {
  id                     String                @id
  differentialId         String
  conditionId            String
  rankOrder              Int                   @default(0)
  likelihood             String?
  distinguishingFeatures String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @default(now())
  medicalContentId       String?
  Condition              Condition             @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  DifferentialDiagnosis  DifferentialDiagnosis @relation(fields: [differentialId], references: [id], onDelete: Cascade)
  MedicalContent         MedicalContent?       @relation(fields: [medicalContentId], references: [id], onDelete: Cascade)

  @@unique([differentialId, conditionId])
  @@index([conditionId])
  @@index([differentialId])
  @@index([likelihood])
  @@index([medicalContentId])
}

model DifferentialDiagnosis {
  id                        String                      @id
  presentingComplaint       String                      @unique
  category                  String
  isEmergency               Boolean                     @default(false)
  differentialList          String[]
  mustNotMiss               String[]
