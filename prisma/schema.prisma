model DrugConditionLink {
  id               String          @id
  drugId           String
  conditionId      String
  medicalContentId String?
  relationshipType String
  evidenceLevel    String?
  notes            String?
  isFirstLine      Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  Condition        Condition       @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  Drug             Drug            @relation(fields: [drugId], references: [id], onDelete: Cascade)
  MedicalContent   MedicalContent? @relation(fields: [medicalContentId], references: [id], onDelete: SetNull)

  @@unique([drugId, conditionId, relationshipType])
  @@index([conditionId])
  @@index([medicalContentId])
  @@index([relationshipType])
}

model ECGConditionLink {
  id                 String          @id
  ecgPatternId       String
  conditionId        String
  medicalContentId   String?
  relationshipType   String
  findingDescription String?
  exampleImageUrls   String[]        @default([])
  annotatedImageUrls String[]        @default([])
  isFirstLine        Boolean?        @default(false)
  panceYield         Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now())
  Condition          Condition       @relation(fields: [conditionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ECGPattern         ECGPattern      @relation(fields: [ecgPatternId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  MedicalContent     MedicalContent? @relation(fields: [medicalContentId], references: [id], onDelete: SetNull)

  @@unique([ecgPatternId, conditionId, relationshipType])
  @@index([conditionId])
  @@index([ecgPatternId])
  @@index([medicalContentId])
  @@index([relationshipType])
}

model ECGPattern {
