// This is the Prisma schema file for the PANaCEa medical learning platform.
// It defines the database models for managing conditions and their associated media assets.
//
// Learn more about Prisma at: https://www.prisma.io/docs
//
// To apply migrations:
// 1. Run: npx prisma migrate dev --name init_media_assets
// 2. Run: npx prisma generate
//
// Note: Prisma is not yet installed in this project. To add Prisma support:
// 1. npm install prisma --save-dev
// 2. npm install @prisma/client
// 3. npx prisma init (if starting fresh, skip if using this file)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Represents a user in the learning platform, linked to Clerk authentication
model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique // Clerk user ID from authentication provider
  email     String   @unique
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  /// Authentication fields
  emailVerified      DateTime? // Email verification timestamp
  role               String    @default("user") // user, viewer, editor, approver, admin, superadmin
  resetToken         String?   // Password reset token (hashed)
  resetTokenExpiry   DateTime? // Reset token expiration
  verifyToken        String?   // Email verification token (hashed)
  verifyTokenExpiry  DateTime? // Verification token expiration
  
  /// Onboarding fields
  hasCompletedBaseline Boolean @default(false) // Has completed baseline assessment
  examDate            DateTime? // Target PANCE/PANRE exam date
  
  /// User's performance records
  performanceRecords PerformanceRecord[]
  /// User's SRS (Spaced Repetition System) items
  srsItems           SRSItem[]
  /// User's saved questions (flagged/missed)
  savedQuestions     SavedQuestion[]
  /// User's achievements
  achievements       UserAchievement[]
  /// User's daily streaks
  streaks            DailyStreak[]
  
  @@index([clerkId])
  @@index([email])
  @@index([role])
}

/// Represents a single performance record from a quiz session
model PerformanceRecord {
  id                String   @id @default(uuid())
  userId            String
  topic             String
  system            String?  // System code (CV, PULM, GI, etc.)
  focus             String   // "all" | "topic" | "growth" | "review" | "reviewFlagged"
  difficulty        String   // "same" | "adaptive"
  isCorrect         Boolean
  timestamp         BigInt   // Unix timestamp in milliseconds
  questionWordCount Int?
  errorTag          String?  // "knowledge_gap" | "misread_question" | "guessing" | etc.
  subcategoryName   String?
  conditionName     String?
  createdAt         DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([userId, timestamp])
  @@index([topic])
  @@index([system])
}

/// Represents a Spaced Repetition System item for a user
model SRSItem {
  id             String   @id @default(uuid())
  userId         String
  questionId     String   // Unique identifier for the question content
  interval       Int      // Days until next review
  repetition     Int      // Number of successful reviews
  easiness       Float    // Easiness Factor (EF), minimum 1.3
  dueDate        DateTime
  lastReviewed   DateTime
  quality        Int      // Last quality response (0-5)
  difficulty     Float    // Normalized 0-1 difficulty
  stabilityScore Float    // Research variable for forgetting curve
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, questionId])
  @@index([userId])
  @@index([userId, dueDate])
  @@index([questionId])
}

/// Represents a saved question (flagged or missed) for review
model SavedQuestion {
  id               String   @id @default(uuid())
  userId           String
  questionId       String   // Unique identifier for the question content
  questionText     String   @db.Text
  correctAnswer    String
  explanation      String   @db.Text
  topic            String
  system           String?
  type             String   // "missed" | "flagged"
  userNote         String?  @db.Text
  repetitionLevel  Int      @default(1)
  nextReviewDate   String?  // ISO date string (YYYY-MM-DD)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, questionId, type])
  @@index([userId])
  @@index([userId, type])
  @@index([questionId])
}

/// Represents a medical condition in the learning platform.
/// Conditions are the primary educational content unit.
model Condition {
  id        String       @id @default(uuid())
  name      String
  system    String       // Organ system (e.g., "cardiovascular", "respiratory")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  
  /// Associated media assets for this condition
  media     MediaAsset[]
  
  @@index([system])
  @@index([name])
}

/// Represents a media asset (EKG, imaging, lab table, diagram, etc.)
/// linked to a medical condition. Enhanced for centralized media library.
model MediaAsset {
  id          String     @id @default(uuid())
  conditionId String?
  type        String     // "ekg" | "imaging" | "labs" | "diagram" | "photo" | "other"
  filename    String
  
  /// Object storage URLs
  originalUrl   String?    // Full-resolution URL (S3/R2)
  thumbnailUrl  String?    // Lower-res thumbnail for UI
  
  /// Metadata and tagging
  tags        String[]   // Keywords: "X-Ray", "Chest", "Pneumonia", etc.
  description String?    @db.Text
  altText     String?    @db.Text // Accessibility
  mimeType    String?    // image/jpeg, image/png, etc.
  fileSize    Int?       // Bytes
  dimensions  Json?      // { width: 1920, height: 1080 }
  
  /// AI matching and quality
  confidence  Float      @default(0) // AI matching confidence score (0-1)
  aiMetadata  Json?      // Additional AI analysis data
  
  /// Upload tracking
  uploadedBy  String?    // User ID
  uploadedAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  /// The condition this media asset is associated with
  condition   Condition? @relation(fields: [conditionId], references: [id])
  
  @@index([conditionId])
  @@index([type])
  @@index([filename])
  @@index([tags])
  @@index([uploadedBy])
}

/// Represents an achievement earned by a user
model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String   // Achievement identifier from definitions
  unlockedAt    DateTime @default(now())
  progress      Int      @default(100) // 0-100, for progressive achievements
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

/// Represents daily activity streaks for gamification
model DailyStreak {
  id             String   @id @default(uuid())
  userId         String
  date           DateTime @db.Date // Date of activity (YYYY-MM-DD)
  questionsAnswered Int   @default(0) // Questions answered on this day
  accuracyPercent   Float // Accuracy for the day
  studyMinutes      Int   @default(0) // Minutes studied
  createdAt      DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// Represents confusion pairs tracked for DDx analysis
model ConfusionPair {
  id              String   @id @default(uuid())
  userId          String?  // Null for global stats, set for user-specific
  realCondition   String   // The correct condition
  mistakenFor     String   // What user incorrectly chose
  count           Int      @default(1) // How many times this happened
  lastOccurrence  DateTime @default(now())
  createdAt       DateTime @default(now())
  
  @@unique([userId, realCondition, mistakenFor])
  @@index([userId])
  @@index([userId, realCondition])
  @@index([realCondition])
}

/// Represents mastery tier progress for conditions/topics
model MasteryProgress {
  id            String   @id @default(uuid())
  userId        String
  conditionName String?  // Specific condition, or null for system-level
  systemCode    String?  // CV, PULM, GI, etc.
  subcategory   String?
  masteryTier   String   @default("bronze") // bronze, silver, gold, platinum
  accuracy      Float    // Current accuracy percentage
  attempts      Int      @default(0)
  lastAttempt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([userId, conditionName, systemCode, subcategory])
  @@index([userId])
  @@index([systemCode])
}

/// Represents baseline assessment results
model BaselineAssessment {
  id                String   @id @default(uuid())
  userId            String   @unique
  completedAt       DateTime @default(now())
  totalQuestions    Int
  correctAnswers    Int
  accuracy          Float
  systemBreakdown   Json     // System-level performance breakdown
  weakestSystems    String[] // Top 3 weakest systems
  strongestSystems  String[] // Top 3 strongest systems
  
  @@index([userId])
}

/// Represents user feedback on explanation helpfulness
model ExplanationReaction {
  id         String   @id @default(uuid())
  userId     String?  // Null for anonymous feedback
  questionId String   // Question identifier
  reaction   String   // "helpful" | "not_helpful"
  timestamp  DateTime @default(now())
  
  @@index([questionId])
  @@index([userId, questionId])
}

/// Represents user weakness patterns for adaptive learning
model WeaknessPattern {
  id          String   @id @default(uuid())
  userId      String
  conditionId String
  wasCorrect  Boolean
  timestamp   DateTime @default(now())
  consecutiveWrong Int @default(0) // Track consecutive wrong answers
  
  @@index([userId])
  @@index([userId, conditionId])
  @@index([conditionId])
}

/// Represents medical content for the CMS with full version control
model MedicalContent {
  id          String   @id @default(uuid())
  conditionId String   @unique // e.g., "CV__ecg__atrial_fibrillation"
  system      String   // System code (CV, PULM, GI, etc.)
  subcategory String
  condition   String
  
  /// Content sections stored as JSONB for flexibility
  content     Json     // Full content structure including overview, symptoms, treatment, etc.
  
  /// Workflow state machine
  status      String   @default("draft") // draft, pending_review, approved, published, archived
  version     Int      @default(1)
  
  /// Timestamps and attribution
  createdAt   DateTime @default(now())
  createdBy   String   // User ID
  updatedAt   DateTime @updatedAt
  updatedBy   String   // User ID
  publishedAt DateTime?
  publishedBy String?
  approvedAt  DateTime?
  approvedBy  String?
  
  /// Relations
  versions    ContentVersion[]
  auditLogs   ContentAuditLog[]
  
  @@index([conditionId])
  @@index([system])
  @@index([status])
  @@index([createdBy])
  @@index([updatedAt])
}

/// Represents a historical version of content
model ContentVersion {
  id                String         @id @default(uuid())
  contentId         String
  version           Int
  content           Json           // Snapshot of content at this version
  changeType        String         // create, update, delete, publish, unpublish, approve, reject
  changeDescription String?        @db.Text
  changedBy         String         // User ID
  changedAt         DateTime       @default(now())
  
  medicalContent    MedicalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  @@unique([contentId, version])
  @@index([contentId])
  @@index([changedBy])
  @@index([changedAt])
}

/// Audit log for all content changes (immutable)
model ContentAuditLog {
  id              String         @id @default(uuid())
  contentId       String
  conditionId     String
  version         Int
  changeType      String         // create, update, delete, publish, unpublish, approve, reject
  changeDescription String?      @db.Text
  changedFields   String[]       // Array of field names that changed
  oldValues       Json?          // Previous values (for updates)
  newValues       Json?          // New values (for updates)
  changedBy       String         // User ID
  changedByRole   String         // admin, superadmin
  changedAt       DateTime       @default(now())
  ipAddress       String?
  userAgent       String?        @db.Text
  
  medicalContent  MedicalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  @@index([contentId])
  @@index([conditionId])
  @@index([changedBy])
  @@index([changedAt])
  @@index([changeType])
}

/// Content health report from nightly audits
model ContentHealthReport {
  id                    String   @id @default(uuid())
  timestamp             DateTime @default(now())
  totalContent          Int
  missingExplanations   Int      @default(0)
  brokenMediaLinks      Int      @default(0)
  invalidFields         Int      @default(0)
  outdatedContent       Int      @default(0)
  reportData            Json     // Full report details
  
  @@index([timestamp])
}

/// Pre-generated AI questions for instant delivery
model PreGeneratedQuestion {
  id                String   @id @default(uuid())
  questionType      String   // "vignette", "mcq", "clinical"
  system            String?  // System code
  conditionId       String?  // Related condition
  difficulty        String   // "easy", "medium", "hard"
  questionData      Json     // Full question structure
  generatedAt       DateTime @default(now())
  usedAt            DateTime?
  usedBy            String?  // User ID who received this question
  quality           Int?     // AI quality score 1-10
  
  @@index([questionType])
  @@index([system])
  @@index([difficulty])
  @@index([usedAt])
  @@index([generatedAt])
}

/// Background job queue for async processing
model BackgroundJob {
  id              String   @id @default(uuid())
  jobType         String   // "generate_questions", "health_check", "media_processing"
  status          String   @default("pending") // pending, processing, completed, failed
  priority        Int      @default(5) // 1-10, higher = more important
  payload         Json     // Job-specific data
  result          Json?    // Job result data
  error           String?  @db.Text
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  scheduledFor    DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([jobType])
  @@index([status])
  @@index([scheduledFor])
  @@index([priority, status])
}

/// Real-time collaboration tracking
model ContentLock {
  id          String   @id @default(uuid())
  contentId   String   @unique
  lockedBy    String   // User ID
  lockedAt    DateTime @default(now())
  expiresAt   DateTime // Auto-release after timeout
  
  @@index([contentId])
  @@index([lockedBy])
  @@index([expiresAt])
}

/// Offline sync queue for resilience
model SyncQueue {
  id          String   @id @default(uuid())
  userId      String
  operation   String   // "save_progress", "submit_quiz", "update_settings"
  data        Json     // Operation data
  status      String   @default("pending") // pending, synced, failed
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  syncedAt    DateTime?
  error       String?  @db.Text
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Represents a flagged question reported by a user
model QuestionFlag {
  id              String   @id @default(uuid())
  userId          String   // User who flagged the question
  userEmail       String?  // Email for notification
  userFirstName   String?  // User's first name for personalized emails
  questionId      String   // Unique identifier for the question
  questionText    String   @db.Text
  correctAnswer   String?
  topic           String?
  system          String?
  flagType        String   // "typo", "incorrect_answer", "unclear", "outdated", "other"
  description     String   @db.Text // User's description of the issue
  status          String   @default("pending") // pending, under_review, fixed, wont_fix, duplicate
  priority        String   @default("medium") // low, medium, high, critical
  
  /// Admin tracking
  assignedTo      String?  // Admin user ID
  reviewedBy      String?  // Admin who reviewed/fixed
  reviewedAt      DateTime?
  resolutionNote  String?  @db.Text // Admin's note about the fix
  
  /// Notification tracking
  notificationSent Boolean  @default(false)
  notifiedAt      DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([questionId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([status, priority]) // For admin queue sorting
}

/// Semantic cache for AI-generated questions
model SemanticCache {
  id                String   @id @default(uuid())
  queryText         String   @db.Text // Original query/prompt
  queryEmbedding    String?  @db.Text // Vector embedding as JSON
  questionType      String   // "vignette", "mcq", "clinical"
  system            String?
  difficulty        String?
  cachedQuestion    Json     // The generated question data
  generatedAt       DateTime @default(now())
  lastUsedAt        DateTime @default(now())
  useCount          Int      @default(1)
  qualityScore      Float    @default(0) // User feedback quality
  
  @@index([queryText(ops: raw("gin_trgm_ops"))]) // PostgreSQL trigram for similarity
  @@index([questionType])
  @@index([system])
  @@index([lastUsedAt])
}

/// Question version history for time travel
model QuestionHistory {
  id              String   @id @default(uuid())
  questionId      String   // The question identifier
  version         Int      // Version number
  questionData    Json     // Complete question snapshot
  changedBy       String?  // User/system that made the change
  changeReason    String?  @db.Text
  validFrom       DateTime @default(now())
  validTo         DateTime? // Null for current version
  
  @@unique([questionId, version])
  @@index([questionId])
  @@index([validFrom])
  @@index([questionId, validFrom]) // For time-travel queries
}

/// Content branches for Git-like version control
model ContentBranch {
  id              String   @id @default(uuid())
  name            String   // "main", "2026-guideline-update", etc.
  description     String?  @db.Text
  baseBranch      String?  // Parent branch name
  status          String   @default("active") // active, merged, archived
  
  /// Branch metadata
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mergedAt        DateTime?
  mergedBy        String?
  mergeCommitId   String?
  
  /// Statistics
  contentCount    Int      @default(0)
  changeCount     Int      @default(0)
  
  /// Relations
  changes         BranchChange[]
  
  @@unique([name])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
}

/// Individual changes within a content branch
model BranchChange {
  id              String   @id @default(uuid())
  branchId        String
  contentId       String   // Reference to MedicalContent
  conditionId     String
  changeType      String   // create, update, delete
  contentData     Json     // The changed content
  previousData    Json?    // For updates/deletes
  
  createdBy       String
  createdAt       DateTime @default(now())
  
  branch          ContentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  @@index([branchId])
  @@index([contentId])
  @@index([conditionId])
  @@index([createdAt])
}

/// Staging area for AI-generated questions before they go live
/// Task 108: The "Staging Lake" Architecture
model StagingQuestion {
  id                String   @id @default(uuid())
  questionType      String   // "vignette", "mcq", "clinical"
  system            String?  // System code (CV, PULM, GI, etc.)
  conditionId       String?  // Related condition
  difficulty        String   // "easy", "medium", "hard"
  questionData      Json     // Full question structure
  
  /// Adequacy check results
  adequacyStatus    String   @default("pending") // pending, pass, fail, flagged
  adequacyScore     Float?   // 0-1 quality score from cheaper AI model
  adequacyDetails   Json?    // Detailed check results
  hasCorrectAnswer  Boolean  @default(false)
  explanationLength Int      @default(0) // Word count
  hasMedicalErrors  Boolean  @default(false)
  
  /// Workflow tracking
  generatedAt       DateTime @default(now())
  checkedAt         DateTime?
  promotedAt        DateTime? // When moved to live questions
  status            String   @default("staging") // staging, live, discarded, flagged_for_review
  
  @@index([adequacyStatus])
  @@index([status])
  @@index([questionType])
  @@index([system])
  @@index([generatedAt])
}

/// Track every question a user has seen for no-repeat logic
/// Task 109: "Infinite" No-Repeat Logic
model UserQuestionHistory {
  id              String   @id @default(uuid())
  userId          String
  questionId      String   // Unique identifier for the question
  questionType    String   // "vignette", "mcq", "clinical"
  system          String?  // System code
  conditionId     String?  // Related condition
  seenAt          DateTime @default(now())
  wasCorrect      Boolean? // Track if user got it right
  
  @@unique([userId, questionId])
  @@index([userId])
  @@index([userId, system]) // For filtering by system
  @@index([userId, conditionId]) // For filtering by condition
  @@index([questionId])
  @@index([seenAt])
}

/// Store question "seeds" for runtime permutation generation
/// Task 111: "Vignette Permutation" Storage
model QuestionSeed {
  id              String   @id @default(uuid())
  conditionId     String   // Core medical condition/pathology
  questionType    String   // "vignette", "mcq", "clinical"
  system          String?  // System code
  
  /// Seed data for permutations
  corePathology   String   // Core concept (e.g., "Appendicitis", "MI")
  variables       Json     // Variables for permutation: { "Age": [10, 25, 60], "Presentation": [...] }
  template        String   @db.Text // Template with placeholders
  
  /// Question structure
  correctAnswer   String
  explanation     String   @db.Text
  distractors     Json     // Array of distractor options
  difficulty      String   // "easy", "medium", "hard"
  
  /// Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  usageCount      Int      @default(0) // How many times this seed has been used
  lastUsedAt      DateTime?
  
  @@index([conditionId])
  @@index([questionType])
  @@index([system])
  @@index([usageCount])
}

/// Clinical pearls extracted from question explanations
/// Task 112: The "Pearl" Harvester
model ClinicalPearl {
  id              String   @id @default(uuid())
  questionId      String   // Source question
  conditionId     String?  // Related condition
  system          String?  // System code
  
  /// Pearl content
  pearlText       String   @db.Text // The 1-sentence clinical takeaway
  fullExplanation String   @db.Text // Full explanation context
  
  /// Categorization
  category        String?  // "diagnosis", "treatment", "pathophysiology", etc.
  tags            String[] // Keywords for filtering
  difficulty      String?  // "easy", "medium", "hard"
  
  /// User engagement
  viewCount       Int      @default(0)
  usefulVotes     Int      @default(0)
  
  /// Metadata
  extractedAt     DateTime @default(now())
  extractedBy     String   @default("ai") // "ai" or user ID
  
  @@index([questionId])
  @@index([conditionId])
  @@index([system])
  @@index([category])
  @@index([tags])
  @@index([extractedAt])
}

/// Track which pearls users have viewed (for "Review My Pearls")
model UserPearl {
  id              String   @id @default(uuid())
  userId          String
  pearlId         String
  viewedAt        DateTime @default(now())
  markedUseful    Boolean  @default(false)
  notes           String?  @db.Text // User's personal notes on the pearl
  
  @@unique([userId, pearlId])
  @@index([userId])
  @@index([pearlId])
  @@index([viewedAt])
  @@index([userId, markedUseful]) // For filtering favorite pearls
}

/// Phase 31: Living Medical Brain - Guideline tracking and versioning
/// Task 113: Guideline Watchdog Bot
model GuidelineVersion {
  id              String   @id @default(uuid())
  source          String   // "AHA", "ADA", "CDC", "USPSTF", "NCCN", etc.
  guidelineName   String   // "Breast Cancer Screening", "Hypertension Management", etc.
  version         String   // Version identifier (e.g., "2024", "v1.2")
  effectiveDate   DateTime // When this version became effective
  content         Json     // Full guideline content/summary
  keyChanges      String[] // Major changes from previous version
  
  /// Detection metadata
  detectedAt      DateTime @default(now())
  detectionMethod String   // "manual", "scraper", "api"
  confidence      Float    @default(1.0) // 0-1 confidence in change detection
  
  /// Review tracking
  reviewStatus    String   @default("pending") // pending, reviewed, applied
  reviewedBy      String?  // Admin user ID
  reviewedAt      DateTime?
  reviewNotes     String?  @db.Text
  
  /// Relations
  conflicts       GuidelineConflict[]
  
  @@unique([source, guidelineName, version])
  @@index([source])
  @@index([guidelineName])
  @@index([effectiveDate])
  @@index([reviewStatus])
  @@index([detectedAt])
}

/// Questions flagged due to guideline changes
/// Task 113: Guideline Watchdog Bot
model GuidelineConflict {
  id                String   @id @default(uuid())
  guidelineVersionId String
  questionId        String   // Question that may be outdated
  conditionId       String?
  system            String?
  
  /// Conflict details
  conflictType      String   // "outdated_recommendation", "changed_criteria", "deprecated_drug", etc.
  description       String   @db.Text
  severity          String   // "critical", "high", "medium", "low"
  
  /// Review queue
  status            String   @default("flagged") // flagged, under_review, resolved, dismissed
  assignedTo        String?  // Admin user ID
  reviewedBy        String?
  reviewedAt        DateTime?
  resolution        String?  @db.Text // How was this resolved
  
  /// Timestamps
  detectedAt        DateTime @default(now())
  resolvedAt        DateTime?
  
  guidelineVersion  GuidelineVersion @relation(fields: [guidelineVersionId], references: [id], onDelete: Cascade)
  
  @@index([guidelineVersionId])
  @@index([questionId])
  @@index([status])
  @@index([severity])
  @@index([detectedAt])
  @@index([status, severity]) // For review queue sorting
}

/// NCCPA Blueprint configuration and tracking
/// Task 114: Blueprint Drift Detection
model NCCPABlueprint {
  id              String   @id @default(uuid())
  version         String   // Blueprint version (e.g., "2024", "2025")
  effectiveDate   DateTime // When this blueprint became active
  isActive        Boolean  @default(false) // Only one should be active
  
  /// System distribution requirements
  systemWeights   Json     // { "CV": 0.13, "PULM": 0.12, etc. }
  
  /// Metadata
  createdAt       DateTime @default(now())
  createdBy       String?  // Admin user ID
  notes           String?  @db.Text
  
  @@unique([version])
  @@index([version])
  @@index([isActive])
  @@index([effectiveDate])
}

/// Content distribution audit results
/// Task 114: Blueprint Drift Detection
model ContentDriftReport {
  id                String   @id @default(uuid())
  blueprintId       String   // Reference to NCCPABlueprint
  reportDate        DateTime @default(now())
  
  /// Audit results
  totalQuestions    Int
  systemBreakdown   Json     // { "CV": { count: 500, target: 650, drift: -150 }, ... }
  driftSummary      Json     // Summary statistics
  
  /// Alert thresholds
  hasSignificantDrift Boolean @default(false) // Drift > 10%
  alertsSent        Boolean  @default(false)
  alertDetails      Json?    // Which systems need attention
  
  @@index([blueprintId])
  @@index([reportDate])
  @@index([hasSignificantDrift])
}

/// Question verification and re-validation
/// Task 115: Fact-Check Re-Verification Agent
model QuestionVerification {
  id                String   @id @default(uuid())
  questionId        String   // Question being verified
  conditionId       String?
  system            String?
  
  /// Verification details
  verificationType  String   // "scheduled_6month", "guideline_change", "user_flagged"
  verificationDate  DateTime @default(now())
  
  /// AI verification result
  aiModel           String   // "gpt-5", "med-palm", etc.
  isAccurate        Boolean? // AI's assessment
  confidence        Float?   // 0-1 confidence score
  aiResponse        Json?    // Full AI response
  
  /// Issues found
  issues            String[] // List of specific concerns
  recommendedAction String   // "approve", "update", "quarantine", "delete"
  
  /// Review tracking
  status            String   @default("pending") // pending, reviewed, quarantined, approved
  reviewedBy        String?  // Admin user ID
  reviewedAt        DateTime?
  reviewNotes       String?  @db.Text
  
  /// Quarantine details
  quarantinedAt     DateTime?
  quarantineReason  String?  @db.Text
  
  @@index([questionId])
  @@index([verificationType])
  @@index([verificationDate])
  @@index([status])
  @@index([isAccurate])
  @@index([questionId, verificationDate]) // For tracking verification history
}

/// User-reported staleness flags
/// Task 116: User-Driven Staleness Reporting
model StalenessReport {
  id              String   @id @default(uuid())
  userId          String   // User who reported
  userEmail       String?
  questionId      String   // Question reported as outdated
  conditionId     String?
  system          String?
  
  /// Report details
  reportType      String   // "outdated_guideline", "changed_practice", "incorrect_drug", etc.
  description     String   @db.Text
  evidenceUrl     String?  // Optional link to evidence
  
  /// Crowdsourced validation
  confirmations   Int      @default(1) // How many users reported same issue
  confidence      Float    @default(0.0) // Calculated confidence based on confirmations
  
  /// Status tracking
  status          String   @default("pending") // pending, auto_hidden, under_review, resolved, invalid
  autoHidden      Boolean  @default(false) // Auto-hidden after 3 confirmations
  autoHiddenAt    DateTime?
  
  /// Admin review
  reviewedBy      String?  // Admin user ID
  reviewedAt      DateTime?
  resolution      String?  @db.Text
  isValid         Boolean? // Was the report valid?
  
  /// Bounty hunter rewards
  rewardGranted   Boolean  @default(false)
  rewardPoints    Int      @default(0)
  rewardGrantedAt DateTime?
  
  /// Timestamps
  reportedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([questionId])
  @@index([status])
  @@index([reportType])
  @@index([confirmations])
  @@index([reportedAt])
  @@index([questionId, reportedAt]) // For tracking reports on same question
}

/// Bounty hunter rewards for valid staleness reports
/// Task 116: User-Driven Staleness Reporting
model BountyReward {
  id              String   @id @default(uuid())
  userId          String
  reportId        String   // Reference to StalenessReport
  
  /// Reward details
  rewardType      String   // "staleness_report", "error_detection", "guideline_update"
  points          Int      // Reward points earned
  description     String   // What they earned it for
  
  /// Metadata
  awardedAt       DateTime @default(now())
  awardedBy       String?  // Admin user ID or "system"
  
  @@index([userId])
  @@index([reportId])
  @@index([awardedAt])
  @@index([userId, awardedAt]) // For user reward history
}

/// Question migration history for guideline updates
/// Task 117: Version 2.0 Auto-Migration
model QuestionMigration {
  id                  String   @id @default(uuid())
  originalQuestionId  String   // Original question
  newQuestionId       String   // Migrated/updated version
  
  /// Migration details
  migrationType       String   // "guideline_update", "drug_change", "criteria_change"
  guidelineChange     String?  // Reference to guideline that changed
  reasonForMigration  String   @db.Text
  
  /// AI migration details
  aiModel             String?  // Model used for migration
  migrationPrompt     String?  @db.Text
  changesApplied      Json     // What specifically was changed
  
  /// Content comparison
  oldContent          Json     // Snapshot of old question
  newContent          Json     // New question content
  
  /// Review and approval
  status              String   @default("pending") // pending, approved, rejected, applied
  reviewedBy          String?  // Admin user ID
  reviewedAt          DateTime?
  approvalNotes       String?  @db.Text
  
  /// Timestamps
  migratedAt          DateTime @default(now())
  appliedAt           DateTime? // When new version went live
  
  @@index([originalQuestionId])
  @@index([newQuestionId])
  @@index([migrationType])
  @@index([status])
  @@index([migratedAt])
}
