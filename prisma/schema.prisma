model EducationalResource {
  id               String    @id
  title            String
  resourceType     String
  fileUrl          String?
  originalFilename String?
  extractedText    String?
  summary          String?
  keyTopics        String[]
  author           String?
  source           String?
  pageNumber       Int?
  duration         Int?
  mimeType         String?
  fileSize         Int?
  conditionIds     String[]
  systemCodes      String[]
  approvalStatus   String    @default("pending")
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  qualityScore     Float?
  uploadedBy       String?
  uploadedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  viewCount        Int       @default(0)
  lastAccessedAt   DateTime?

  @@index([approvalStatus])
  @@index([approvedAt])
  @@index([keyTopics])
  @@index([resourceType])
  @@index([systemCodes])
  @@index([uploadedBy])
}

model EncounterResult {
  id         String   @id
  userId     String
  caseId     String
  score      Json
  feedback   String
  phasesData Json
  createdAt  DateTime @default(now())

  @@index([caseId])
  @@index([userId])
}

model ExplanationReaction {
  id         String   @id
  userId     String?
  questionId String
  reaction   String
  timestamp  DateTime @default(now())

  @@index([questionId])
  @@index([userId, questionId])
}

model ContrastiveSet {
  id           String   @id @default(cuid())
  symptom      String // "Chest Pain", "Dyspnea", "Abdominal Pain"
  conditionIds String[] // Array of 5 MedicalContent IDs

  // Pre-computed distinguishing features
  distinguishers Json // { "MI": ["troponin", "ST elevation"], "PE": ["pleuritic", "Wells score"] }

  // Metadata
  system     String? // Primary system (CARDIO, PULM, etc.)
  difficulty String  @default("medium")
  highYield  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ContrastiveDrillAttempt ContrastiveDrillAttempt[]

  @@index([symptom])
  @@index([system])
}

model ContrastiveDrillAttempt {
  id     String @id @default(cuid())
  userId String
  setId  String // ContrastiveSet ID

  // Performance tracking
  questionsAsked   Int      @default(0)
  correctAnswers   Int      @default(0)
  conditionsMissed String[] // Which conditions were confused
  timeSpentMs      Int?

  completedAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id])
  set  ContrastiveSet @relation(fields: [setId], references: [id])

  @@index([userId, setId])
}

model FindingConditionLink {
  id                  String              @id
  findingId           String
  conditionId         String
  medicalContentId    String?
  relationshipType    String
