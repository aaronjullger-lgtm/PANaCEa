  weakestSystems          String[]  @default([])
  strongestSystems        String[]  @default([])
  windowStartAttemptId    String?
  windowEndAttemptId      String?
  windowStartTime         DateTime?
  windowEndTime           DateTime?
  currentSlotIndex        Int       @default(0)
  lastRecalculatedAt      DateTime  @default(now())
  recalculationVersion    Int       @default(1)
  createdAt               DateTime  @default(now())
  User                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([predictedScore])
  @@index([userId])
}

model UserSRSConfig {
  id               String   @id
  userId           String   @unique
  requestRetention Float    @default(0.9)
  wWeights         Json
  lastTuned        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastTuned])
  @@index([userId])
}

model UserStatistics {
  id                  String   @id
  userId              String   @unique
  totalQuestions      Int      @default(0)
  correctAnswers      Int      @default(0)
  avgTimePerQuestion  Float?
  systemStats         Json?
  rushedSystems       String[] @default([])
  overthinkingSystems String[] @default([])
  diagnosisBias       Json?
  strongestSystems    String[] @default([])
  weakestSystems      String[] @default([])
  peakStudyHours      Int[]    @default([])
  avgSessionLength    Float?
  updatedAt           DateTime
  createdAt           DateTime @default(now())
  User                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserStatisticsSnapshot {
  id                   String   @id
  userId               String
  snapshotDate         DateTime @db.Date
  totalQuestions       Int      @default(0)
  correctAnswers       Int      @default(0)
  accuracy             Decimal? @db.Decimal(5, 4)
  currentStreak        Int      @default(0)
  longestStreak        Int      @default(0)
  totalStudyTime       Int      @default(0)
  conditionsMastered   Int      @default(0)
  fsrsCardsTotal       Int      @default(0)
  fsrsCardsMature      Int      @default(0)
  fsrsAverageRetention Decimal? @db.Decimal(5, 4)
  weakestSystem        String?
  strongestSystem      String?
  createdAt            DateTime @default(now())
  User                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([accuracy])
  @@index([snapshotDate])
  @@index([userId])
}

model UserTopicProgress {
  id                 String    @id
  userId             String
  conditionId        String
  taskType           String
  stability          Float     @default(1.0)
  difficulty         Float     @default(5.0)
  lastReviewDate     DateTime?
  nextReviewDate     DateTime?
  state              Int       @default(0)
  reps               Int       @default(0)
  lapses             Int       @default(0)
  variantsUsed       String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  implicitDifficulty Float?
  User               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conditionId, taskType])
  @@index([userId, nextReviewDate])
  @@index([userId, state, nextReviewDate])
}

model UserWordleState {
  id        String       @id
  userId    String
  date      DateTime     @db.Date
  guesses   String[]     @default([])
  status    WordleStatus @default(playing)
  updatedAt DateTime
  User      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

model VisualizerGeneration {
  id                 String   @id
  userId             String
  conditionId        String?
  prompt             String
  contentClass       String   @default("art")
  storagePath        String
  storageUrl         String?
  referenceAnatomyId String?
  createdAt          DateTime @default(now())
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conditionId])
  @@index([createdAt])
  @@index([userId])
}

model VitalSignConditionLink {
  id                   String          @id
  vitalSignId          String
  conditionId          String
  expectedChange       String?
  typicalRange         String?
  clinicalSignificance String?
  isEmergency          Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now())
  medicalContentId     String?
  Condition            Condition       @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  MedicalContent       MedicalContent? @relation(fields: [medicalContentId], references: [id], onDelete: Cascade)
  VitalSignRange       VitalSignRange  @relation(fields: [vitalSignId], references: [id], onDelete: Cascade)

  @@unique([vitalSignId, conditionId])
  @@index([conditionId])
  @@index([isEmergency])
  @@index([medicalContentId])
  @@index([vitalSignId])
}

model VitalSignRange {
  id                     String                   @id
  vitalSign              String                   @unique
  displayName            String?
  category               String
  normalRange            String?
  ranges                 Json?
  units                  String?
  elevation              Json?
  depression             Json?
  emergencyValues        Json?
  associatedConditions   Json?
  clinicalPearls         String[]                 @default([])
  commonMistakes         String[]                 @default([])
  testQuestionTips       String[]                 @default([])
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  VitalSignConditionLink VitalSignConditionLink[]

  @@index([category])
}

model WeaknessPattern {
  id               String          @id
  userId           String
  conditionId      String
  wasCorrect       Boolean
  timestamp        DateTime        @default(now())
  consecutiveWrong Int             @default(0)
  medicalContentId String?
  Condition        Condition       @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  MedicalContent   MedicalContent? @relation(fields: [medicalContentId], references: [id])
  User             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conditionId])
  @@index([medicalContentId])
  @@index([userId, conditionId])
  @@index([userId])
}

