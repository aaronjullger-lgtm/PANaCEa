generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ACLSAlgorithm {
  id                  String   @id(map: "ACLSQuestion_pkey")
  algorithm           String
  correctIndex        Int
  category            String
  explanation         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  algorithmName       String?
  algorithmStep       Int?
  boardYieldFacts     String[] @default([])
  clinicalContext     String?
  clinicalPearls      String[] @default([])
  commonMistakes      String[] @default([])
  correctIntervention String?
  cprGuidance         String?
  criticalActions     String[] @default([])
  drugDose            String?
  drugTiming          String?
  ecgFindings         String[] @default([])
  energyDose          String?
  isHighYield         Boolean  @default(false)
  mnemonics           String[] @default([])
  panceYield          Int?
  patientAge          String?
  relatedAlgorithms   String[] @default([])
  rhythm              String?
  rhythmDescription   String?
  testQuestionTips    String[] @default([])
  videoUrl            String?

  @@index([algorithmName], map: "ACLSQuestion_algorithmName_idx")
  @@index([category], map: "ACLSQuestion_category_idx")
  @@index([panceYield], map: "ACLSQuestion_panceYield_idx")
  @@index([rhythm], map: "ACLSQuestion_rhythm_idx")
}

model AnatomyConditionLink {
  id               String           @id
  anatomyId        String
  conditionId      String
  medicalContentId String?
  relationshipType String
  clinicalContext  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  AnatomyStructure AnatomyStructure @relation(fields: [anatomyId], references: [id], onDelete: Cascade)
  Condition        Condition        @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  MedicalContent   MedicalContent?  @relation(fields: [medicalContentId], references: [id], onDelete: SetNull)

  @@unique([anatomyId, conditionId])
  @@index([conditionId])
  @@index([medicalContentId])
  @@index([relationshipType])
}

model AnatomyStructure {
  id                   String                 @id
  name                 String                 @unique
  system               String
  region               String?
  type                 String?
  description          String?
  function             String?
  innervation          String?
  bloodSupply          String?
  clinicalSignificance String?
  imageUrl             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  abbreviation         String?
  aliases              String[]               @default([])
  anastomoses          String[]               @default([])
  attachments          String[]               @default([])
  autonomicFunction    String?
  boardYieldFacts      String[]               @default([])
  borders              String?
  branches             String[]               @default([])
  clinicalPearls       String[]               @default([])
  commonMistakes       String[]               @default([])
  commonPathology      String[]               @default([])
  contents             String[]               @default([])
  dermatome            String?
  diagramUrl           String?
  examFindings         String[]               @default([])
  imagingFindings      String[]               @default([])
  injuryMechanism      String?
  insertion            String?
  isHighYield          Boolean                @default(false)
  latinName            String?
  layers               String[]               @default([])
  mnemonics            String[]               @default([])
  modelUrl             String?
  motorFunction        String?
  myotome              String?
  nervePath            String?
  nerveRoots           String?
  origin               String?
  palpationTips        String?
  panceYield           Int?
  relations            String?
  sensoryFunction      String?
  surfaceLandmarks     String[]               @default([])
  surgicalApproach     String?
  testQuestionTips     String[]               @default([])
  tributaries          String[]               @default([])
  vesselPath           String?
  videoUrl             String?
  AnatomyConditionLink AnatomyConditionLink[]
  Condition            Condition[]
  MediaAsset           MediaAsset[]

  @@index([name])
  @@index([panceYield])
  @@index([region])
  @@index([system])
}

model AntibioticGuideline {
  id                      String                    @id
  organism                String
  class                   String
  effective               Json
  resistant               Json
  notes                   String?
  description             String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  aliases                 String[]                  @default([])
  alternativeAntibiotics  String[]                  @default([])
  arrangement             String?
  boardYieldFacts         String[]                  @default([])
  carbapenemResistant     Boolean                   @default(false)
  classicPresentation     String?
  clinicalPearls          String[]                  @default([])
  commonInfections        String[]                  @default([])
  commonMistakes          String[]                  @default([])
  cultureCharacteristics  String?
  deEscalationGuidance    String?
  diagnosticClues         String[]                  @default([])
  doseRecommendations     Json?
  emergingResistance      String[]                  @default([])
  esblProducer            Boolean                   @default(false)
  firstLineAntibiotics    String[]                  @default([])
  gramStain               String?
  growthConditions        String?
  infectionControl        String[]                  @default([])
  isHighYield             Boolean                   @default(false)
  mnemonics               String[]                  @default([])
  morphology              String?
  mrResistance            Boolean                   @default(false)
  panceYield              Int?
  prophylaxis             String?
  reservoirs              String[]                  @default([])
  resistanceMechanisms    String[]                  @default([])
  testQuestionTips        String[]                  @default([])
  transmission            String[]                  @default([])
  treatmentDuration       String?
  vaccines                String[]                  @default([])
  vancomycinResistant     Boolean                   @default(false)
  virulenceFactors        String[]                  @default([])
  // New deep relations
  AntibioticConditionLink AntibioticConditionLink[]

  @@index([class])
  @@index([gramStain])
  @@index([organism])
  @@index([panceYield])
}

model BackgroundJob {
  id           String    @id
  jobType      String
  status       String    @default("pending")
  priority     Int       @default(5)
  payload      Json
  result       Json?
  error        String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  scheduledFor DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([jobType])
  @@index([priority, status])
  @@index([scheduledFor])
  @@index([status])
}

model BaselineAssessment {
  id               String   @id
  userId           String   @unique
  completedAt      DateTime @default(now())
  totalQuestions   Int
  correctAnswers   Int
  accuracy         Float
  systemBreakdown  Json
  weakestSystems   String[]
  strongestSystems String[]

  @@index([userId])
}

model BranchChange {
  id            String        @id
  branchId      String
  contentId     String
  conditionId   String
  changeType    String
  contentData   Json
  previousData  Json?
  createdBy     String
  createdAt     DateTime      @default(now())
  ContentBranch ContentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([conditionId])
  @@index([contentId])
  @@index([createdAt])
}

model Buzzword {
  id          String        @id
  buzzword    String
  condition   String
  system      String
  subcategory String?
  explanation String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  DailyWordle DailyWordle[]

  @@index([condition])
  @@index([system])
}

model ClinicalGuideline {
  id              String   @id
  name            String
  description     String
  clinicalContext String?
  maxScore        Int
  components      Json
  scoringMap      Json?
  vignettes       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model ClinicalPearl {
  id                 String              @id
  system             String
  createdAt          DateTime            @default(now())
  category           String?
  extractedAt        DateTime            @default(now())
  fullExplanation    String?
  pearlText          String
  questionId         String?
  updatedAt          DateTime
  usefulVotes        Int                 @default(0)
  viewCount          Int                 @default(0)
  tags               String[]
  // New FK for deep relations
  conditionId        String?
  medicalContentId   String?
  Condition          Condition?          @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  MedicalContent     MedicalContent?     @relation(fields: [medicalContentId], references: [id], onDelete: SetNull)
  UserPearl          UserPearl[]
  PearlConditionLink PearlConditionLink[]

  @@index([category])
  @@index([conditionId])
  @@index([medicalContentId])
  @@index([questionId])
  @@index([system])
}

model Cohort {
  id            String          @id
  name          String
  code          String          @unique
  description   String?
  institution   String?
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  CohortMember  CohortMember[]
  PeerStatistic PeerStatistic[]

  @@index([isPublic])
  @@index([name])
}

model CohortMember {
  id       String     @id
  userId   String
  cohortId String
  role     CohortRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  Cohort   Cohort     @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  User     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([cohortId])
  @@index([userId])
}

model Condition {
  id                        String                      @id
  name                      String
  system                    String
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  aliases                   String[]                    @default([])
  content                   Json?
  displayName               String?
  mediaUrl                  String?                 @map("media_url")
  parentId                  String?
  relatedSystems            String[]                    @default([])
  status                    String                      @default("published")
  subcategory               String?
  parent_category           String?
  AnatomyConditionLink      AnatomyConditionLink[]
  Condition                 Condition?                  @relation("ConditionToCondition", fields: [parentId], references: [id], onDelete: Cascade)
  other_Condition           Condition[]                 @relation("ConditionToCondition")
  DrugConditionLink         DrugConditionLink[]
  ECGConditionLink          ECGConditionLink[]
  FindingConditionLink      FindingConditionLink[]
  ImagingConditionLink      ImagingConditionLink[]
  LabConditionLink          LabConditionLink[]
  MediaAsset                MediaAsset[]
  PhysiologyConditionLink   PhysiologyConditionLink[]
  ProcedureConditionLink    ProcedureConditionLink[]
  TreatmentConditionLink    TreatmentConditionLink[]
  AnatomyStructure          AnatomyStructure[]
  SpecialTest               SpecialTest[]
  // New deep relations
  DifferentialConditionLink DifferentialConditionLink[]
  AntibioticConditionLink   AntibioticConditionLink[]
  VitalSignConditionLink    VitalSignConditionLink[]
  ScoringSystemConditionLink ScoringSystemConditionLink[]
  PearlConditionLink        PearlConditionLink[]
  ConditionRelation1        ConditionRelation[]         @relation("ConditionRelation1")
  ConditionRelation2        ConditionRelation[]         @relation("ConditionRelation2")
  Question                  Question[]
  ClinicalPearl             ClinicalPearl[]
  ScoringSystem             ScoringSystem[]
  ConfusionPairReal         ConfusionPair[]             @relation("ConfusionPairReal")
  ConfusionPairMistaken     ConfusionPair[]             @relation("ConfusionPairMistaken")
  WeaknessPattern           WeaknessPattern[]
  DifferentialDiagnosis     DifferentialDiagnosis[]
  PreGeneratedQuestion      PreGeneratedQuestion[]
  QuestionSeed              QuestionSeed[]
  SavedQuestion             SavedQuestion[]

  @@index([displayName])
  @@index([name])
  @@index([parentId])
  @@index([status])
  @@index([subcategory])
  @@index([system])
  @@index([parent_category])
  @@index([system, parent_category])
  @@index([system, subcategory, parent_category])
}

model ConfusionPair {
  id               String     @id
  userId           String?
  realCondition    String
  mistakenFor      String
  count            Int        @default(1)
  lastOccurrence   DateTime   @default(now())
  createdAt        DateTime   @default(now())
  // New FKs for deep relations
  realConditionId  String?
  mistakenForId    String?
  RealCondition    Condition? @relation("ConfusionPairReal", fields: [realConditionId], references: [id], onDelete: SetNull)
  MistakenCondition Condition? @relation("ConfusionPairMistaken", fields: [mistakenForId], references: [id], onDelete: SetNull)
  User             User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, realCondition, mistakenFor])
  @@index([mistakenForId])
  @@index([realCondition])
  @@index([realConditionId])
  @@index([userId])
  @@index([userId, realCondition])
}

model ContentAuditLog {
  id                String         @id
  contentId         String
  conditionId       String
  version           Int
  changeType        String
  changeDescription String?
  changedFields     String[]
  oldValues         Json?
  newValues         Json?
  changedBy         String
  changedByRole     String
  changedAt         DateTime       @default(now())
  ipAddress         String?
  userAgent         String?
  MedicalContent    MedicalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([changeType])
  @@index([changedAt])
  @@index([changedBy])
  @@index([conditionId])
  @@index([contentId])
}

model ContentBranch {
  id            String         @id
  name          String         @unique
  description   String?
  baseBranch    String?
  status        String         @default("active")
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  mergedAt      DateTime?
  mergedBy      String?
  mergeCommitId String?
  contentCount  Int            @default(0)
  changeCount   Int            @default(0)
  BranchChange  BranchChange[]

  @@index([createdAt])
  @@index([createdBy])
  @@index([status])
}

model ContentHealthReport {
  id                  String   @id
  timestamp           DateTime @default(now())
  totalContent        Int
  missingExplanations Int      @default(0)
  brokenMediaLinks    Int      @default(0)
  invalidFields       Int      @default(0)
  outdatedContent     Int      @default(0)
  reportData          Json

  @@index([timestamp])
}

model ContentLock {
  id        String   @id
  contentId String   @unique
  lockedBy  String
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([contentId])
  @@index([expiresAt])
  @@index([lockedBy])
}

model ContentVersion {
  id                String         @id
  contentId         String
  version           Int
  content           Json
  changeType        String
  changeDescription String?
  changedBy         String
  changedAt         DateTime       @default(now())
  MedicalContent    MedicalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([changedAt])
  @@index([changedBy])
  @@index([contentId])
}

model DailyStreak {
  id                String   @id
  userId            String
  date              DateTime @db.Date
  questionsAnswered Int      @default(0)
  accuracyPercent   Float
  studyMinutes      Int      @default(0)
  createdAt         DateTime @default(now())
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

model DailyWordle {
  id        String   @id
  date      DateTime @unique @db.Date
  wordId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Buzzword  Buzzword @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

model DifferentialDiagnosis {
  id                        String                      @id
  presentingComplaint       String                      @unique
  category                  String
  isEmergency               Boolean                     @default(false)
  differentialList          String[]
  mustNotMiss               String[]
  workup                    String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  byAcuity                  Json?
  byAge                     Json?
  clinicalPearls            String[]                    @default([])
  commonMistakes            String[]                    @default([])
  diagnosticAlgorithm       String?
  dispositionGuidance       String?
  distinguishingFeatures    Json?
  initialWorkup             String[]                    @default([])
  isHighYield               Boolean                     @default(false)
  keyExamFindings           String[]                    @default([])
  keyQuestions              String[]                    @default([])
  mnemonics                 String[]                    @default([])
  mostCommon                String[]                    @default([])
  mostDangerous             String[]                    @default([])
  oftenMissed               String[]                    @default([])
  panceYield                Int?
  reassuringFeatures        String[]                    @default([])
  redFlags                  String[]                    @default([])
  typicalPresentation       String?
  // New FK for deep relations
  primaryConditionId        String?
  PrimaryCondition          Condition?                  @relation(fields: [primaryConditionId], references: [id], onDelete: SetNull)
  DifferentialConditionLink DifferentialConditionLink[]

  @@index([category])
  @@index([isEmergency])
  @@index([panceYield])
  @@index([primaryConditionId])
}

model Drug {
  id                  String              @id
  genericName         String              @unique
  brandName           String?
  drugClass           String[]
  mechanismOfAction   String?
  indications         String[]
  contraindications   String[]
  dosing              String?
  tags                String[]
  isHighYield         Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  aliases             String[]
  antidote            String?
  clinicalNotes       String?
  displayName         String?
  elimination         String?
  metabolism          String?
  sideEffects         String[]
  interactions        String[]
  absorption          String?
  administrationTips  String?
  bioavailability     String?
  blackBoxWarnings    String[]            @default([])
  boardYieldFacts     String[]            @default([])
  clinicalPearls      String[]            @default([])
  commonMistakes      String[]            @default([])
  cyp450Effects       Json?
  distribution        String?
  duration            String?
  eliminationRoute    String?
  foodInteractions    String[]            @default([])
  formulations        String[]            @default([])
  genericAvailable    Boolean             @default(false)
  geriatricDosing     String?
  geriatricNotes      String?
  halfLife            String?
  hepaticDosing       String?
  insuranceTier       Int?
  isFirstLine         Boolean             @default(false)
  lactationNotes      String?
  lactationSafety     String?
  majorInteractions   Json?
  maxDailyDose        String?
  mechanismDetailed   String?
  metabolismDetail    String?
  mnemonics           String[]            @default([])
  monitoringParams    String[]            @default([])
  onsetOfAction       String?
  panceYield          Int?
  peakEffect          String?
  pediatricDosing     String?
  pediatricNotes      String?
  pharmacokinetics    Json?
  pregnancyCategory   String?
  pregnancyNotes      String?
  renalDosing         String?
  reversalAgent       String?
  riskStrategies      String[]            @default([])
  routesOfAdmin       String[]            @default([])
  storageRequirements String?
  testQuestionTips    String[]            @default([])
  toxicity            String?
  typicalCost         String?
  DrugConditionLink   DrugConditionLink[]
  MediaAsset          MediaAsset[]
  // New deep relations
  DrugInteraction1    DrugInteraction[]   @relation("DrugInteraction1")
  DrugInteraction2    DrugInteraction[]   @relation("DrugInteraction2")

  @@index([genericName])
  @@index([isFirstLine])
  @@index([panceYield])
}

model DrugConditionLink {
  id               String          @id
  drugId           String
  conditionId      String
  medicalContentId String?
  relationshipType String
  evidenceLevel    String?
  notes            String?
  isFirstLine      Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  Condition        Condition       @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  Drug             Drug            @relation(fields: [drugId], references: [id], onDelete: Cascade)
  MedicalContent   MedicalContent? @relation(fields: [medicalContentId], references: [id], onDelete: SetNull)

  @@unique([drugId, conditionId, relationshipType])
  @@index([conditionId])
  @@index([medicalContentId])
  @@index([relationshipType])
}

model ECGConditionLink {
  id                 String          @id
  ecgPatternId       String
  conditionId        String
  medicalContentId   String?
  relationshipType   String
  findingDescription String?
  exampleImageUrls   String[]        @default([])
  annotatedImageUrls String[]        @default([])
  isFirstLine        Boolean?        @default(false)
  panceYield         Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now())
  Condition          Condition       @relation(fields: [conditionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ECGPattern         ECGPattern      @relation(fields: [ecgPatternId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  MedicalContent     MedicalContent? @relation(fields: [medicalContentId], references: [id], onDelete: SetNull)

  @@unique([ecgPatternId, conditionId, relationshipType])
  @@index([conditionId])
  @@index([ecgPatternId])
  @@index([medicalContentId])
  @@index([relationshipType])
}

model ECGPattern {
  id                     String             @id
  name                   String             @unique
  displayName            String?
  aliases                String[]           @default([])
  category               String
  subcategory            String?
  panceYield             Int?
  isHighYield            Boolean            @default(false)
  boardYieldFacts        String[]           @default([])
  isEmergency            Boolean            @default(false)
  rate                   String?
  rhythm                 String?
  pWave                  String?
  prInterval             String?
  qrsComplex             String?
  qtInterval             String?
  stSegment              String?
  tWave                  String?
  diagnosticCriteria     String[]           @default([])
  pathognomonic          String?
  etiology               String[]           @default([])
  symptoms               String[]           @default([])
  hemodynamicEffect      String?
  associatedConditions   String[]           @default([])
  acuteManagement        String?
  medications            String[]           @default([])
  cardioversion          String?
  pacing                 String?
  referral               String?
  mimics                 String[]           @default([])
  distinguishingFeatures Json?
  exampleEcgUrl          String?
  annotatedEcgUrl        String?
  clinicalPearls         String[]           @default([])
  commonMistakes         String[]           @default([])
  testQuestionTips       String[]           @default([])
  mnemonics              String[]           @default([])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime
  exampleImageUrls       String[]           @default([])
  annotatedImageUrls     String[]           @default([])
  ECGConditionLink       ECGConditionLink[]

  @@index([category])
  @@index([isEmergency])
  @@index([panceYield])
}

model EducationalResource {
  id               String    @id
  title            String
  resourceType     String
  fileUrl          String?
  originalFilename String?
  extractedText    String?
  summary          String?
  keyTopics        String[]
  author           String?
  source           String?
  pageNumber       Int?
  duration         Int?
  mimeType         String?
  fileSize         Int?
  conditionIds     String[]
  systemCodes      String[]
  approvalStatus   String    @default("pending")
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  qualityScore     Float?
  uploadedBy       String?
  uploadedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  viewCount        Int       @default(0)
  lastAccessedAt   DateTime?

  @@index([approvalStatus])
  @@index([approvedAt])
  @@index([keyTopics])
  @@index([resourceType])
  @@index([systemCodes])
  @@index([uploadedBy])
}

model EncounterResult {
  id         String   @id
  userId     String
  caseId     String
  score      Json
  feedback   String
  phasesData Json
  createdAt  DateTime @default(now())

  @@index([caseId])
  @@index([userId])
}

model ExplanationReaction {
  id         String   @id
  userId     String?
  questionId String
  reaction   String
  timestamp  DateTime @default(now())

  @@index([questionId])
  @@index([userId, questionId])
}

model FindingConditionLink {
  id                  String              @id
  findingId           String
  conditionId         String
  medicalContentId    String?
  relationshipType    String
  clinicalContext     String?
  sensitivity         Float?
  specificity         Float?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  Condition           Condition           @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  PhysicalExamFinding PhysicalExamFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  MedicalContent      MedicalContent?     @relation(fields: [medicalContentId], references: [id], onDelete: SetNull)

  @@unique([findingId, conditionId])
  @@index([conditionId])
  @@index([medicalContentId])
  @@index([relationshipType])
}

model FirstLineTreatment {
  id        String   @id
  condition String
  treatment String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model FluidCase {
  id              String   @id
  title           String
  scenario        String
  labs            Json
  correctAnswer   Float
  unit            String
  marginOfError   Float
  explanation     String
  calculationHint String?
  category        String
  difficulty      String   @default("medium")
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([category])
  @@index([difficulty])
}

model GrandRoundsAttempt {
  id                   String               @id
  userId               String
  challengeId          String
  score                Int
  correctCount         Int                  // Number of correct answers (out of 5)
  timeSpentMs          Int
  answers              Json?                // Store user's answers for potential review
  completedAt          DateTime             @default(now())
  createdAt            DateTime             @default(now())
  GrandRoundsChallenge GrandRoundsChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  User                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([challengeId, score])
  @@index([userId])
}

model GrandRoundsChallenge {
  id                 String               @id
  date               DateTime             @unique @db.Date
  questionIds        String[]
  createdAt          DateTime             @default(now())
  GrandRoundsAttempt GrandRoundsAttempt[]
}

