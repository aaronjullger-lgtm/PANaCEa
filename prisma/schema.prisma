generator client {
  provider = "prisma-client-js"
  // Note: engineType removed for Edge/Accelerate compatibility
}

datasource db {
  provider = "postgresql"
  // Note: Connection URLs are configured in prisma.config.ts for Prisma 7+
  // Runtime connections use PrismaClient constructor with accelerateUrl or adapter
}

model ACLSAlgorithm {
  id                  String   @id(map: "ACLSQuestion_pkey")
  algorithm           String
  correctIndex        Int
  category            String
  explanation         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  algorithmName       String?
  algorithmStep       Int?
  boardYieldFacts     String[] @default([])
  clinicalContext     String?
  clinicalPearls      String[] @default([])
  commonMistakes      String[] @default([])
  correctIntervention String?
  cprGuidance         String?
  criticalActions     String[] @default([])
  drugDose            String?
  drugTiming          String?
  ecgFindings         String[] @default([])
  energyDose          String?
  isHighYield         Boolean  @default(false)
  mnemonics           String[] @default([])
  panceYield          Int?
  patientAge          String?
  relatedAlgorithms   String[] @default([])
  rhythm              String?
  rhythmDescription   String?
  testQuestionTips    String[] @default([])
  videoUrl            String?

  @@index([algorithmName], map: "ACLSQuestion_algorithmName_idx")
  @@index([category], map: "ACLSQuestion_category_idx")
  @@index([panceYield], map: "ACLSQuestion_panceYield_idx")
  @@index([rhythm], map: "ACLSQuestion_rhythm_idx")
}

model AnatomyConditionLink {
  id               String           @id
  anatomyId        String
  conditionId      String
  medicalContentId String?
  relationshipType String
  clinicalContext  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  AnatomyStructure AnatomyStructure @relation(fields: [anatomyId], references: [id], onDelete: Cascade)
  Condition        Condition        @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  MedicalContent   MedicalContent?  @relation(fields: [medicalContentId], references: [id], onDelete: SetNull)

  @@unique([anatomyId, conditionId])
  @@index([conditionId])
  @@index([medicalContentId])
  @@index([relationshipType])
}

model AnatomyStructure {
  id                   String                 @id
  name                 String                 @unique
  system               String
  region               String?
  type                 String?
  description          String?
  function             String?
  innervation          String?
  bloodSupply          String?
  clinicalSignificance String?
  imageUrl             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  abbreviation         String?
  aliases              String[]               @default([])
  anastomoses          String[]               @default([])
  attachments          String[]               @default([])
  autonomicFunction    String?
  boardYieldFacts      String[]               @default([])
  borders              String?
  branches             String[]               @default([])
  clinicalPearls       String[]               @default([])
  commonMistakes       String[]               @default([])
  commonPathology      String[]               @default([])
  contents             String[]               @default([])
  dermatome            String?
  diagramUrl           String?
  examFindings         String[]               @default([])
  imagingFindings      String[]               @default([])
  injuryMechanism      String?
  insertion            String?
  isHighYield          Boolean                @default(false)
  latinName            String?
  layers               String[]               @default([])
  mnemonics            String[]               @default([])
  modelUrl             String?
  motorFunction        String?
  myotome              String?
  nervePath            String?
  nerveRoots           String?
  origin               String?
  palpationTips        String?
  panceYield           Int?
  relations            String?
  sensoryFunction      String?
  surfaceLandmarks     String[]               @default([])
  surgicalApproach     String?
  testQuestionTips     String[]               @default([])
  tributaries          String[]               @default([])
  vesselPath           String?
  videoUrl             String?
  AnatomyConditionLink AnatomyConditionLink[]
  Condition            Condition[]
  MediaAsset           MediaAsset[]

  @@index([name])
  @@index([panceYield])
  @@index([region])
  @@index([system])
}

model AntibioticGuideline {
  id                      String                    @id
  organism                String
  class                   String
  effective               Json
  resistant               Json
  notes                   String?
  description             String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  aliases                 String[]                  @default([])
  alternativeAntibiotics  String[]                  @default([])
  arrangement             String?
  boardYieldFacts         String[]                  @default([])
  carbapenemResistant     Boolean                   @default(false)
  classicPresentation     String?
  clinicalPearls          String[]                  @default([])
  commonInfections        String[]                  @default([])
  commonMistakes          String[]                  @default([])
  cultureCharacteristics  String?
  deEscalationGuidance    String?
  diagnosticClues         String[]                  @default([])
  doseRecommendations     Json?
  emergingResistance      String[]                  @default([])
  esblProducer            Boolean                   @default(false)
  firstLineAntibiotics    String[]                  @default([])
  gramStain               String?
  growthConditions        String?
  infectionControl        String[]                  @default([])
  isHighYield             Boolean                   @default(false)
  mnemonics               String[]                  @default([])
  morphology              String?
  mrResistance            Boolean                   @default(false)
  panceYield              Int?
  prophylaxis             String?
  reservoirs              String[]                  @default([])
  resistanceMechanisms    String[]                  @default([])
  testQuestionTips        String[]                  @default([])
  transmission            String[]                  @default([])
  treatmentDuration       String?
  vaccines                String[]                  @default([])
  vancomycinResistant     Boolean                   @default(false)
  virulenceFactors        String[]                  @default([])
  // New deep relations
  AntibioticConditionLink AntibioticConditionLink[]

  @@index([class])
  @@index([gramStain])
  @@index([organism])
  @@index([panceYield])
}

model BackgroundJob {
  id           String    @id
  jobType      String
  status       String    @default("pending")
  priority     Int       @default(5)
  payload      Json
  result       Json?
  error        String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  scheduledFor DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([jobType])
  @@index([priority, status])
  @@index([scheduledFor])
  @@index([status])
}

model BaselineAssessment {
  id               String   @id
  userId           String   @unique
  completedAt      DateTime @default(now())
  totalQuestions   Int
  correctAnswers   Int
  accuracy         Float
  systemBreakdown  Json
  weakestSystems   String[]
  strongestSystems String[]

  @@index([userId])
}

model BranchChange {
  id            String        @id
  branchId      String
  contentId     String
  conditionId   String
  changeType    String
  contentData   Json
  previousData  Json?
  createdBy     String
  createdAt     DateTime      @default(now())
  ContentBranch ContentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([conditionId])
  @@index([contentId])
  @@index([createdAt])
}

model Buzzword {
  id          String        @id
  buzzword    String
  condition   String
  system      String
  subcategory String?
  explanation String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  DailyWordle DailyWordle[]

  @@index([condition])
  @@index([system])
}

model ClinicalGuideline {
  id              String   @id
  name            String
  description     String
  clinicalContext String?
  maxScore        Int
  components      Json
  scoringMap      Json?
  vignettes       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model ClinicalPearl {
  id                 String               @id
  system             String
  createdAt          DateTime             @default(now())
  category           String?
  extractedAt        DateTime             @default(now())
  fullExplanation    String?
  pearlText          String
  questionId         String?
  updatedAt          DateTime
  usefulVotes        Int                  @default(0)
  viewCount          Int                  @default(0)
  tags               String[]
  // New FK for deep relations
  conditionId        String?
  medicalContentId   String?
  Condition          Condition?           @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  MedicalContent     MedicalContent?      @relation(fields: [medicalContentId], references: [id], onDelete: SetNull)
  UserPearl          UserPearl[]
  PearlConditionLink PearlConditionLink[]

  @@index([category])
  @@index([conditionId])
  @@index([medicalContentId])
  @@index([questionId])
  @@index([system])
}

model Cohort {
  id            String          @id
  name          String
  code          String          @unique
  description   String?
  institution   String?
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  CohortMember  CohortMember[]
  PeerStatistic PeerStatistic[]

  @@index([isPublic])
  @@index([name])
}

model CohortMember {
  id       String     @id
  userId   String
  cohortId String
  role     CohortRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  Cohort   Cohort     @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  User     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([cohortId])
  @@index([userId])
}

model Condition {
  id                         String                       @id
  name                       String
  system                     String
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  aliases                    String[]                     @default([])
  content                    Json?
  displayName                String?
  mediaUrl                   String?                      @map("media_url")
  parentId                   String?
  relatedSystems             String[]                     @default([])
  status                     String                       @default("published")
  subcategory                String?
  parent_category            String?
  AnatomyConditionLink       AnatomyConditionLink[]
  Condition                  Condition?                   @relation("ConditionToCondition", fields: [parentId], references: [id], onDelete: Cascade)
  other_Condition            Condition[]                  @relation("ConditionToCondition")
  DrugConditionLink          DrugConditionLink[]
  ECGConditionLink           ECGConditionLink[]
  FindingConditionLink       FindingConditionLink[]
  ImagingConditionLink       ImagingConditionLink[]
  LabConditionLink           LabConditionLink[]
  MediaAsset                 MediaAsset[]
  PhysiologyConditionLink    PhysiologyConditionLink[]
  ProcedureConditionLink     ProcedureConditionLink[]
  TreatmentConditionLink     TreatmentConditionLink[]
  AnatomyStructure           AnatomyStructure[]
  SpecialTest                SpecialTest[]
  // New deep relations
  DifferentialConditionLink  DifferentialConditionLink[]
  AntibioticConditionLink    AntibioticConditionLink[]
  VitalSignConditionLink     VitalSignConditionLink[]
  ScoringSystemConditionLink ScoringSystemConditionLink[]
  PearlConditionLink         PearlConditionLink[]
  ConditionRelation1         ConditionRelation[]          @relation("ConditionRelation1")
  ConditionRelation2         ConditionRelation[]          @relation("ConditionRelation2")
  Question                   Question[]
  ClinicalPearl              ClinicalPearl[]
  ScoringSystem              ScoringSystem[]
  ConfusionPairReal          ConfusionPair[]              @relation("ConfusionPairReal")
  ConfusionPairMistaken      ConfusionPair[]              @relation("ConfusionPairMistaken")
  WeaknessPattern            WeaknessPattern[]
  DifferentialDiagnosis      DifferentialDiagnosis[]
  PreGeneratedQuestion       PreGeneratedQuestion[]
  QuestionSeed               QuestionSeed[]
  SavedQuestion              SavedQuestion[]
  Guideline                  Guideline[]

  @@index([displayName])
  @@index([name])
  @@index([parentId])
  @@index([status])
  @@index([subcategory])
  @@index([system])
  @@index([parent_category])
  @@index([system, parent_category])
  @@index([system, subcategory, parent_category])
}

model ConfusionPair {
  id     String @id @default(cuid())
  userId String

  // Legacy string labels kept for compatibility with existing analytics/UI
  realCondition String
  mistakenFor   String

  count          Int      @default(1)
  lastOccurrence DateTime @updatedAt
  createdAt      DateTime @default(now())

  // Legacy Condition relations
  realConditionId   String?
  mistakenForId     String?
  RealCondition     Condition? @relation("ConfusionPairReal", fields: [realConditionId], references: [id], onDelete: SetNull)
  MistakenCondition Condition? @relation("ConfusionPairMistaken", fields: [mistakenForId], references: [id], onDelete: SetNull)

  // New MedicalContent-linked relations for precise comparisons
  correctConditionId  String?
  selectedConditionId String?
  CorrectCondition    MedicalContent? @relation("CorrectCondition", fields: [correctConditionId], references: [id], onDelete: SetNull)
  SelectedCondition   MedicalContent? @relation("SelectedCondition", fields: [selectedConditionId], references: [id], onDelete: SetNull)

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, realCondition, mistakenFor])
  @@unique([userId, correctConditionId, selectedConditionId])
  @@index([mistakenForId])
  @@index([realCondition])
  @@index([realConditionId])
  @@index([correctConditionId])
  @@index([selectedConditionId])
  @@index([userId])
  @@index([userId, correctConditionId])
  @@index([userId, realCondition])
}

model ContentAuditLog {
  id                String         @id
  contentId         String
  conditionId       String
  version           Int
  changeType        String
  changeDescription String?
  changedFields     String[]
  oldValues         Json?
  newValues         Json?
  changedBy         String
  changedByRole     String
  changedAt         DateTime       @default(now())
  ipAddress         String?
  userAgent         String?
  MedicalContent    MedicalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([changeType])
  @@index([changedAt])
  @@index([changedBy])
  @@index([conditionId])
  @@index([contentId])
}

model ContentBranch {
  id            String         @id
  name          String         @unique
  description   String?
  baseBranch    String?
  status        String         @default("active")
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  mergedAt      DateTime?
  mergedBy      String?
  mergeCommitId String?
  contentCount  Int            @default(0)
  changeCount   Int            @default(0)
  BranchChange  BranchChange[]

  @@index([createdAt])
  @@index([createdBy])
  @@index([status])
}

model ContentHealthReport {
  id                  String   @id
  timestamp           DateTime @default(now())
  totalContent        Int
  missingExplanations Int      @default(0)
  brokenMediaLinks    Int      @default(0)
  invalidFields       Int      @default(0)
  outdatedContent     Int      @default(0)
  reportData          Json

  @@index([timestamp])
}

model ContentLock {
  id        String   @id
  contentId String   @unique
  lockedBy  String
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([contentId])
  @@index([expiresAt])
  @@index([lockedBy])
}

model ContentVersion {
  id                String         @id
  contentId         String
  version           Int
  content           Json
  changeType        String
  changeDescription String?
  changedBy         String
  changedAt         DateTime       @default(now())
  MedicalContent    MedicalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([changedAt])
  @@index([changedBy])
  @@index([contentId])
}

model DailyStreak {
  id                String   @id
  userId            String
  date              DateTime @db.Date
  questionsAnswered Int      @default(0)
  accuracyPercent   Float
  studyMinutes      Int      @default(0)
  createdAt         DateTime @default(now())
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

model DailyWordle {
  id        String   @id
  date      DateTime @unique @db.Date
  wordId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Buzzword  Buzzword @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

model DifferentialDiagnosis {
  id                        String                      @id
  presentingComplaint       String                      @unique
  category                  String
  isEmergency               Boolean                     @default(false)
  differentialList          String[]
  mustNotMiss               String[]
  workup                    String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  byAcuity                  Json?
  byAge                     Json?
  clinicalPearls            String[]                    @default([])
  commonMistakes            String[]                    @default([])
  diagnosticAlgorithm       String?
  dispositionGuidance       String?
  distinguishingFeatures    Json?
  initialWorkup             String[]                    @default([])
  isHighYield               Boolean                     @default(false)
  keyExamFindings           String[]                    @default([])
  keyQuestions              String[]                    @default([])
  mnemonics                 String[]                    @default([])
  mostCommon                String[]                    @default([])
  mostDangerous             String[]                    @default([])
  oftenMissed               String[]                    @default([])
  panceYield                Int?
  reassuringFeatures        String[]                    @default([])
  redFlags                  String[]                    @default([])
  typicalPresentation       String?
  // New FK for deep relations
  primaryConditionId        String?
  PrimaryCondition          Condition?                  @relation(fields: [primaryConditionId], references: [id], onDelete: SetNull)
  DifferentialConditionLink DifferentialConditionLink[]

  @@index([category])
  @@index([isEmergency])
  @@index([panceYield])
  @@index([primaryConditionId])
}

model Drug {
  id                  String              @id
  genericName         String              @unique
  brandName           String?
