// This is the Prisma schema file for the PANaCEa medical learning platform.
// It defines the database models for managing conditions and their associated media assets.
//
// Learn more about Prisma at: https://www.prisma.io/docs
//
// Supabase Setup:
// 1. Create a Supabase project at https://supabase.com
// 2. Get your connection string from Project Settings > Database
// 3. For connection pooling (recommended for serverless):
//    - Use the "Transaction" mode connection string
//    - Add ?pgbouncer=true to the connection string
// 4. Set DATABASE_URL in your .env file
//
// To apply migrations:
// 1. Run: npx prisma migrate dev --name init_schema
// 2. Run: npx prisma generate --accelerate
//
// To push schema to Supabase (for initial setup):
// Run: npx prisma db push
//
// For Prisma Accelerate (Edge runtime):
// Generate with: npx prisma generate --accelerate
// or: npx prisma generate --no-engine

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL") // Optional: For migrations, bypass pooler
}

enum UserRole {
  USER
  VIEWER
  EDITOR
  APPROVER
  ADMIN
  SUPERADMIN
}

/// Represents a user in the learning platform, linked to Clerk authentication
model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique // Clerk user ID from authentication provider
  email     String   @unique
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Authentication fields
  emailVerified     DateTime? // Email verification timestamp
  role              UserRole  @default(USER)
  isAnonymous       Boolean   @default(false) // Hide identity in peer comparisons
  resetToken        String? // Password reset token (hashed)
  resetTokenExpiry  DateTime? // Reset token expiration
  verifyToken       String? // Email verification token (hashed)
  verifyTokenExpiry DateTime? // Verification token expiration

  /// Onboarding fields
  hasCompletedBaseline   Boolean   @default(false) // Has completed baseline assessment
  hasCompletedOnboarding Boolean   @default(false) // Has completed initial onboarding
  examDate               DateTime? // Target PANCE/PANRE exam date
  graduationDate         DateTime? // Expected/actual graduation date from PA school
  school                 String? // PA school/program name
  currentRotation        String? // Current clinical rotation (e.g., "Emergency Medicine", "Surgery")
  yearInProgram          String? // "Didactic Year 1", "Clinical Year", "Graduated", "Post-Graduate"

  /// User's performance records
  performanceRecords PerformanceRecord[]
  /// User's SRS (Spaced Repetition System) items
  srsItems           SRSItem[]
  /// User's saved questions (flagged/missed)
  savedQuestions     SavedQuestion[]
  /// User's achievements
  achievements       UserAchievement[]
  /// User's daily streaks
  streaks            DailyStreak[]
  /// User's question history
  questionHistory    UserQuestionHistory[]

  /// User's saved pearls
  userPearls UserPearl[]

  /// Wordle daily game states
  wordleStates UserWordleState[]

  /// Active Patient Encounter Sessions
  patientEncounterSessions PatientEncounterSession[]

  /// Admin audit logs (for admin users)
  // adminAuditLogs     AdminAuditLog[]

  /// Social
  studyGroups StudyGroupMember[]

  /// Cohort memberships (professional study groups)
  cohorts CohortMember[]

  /// Grand Rounds attempts
  grandRoundsAttempts GrandRoundsAttempt[]

  /// User-specific FSRS tuning config
  srsConfig UserSRSConfig?

  /// Peer statistics snapshots
  peerStats PeerStatistic[]

  @@index([clerkId])
  @@index([email])
  @@index([role])
}

/// Stores user-specific FSRS algorithm parameters (the 'w' weights) for personalized spaced repetition
model UserSRSConfig {
  id               String   @id @default(uuid())
  userId           String   @unique
  requestRetention Float    @default(0.9) // Target retention (0.8 - 0.95)
  wWeights         Json // Array of 19 FSRS parameters
  lastTuned        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastTuned])
}

/// Represents a laboratory test definition
model LabTest {
  id                  String   @id @default(uuid())
  name                String   @unique
  category            String
  commonAbnormalities String[]
  typicalUse          String?

  // ===== NEW: PANCE Prioritization =====
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // ===== NEW: Reference Ranges =====
  conventionalRange String? // Normal range in conventional units
  siRange           String? // Normal range in SI units
  units             String? // Conventional units
  siUnits           String? // SI units
  conversionFactor  Float? // Multiply conventional by this to get SI
  referenceRanges   Json? // { adult: { male: { low, high }, female: { low, high } }, pediatric: {...}, geriatric: {...} }
  criticalValues    Json? // { criticalLow, criticalHigh, action }

  // ===== NEW: Clinical Interpretation =====
  increaseIndicates  String[] @default([]) // Conditions causing elevation
  decreaseIndicates  String[] @default([]) // Conditions causing decrease
  falsePosNeg        String?  @db.Text // Causes of false results
  interferingFactors String[] @default([]) // Factors affecting results

  // ===== NEW: Sample & Testing =====
  sampleType          String? // Serum, plasma, whole blood, urine, CSF
  collectionTube      String? // Green top, purple top, etc.
  fastingRequired     Boolean @default(false)
  specialInstructions String? @db.Text
  turnaroundTime      String? // Typical time to results
  stability           String? // Sample stability requirements

  // ===== NEW: Clinical Context =====
  whenToOrder   String[] @default([]) // Indications for ordering
  relatedTests  String[] @default([]) // Tests often ordered together
  followUpTests String[] @default([]) // Tests to order if abnormal

  // ===== NEW: Teaching Points =====
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  mnemonics        String[] @default([])
  testQuestionTips String[] @default([])

  // ===== NEW: Interpretation Guides =====
  interpretationSteps String? @db.Text // Step-by-step interpretation
  clinicalScenarios   Json? // [{ scenario, expectedResult, explanation }]

  // ===== NEW: Relations =====
  conditionLinks LabConditionLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([panceYield])
}

/// Represents a clinical case for lab interpretation training
model LabCase {
  id               String   @id @default(uuid())
  correctDiagnosis String
  clinicalVignette String
  labs             Json // Stores the lab results structure
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Represents a single performance record from a quiz session
model PerformanceRecord {
  id                String   @id @default(uuid())
  userId            String
  topic             String
  system            String? // System code (CV, PULM, GI, etc.)
  focus             String // "all" | "topic" | "growth" | "review" | "reviewFlagged"
  difficulty        String // "same" | "adaptive"
  isCorrect         Boolean
  timestamp         BigInt // Unix timestamp in milliseconds
  questionWordCount Int?
  errorTag          String? // "knowledge_gap" | "misread_question" | "guessing" | etc.
  subcategoryName   String?
  conditionName     String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, timestamp])
  @@index([topic])
  @@index([system])
}

/// Represents a Spaced Repetition System item for a user
model SRSItem {
  id             String   @id @default(uuid())
  userId         String
  questionId     String // Unique identifier for the question content
  interval       Int // Days until next review
  repetition     Int // Number of successful reviews
  easiness       Float // Easiness Factor (EF), minimum 1.3
  dueDate        DateTime
  lastReviewed   DateTime
  quality        Int // Last quality response (0-5)
  difficulty     Float // Normalized 0-1 difficulty
  stabilityScore Float // Research variable for forgetting curve
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // FSRS v5 Specific Fields
  fsrsStability  Float? // Memory stability (S) in days
  fsrsDifficulty Float? // Difficulty (D) on 1-10 scale
  fsrsState      Int       @default(0) // 0=New, 1=Learning, 2=Review, 3=Relearning
  fsrsLastReview DateTime? // Timestamp of last FSRS review

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([userId, dueDate])
  @@index([questionId])
}

/// Represents a saved question (flagged or missed) for review
model SavedQuestion {
  id              String   @id @default(uuid())
  userId          String
  questionId      String // Unique identifier for the question content
  questionText    String   @db.Text
  correctAnswer   String
  explanation     String   @db.Text
  topic           String
  system          String?
  type            String // "missed" | "flagged"
  userNote        String?  @db.Text
  repetitionLevel Int      @default(1)
  nextReviewDate  String? // ISO date string (YYYY-MM-DD)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId, type])
  @@index([userId])
  @@index([userId, type])
  @@index([questionId])
}

/// Represents a medical condition in the learning platform.
/// Conditions are the primary educational content unit.
/// Enhanced with parent-child relationships and aliases for smart search
model Condition {
  id     String @id @default(uuid())
  name   String
  system String // Organ system (e.g., "CV", "PULM", "GI")

  /// Subcategory within system (e.g., "Arrhythmias", "Valvular")
  subcategory String?

  /// Cross-system tagging for conditions that span multiple systems
  /// e.g., SLE appears in Rheumatology, Derm, Renal
  relatedSystems String[] @default([])

  /// Status for visibility in UI
  status String @default("published") // draft, published, archived

  /// Parent-child relationships for condition variants
  parentId String? // Reference to parent condition (null if this is a parent)
  parent   Condition?  @relation("ConditionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Condition[] @relation("ConditionHierarchy")

  /// Clean display name (without parentheses or aliases)
  displayName String?

  /// Alternative names and aliases for search
  aliases String[] @default([])

  /// Content sections (as JSONB) - for inline content
  content Json? // Pathophysiology, Clinical Presentation, Diagnosis, Management, Pearls

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Associated media assets for this condition
  media MediaAsset[]

  /// Associated anatomy
  anatomyStructures AnatomyStructure[]

  /// Associated special tests
  specialTests SpecialTest[]

  // ===== NEW: Junction table relations =====
  drugLinks       DrugConditionLink[]
  labLinks        LabConditionLink[]
  imagingLinks    ImagingConditionLink[]
  findingLinks    FindingConditionLink[]
  anatomyLinks    AnatomyConditionLink[]
  physiologyLinks PhysiologyConditionLink[]
  treatmentLinks  TreatmentConditionLink[]
  procedureLinks  ProcedureConditionLink[]

  @@index([system])
  @@index([name])
  @@index([parentId])
  @@index([displayName])
  @@index([status])
  @@index([subcategory])
}

/// Represents an anatomical structure relevant to medical conditions
model AnatomyStructure {
  id                   String  @id @default(uuid())
  name                 String  @unique // e.g. "Anterior Cruciate Ligament"
  system               String // e.g. "MSK"
  region               String? // e.g. "Knee"
  type                 String? // e.g. "Ligament", "Muscle"
  description          String? @db.Text
  function             String? @db.Text
  innervation          String?
  bloodSupply          String?
  clinicalSignificance String? @db.Text
  imageUrl             String? // Diagram URL

  // ===== NEW: PANCE Prioritization =====
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // ===== NEW: Classification =====
  aliases      String[] @default([]) // Alternative names
  latinName    String? // Anatomical term
  abbreviation String? // Common abbreviation

  // ===== NEW: Detailed Anatomy =====
  origin      String?  @db.Text // Muscle origin
  insertion   String?  @db.Text // Muscle insertion
  attachments String[] @default([]) // For ligaments/tendons
  borders     String?  @db.Text // Anatomical borders
  contents    String[] @default([]) // For spaces/compartments
  relations   String?  @db.Text // Adjacent structures
  layers      String[] @default([]) // For layered structures

  // ===== NEW: Nerve/Vessel Details =====
  nervePath         String?  @db.Text // Course of nerve
  nerveRoots        String? // Spinal nerve roots
  motorFunction     String?  @db.Text
  sensoryFunction   String?  @db.Text
  autonomicFunction String?  @db.Text
  vesselPath        String?  @db.Text // Course of vessel
  branches          String[] @default([])
  tributaries       String[] @default([])
  anastomoses       String[] @default([])

  // ===== NEW: Clinical Correlations =====
  injuryMechanism  String?  @db.Text // How it gets injured
  commonPathology  String[] @default([])
  examFindings     String[] @default([]) // PE findings for injury
  imagingFindings  String[] @default([])
  surgicalApproach String?  @db.Text

  // ===== NEW: Landmarks & Surface Anatomy =====
  surfaceLandmarks String[] @default([])
  palpationTips    String?  @db.Text
  dermatome        String?
  myotome          String?

  // ===== NEW: Teaching Points =====
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])

  // ===== NEW: Media =====
  diagramUrl String?
  modelUrl   String? // 3D model URL
  videoUrl   String? // Dissection video

  // Relations
  conditions     Condition[] // Conditions affecting this structure
  conditionLinks AnatomyConditionLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([system])
  @@index([name])
  @@index([region])
  @@index([panceYield])
}

/// Represents a special physical exam test
model SpecialTest {
  id   String @id @default(uuid())
  name String @unique // e.g. "Lachman Test"

  // Search and display
  displayName String? // Clean display name
  aliases     String[] @default([]) // Alternative names (e.g., "Anterior Drawer Test")

  system         String? // e.g. "MSK"
  region         String? // e.g. "Knee"
  description    String? @db.Text
  sensitivity    Float? // 0-100
  specificity    Float? // 0-100
  technique      String? @db.Text // How to perform
  positiveTest   String? @db.Text // What constitutes a positive result
  interpretation String? @db.Text // What a positive result means
  imageUrl       String?
  videoUrl       String?

  // Relations
  conditions Condition[] // Conditions this tests for

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([displayName])
}

/// Represents a media asset (EKG, imaging, lab table, diagram, etc.)
/// linked to a medical condition. Enhanced for centralized media library.
model MediaAsset {
  id          String  @id @default(uuid())
  conditionId String?
  type        String // "ekg" | "imaging" | "labs" | "diagram" | "photo" | "other"
  filename    String

  /// Object storage URLs
  originalUrl  String? // Full-resolution URL (S3/R2)
  thumbnailUrl String? // Lower-res thumbnail for UI

  /// Metadata and tagging
  tags        String[] // Keywords: "X-Ray", "Chest", "Pneumonia", etc.
  description String?  @db.Text
  altText     String?  @db.Text // Accessibility
  mimeType    String? // image/jpeg, image/png, etc.
  fileSize    Int? // Bytes
  dimensions  Json? // { width: 1920, height: 1080 }

  /// AI matching and quality
  confidence Float @default(0) // AI matching confidence score (0-1)
  aiMetadata Json? // Additional AI analysis data

  /// Approval workflow for quality control
  approvalStatus  String    @default("pending") // "pending" | "approved" | "rejected"
  status          String    @default("pending_review") // "pending_review" | "approved" | "rejected" | "flagged"
  approvedBy      String? // User ID who approved/rejected
  approvedAt      DateTime? // When approval decision was made
  rejectionReason String?   @db.Text // Why rejected (if applicable)
  qualityScore    Float? // 0-100 quality assessment score (AI-assigned, 1-10 scale can be 10-100)
  isClinical      Boolean   @default(false) // Is this a clinical image (vs diagram/illustration)?

  /// Organization and folder structure
  folder String @default("inbox") // "inbox" (no-use), "clinical_verified" (use), "archive"

  /// Textbook/Lecture Support
  mediaType   String  @default("image") // "image" | "pdf" | "video" | "audio"
  textContent String? @db.Text // OCR text extracted from textbooks for search
  pageCount   Int? // For PDFs
  duration    Int? // For Video/Audio (seconds)

  /// Source Tracking
  sourceUrl String? // Where it came from (if scraped)
  citation  String? // "Harrison's Principles of Internal Medicine, 21st Ed."

  /// Drill/Quiz fields for Photo/ECG/Derm drills
  correctDiagnosis String? // The correct diagnosis for this image (used in drills)
  distractors      Json? // Array of incorrect diagnoses for multiple choice
  clinicalContext  Json? // Patient demographics, vitals, chief complaint (ClinicalContext interface)

  /// Upload tracking
  uploadedBy String? // User ID
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Relations
  condition Condition? @relation(fields: [conditionId], references: [id])
  // processingJob ImageProcessingJob? // One-to-one with processing job
  // annotations ImageAnnotation[]

  @@index([conditionId])
  @@index([type])
  @@index([filename])
  @@index([tags])
  @@index([uploadedBy])
  @@index([approvalStatus])
  @@index([status])
  @@index([folder])
  @@index([mediaType])
  @@index([approvedAt])
}

/// Represents rapid-fire ACLS/PALS/BLS questions for Code Blue Speed Mode
model ACLSQuestion {
  id           String @id @default(uuid())
  question     String @db.Text
  options      Json // Array of strings (answer choices)
  correctIndex Int // Index of the correct answer (0-based)
  category     String // "ACLS" | "PALS" | "BLS" | "Critical Care"
  explanation  String @db.Text

  // ===== NEW: PANCE Prioritization =====
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // ===== NEW: Algorithm Context =====
  algorithmName     String? // Name of ACLS algorithm (e.g., "VF/pVT", "Asystole/PEA")
  algorithmStep     Int? // Which step in algorithm
  relatedAlgorithms String[] @default([])

  // ===== NEW: Clinical Scenario =====
  rhythm            String? // VF, VT, Asystole, PEA, Brady, Tachy
  rhythmDescription String?  @db.Text
  ecgFindings       String[] @default([])
  clinicalContext   String?  @db.Text
  patientAge        String? // Adult, Pediatric, Neonatal

  // ===== NEW: Intervention Details =====
  correctIntervention String? @db.Text
  drugDose            String? // e.g., "Epinephrine 1mg IV"
  drugTiming          String? // e.g., "Every 3-5 minutes"
  energyDose          String? // Defibrillation joules
  cprGuidance         String? @db.Text

  // ===== NEW: Common Errors =====
  commonMistakes  String[] @default([])
  criticalActions String[] @default([]) // Must-do actions

  // ===== NEW: Teaching Points =====
  clinicalPearls   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])
  videoUrl         String? // Link to algorithm video

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([algorithmName])
  @@index([rhythm])
  @@index([panceYield])
}

/// Represents fluid/electrolyte clinical cases for calculation drills
model FluidCase {
  id              String   @id @default(uuid())
  title           String
  scenario        String   @db.Text
  labs            Json // Complex lab data: { bmp: {...}, urineNa: 12, urineCr: 180 }
  correctAnswer   Float // Numeric answer (e.g., 0.36 for FENa)
  unit            String // Unit of measurement (%, mEq/L, L, mL/hr)
  marginOfError   Float // Acceptable deviation from correct answer
  explanation     String   @db.Text
  calculationHint String?  @db.Text // Formula hint (e.g., "FENa = [(UNa × SCr) / (SNa × UCr)] × 100")
  category        String // "fena" | "anion_gap" | "free_water_deficit" | "maintenance_fluids"
  difficulty      String   @default("medium") // "easy" | "medium" | "hard"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([difficulty])
}

// =============================================================================
// NEW TABLES: Medical Procedures, History, ECG, Vital Signs
// =============================================================================

/// Represents a medical/surgical procedure
model Procedure {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String?
  aliases     String[] @default([])
  category    String // Diagnostic, Therapeutic, Surgical, Bedside
  type        String? // Minor, Major, Outpatient, Inpatient
  system      String? // Body system
  description String?  @db.Text

  // PANCE Prioritization
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // Indications & Contraindications
  indications               String[] @default([])
  absoluteContraindications String[] @default([])
  relativeContraindications String[] @default([])

  // Technique
  preparation       String?  @db.Text // Patient prep
  equipment         String[] @default([])
  anatomicLandmarks String[] @default([])
  technique         String?  @db.Text // Step-by-step
  positioning       String? // Patient position
  anesthesia        String? // Local, regional, general
  duration          String? // Typical procedure time

  // Complications & Safety
  complications       String[] @default([])
  complicationRates   Json? // { complication: rate }
  emergencyManagement String?  @db.Text
  safetyChecklist     String[] @default([])

  // Post-Procedure
  postProcedureCare String?  @db.Text
  expectedFindings  String?  @db.Text
  abnormalFindings  String[] @default([])
  followUp          String?  @db.Text
  recovery          String? // Recovery time

  // Consent & Documentation
  consentPoints             String[] @default([]) // Key consent discussion points
  documentationRequirements String[] @default([])

  // Teaching Points
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])
  videoUrl         String?

  // Relations
  conditionLinks ProcedureConditionLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([system])
  @@index([panceYield])
}

/// Represents a history-taking component (HPI elements, ROS, PMH, etc.)
model HistoryComponent {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "OLDCARTS", "Chest Pain History"
  displayName String?
  category    String // HPI, ROS, PMH, FH, SH, Medications, Allergies
  system      String? // Body system if applicable
  description String? @db.Text

  // PANCE Prioritization
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // Component Details
  elements         String[] @default([]) // Individual questions/elements
  expandedElements Json? // [{ element, followUp questions, significance }]
  requiredFor      String[] @default([]) // Presentations requiring this

  // HPI Frameworks
  frameworkName     String? // OLDCARTS, SOCRATES, OPQRST
  frameworkElements Json? // [{ letter, meaning, exampleQuestions }]

  // ROS Specifics
  rosCategory        String? // Constitutional, Eyes, ENT, etc.
  positiveIndicators String[] @default([]) // Symptoms suggesting pathology
  negativeIndicators String[] @default([]) // Pertinent negatives

  // Clinical Decision Making
  redFlagResponses    String[] @default([]) // Answers that indicate urgency
  reassuringResponses String[] @default([]) // Answers that indicate benign
  diagnosticValue     Json? // { response: likelyConditions }

  // Documentation
  documentationTips String?  @db.Text
  chartingExamples  String[] @default([])

  // Teaching Points
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([system])
  @@index([panceYield])
}

/// Represents an ECG pattern for rhythm recognition training
model ECGPattern {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "Atrial Fibrillation", "STEMI Anterior"
  displayName String?
  aliases     String[] @default([])
  category    String // Arrhythmia, Ischemia, Conduction, Metabolic, Drug Effect
  subcategory String? // e.g., "Supraventricular", "Ventricular"

  // PANCE Prioritization
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])
  isEmergency     Boolean  @default(false)

  // ECG Characteristics
  rate       String? // Normal, brady, tachy, irregular
  rhythm     String? // Regular, irregular, regularly irregular
  pWave      String? @db.Text // P wave description
  prInterval String? // Normal, prolonged, shortened, variable
  qrsComplex String? @db.Text // QRS description
  qtInterval String? // Normal, prolonged, shortened
  stSegment  String? @db.Text // ST changes
  tWave      String? @db.Text // T wave description

  // Diagnostic Criteria
  diagnosticCriteria String[] @default([])
  pathognomonic      String? // Pathognomonic finding if any

  // Clinical Correlation
  etiology             String[] @default([]) // Causes
  symptoms             String[] @default([]) // Patient symptoms
  hemodynamicEffect    String?  @db.Text
  associatedConditions String[] @default([])

  // Management
  acuteManagement String?  @db.Text
  medications     String[] @default([])
  cardioversion   String? // When indicated
  pacing          String? // When indicated
  referral        String? // Cardiology referral criteria

  // Differential
  mimics                 String[] @default([]) // Patterns that look similar
  distinguishingFeatures Json? // [{ pattern, howToDifferentiate }]

  // Media
  exampleEcgUrl   String?
  annotatedEcgUrl String?

  // Teaching Points
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([panceYield])
  @@index([isEmergency])
}

/// Represents vital sign reference ranges and interpretations
model VitalSignRange {
  id          String  @id @default(uuid())
  vitalSign   String  @unique // HR, BP, RR, Temp, O2Sat, BMI, etc.
  displayName String?
  category    String // Cardiovascular, Respiratory, Metabolic

  // Reference Ranges
  normalRange String? // Normal adult range
  ranges      Json? // { adult: { low, high }, pediatric: { neonate, infant, child }, geriatric: {...} }
  units       String? // bpm, mmHg, breaths/min, etc.

  // Interpretations
  elevation  Json? // { mild: {}, moderate: {}, severe: {}, causes: [], management: [] }
  depression Json? // { mild: {}, moderate: {}, severe: {}, causes: [], management: [] }

  // Clinical Significance
  emergencyValues      Json? // { criticalHigh, criticalLow, immediateAction }
  associatedConditions Json? // { elevated: [], decreased: [] }

  // Teaching Points
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// Represents a scoring/clinical decision rule (Wells, CURB-65, etc.)
model ScoringSystem {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "Wells DVT", "CURB-65"
  displayName String?
  aliases     String[] @default([])
  category    String // Risk Stratification, Diagnostic, Prognostic, Screening
  condition   String? // Primary condition it's used for

  // PANCE Prioritization
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // Scoring Components
  components Json // [{ criterion, points, description }]
  maxScore   Int?
  minScore   Int? @default(0)

  // Interpretation
  interpretation   Json // [{ scoreRange, riskLevel, recommendation }]
  actionThresholds Json? // { lowRisk: action, highRisk: action }

  // Validation
  sensitivity       Float? // At recommended cutoff
  specificity       Float?
  validationStudies String[] @default([])
  limitations       String[] @default([])

  // Clinical Use
  whenToUse       String?  @db.Text
  whenNotToUse    String[] @default([])
  clinicalContext String?  @db.Text

  // Teaching Points
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])

  // Calculator
  calculatorUrl String? // Link to online calculator

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([condition])
  @@index([panceYield])
}

/// Represents antibiotic-organism coverage guidelines for Bug-Drug drill
model AntibioticGuideline {
  id          String  @id @default(uuid())
  organism    String // Organism name (e.g., "Pseudomonas aeruginosa")
  class       String // Organism class (e.g., "Gram Negative", "Atypical")
  effective   Json // Array of effective antibiotics (e.g., ["Cefepime", "Meropenem"])
  resistant   Json // Array of resistant/ineffective antibiotics
  notes       String? @db.Text // Additional clinical notes
  description String? // Clinical context (e.g., "Most common cause of CAP")

  // ===== NEW: PANCE Prioritization =====
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // ===== NEW: Organism Details =====
  aliases          String[] @default([]) // Alternative names
  gramStain        String? // Positive, Negative, Variable
  morphology       String? // Cocci, Rod, Spirochete, etc.
  arrangement      String? // Clusters, chains, pairs
  growthConditions String? // Aerobic, anaerobic, facultative
  virulenceFactors String[] @default([])
  reservoirs       String[] @default([]) // Where organism lives
  transmission     String[] @default([]) // How it spreads

  // ===== NEW: Clinical Infections =====
  commonInfections       String[] @default([]) // Infections this organism causes
  classicPresentation    String?  @db.Text
  diagnosticClues        String[] @default([])
  cultureCharacteristics String?  @db.Text // Colony appearance, etc.

  // ===== NEW: Treatment Details =====
  firstLineAntibiotics   String[] @default([])
  alternativeAntibiotics String[] @default([])
  doseRecommendations    Json? // { antibiotic: dosing }
  treatmentDuration      String?
  deEscalationGuidance   String?  @db.Text

  // ===== NEW: Resistance =====
  resistanceMechanisms String[] @default([])
  mrResistance         Boolean  @default(false) // Multi-drug resistant
  esblProducer         Boolean  @default(false)
  carbapenemResistant  Boolean  @default(false)
  vancomycinResistant  Boolean  @default(false)
  emergingResistance   String[] @default([])

  // ===== NEW: Prevention =====
  vaccines         String[] @default([])
  prophylaxis      String?  @db.Text
  infectionControl String[] @default([])

  // ===== NEW: Teaching Points =====
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])
  mnemonics        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organism])
  @@index([class])
  @@index([panceYield])
  @@index([gramStain])
}

/// Represents an achievement earned by a user
model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String // Achievement identifier from definitions
  unlockedAt    DateTime @default(now())
  progress      Int      @default(100) // 0-100, for progressive achievements

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

/// Represents daily activity streaks for gamification
model DailyStreak {
  id                String   @id @default(uuid())
  userId            String
  date              DateTime @db.Date // Date of activity (YYYY-MM-DD)
  questionsAnswered Int      @default(0) // Questions answered on this day
  accuracyPercent   Float // Accuracy for the day
  studyMinutes      Int      @default(0) // Minutes studied
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// Represents a daily Grand Rounds challenge available to all users
model GrandRoundsChallenge {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date // One challenge per calendar day
  questionIds String[]
  createdAt   DateTime @default(now())

  attempts GrandRoundsAttempt[]
}

/// Represents a user's attempt at the daily Grand Rounds challenge
model GrandRoundsAttempt {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  score       Int
  timeSpentMs Int
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge GrandRoundsChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([challengeId])
}

/// Represents confusion pairs tracked for DDx analysis
model ConfusionPair {
  id             String   @id @default(uuid())
  userId         String? // Null for global stats, set for user-specific
  realCondition  String // The correct condition
  mistakenFor    String // What user incorrectly chose
  count          Int      @default(1) // How many times this happened
  lastOccurrence DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([userId, realCondition, mistakenFor])
  @@index([userId])
  @@index([userId, realCondition])
  @@index([realCondition])
}

/// Represents mastery tier progress for conditions/topics
model MasteryProgress {
  id            String   @id @default(uuid())
  userId        String
  conditionName String? // Specific condition, or null for system-level
  systemCode    String? // CV, PULM, GI, etc.
  subcategory   String?
  masteryTier   String   @default("bronze") // bronze, silver, gold, platinum
  accuracy      Float // Current accuracy percentage
  attempts      Int      @default(0)
  lastAttempt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, conditionName, systemCode, subcategory])
  @@index([userId])
  @@index([systemCode])
}

/// Represents baseline assessment results
model BaselineAssessment {
  id               String   @id @default(uuid())
  userId           String   @unique
  completedAt      DateTime @default(now())
  totalQuestions   Int
  correctAnswers   Int
  accuracy         Float
  systemBreakdown  Json // System-level performance breakdown
  weakestSystems   String[] // Top 3 weakest systems
  strongestSystems String[] // Top 3 strongest systems

  @@index([userId])
}

/// Represents user feedback on explanation helpfulness
model ExplanationReaction {
  id         String   @id @default(uuid())
  userId     String? // Null for anonymous feedback
  questionId String // Question identifier
  reaction   String // "helpful" | "not_helpful"
  timestamp  DateTime @default(now())

  @@index([questionId])
  @@index([userId, questionId])
}

/// Represents user weakness patterns for adaptive learning
model WeaknessPattern {
  id               String   @id @default(uuid())
  userId           String
  conditionId      String
  wasCorrect       Boolean
  timestamp        DateTime @default(now())
  consecutiveWrong Int      @default(0) // Track consecutive wrong answers

  @@index([userId])
  @@index([userId, conditionId])
  @@index([conditionId])
}

/// Represents medical content for the CMS with full version control
model MedicalContent {
  id          String @id @default(uuid())
  conditionId String @unique // e.g., "CV__ecg__atrial_fibrillation"
  system      String // Primary system code (CV, PULM, GI, etc.)
  subcategory String
  condition   String

  /// Cross-system tagging (e.g., ["DERM", "HEENT"])
  relatedSystems String[] @default([])

  // =========================================================================
  // DEEP DIVE CONTENT (Markdown text for prose rendering)
  // =========================================================================
  overview              String? @db.Text
  etiology              String? @db.Text
  pathophysiology       String? @db.Text
  epidemiology          String? @db.Text
  symptoms              String? @db.Text // Markdown list
  physicalExam          String? @db.Text // Markdown list
  diagnostics           String? @db.Text // Comprehensive diagnostic approach
  treatment             String? @db.Text // Markdown list
  prognosis             String? @db.Text
  differentialDiagnosis String? @db.Text // Markdown list
  riskFactors           String? @db.Text // Markdown list
  complications         String? @db.Text // Markdown list

  // =========================================================================
  // HIGH-YIELD METADATA (Badge-style quick reference)
  // =========================================================================
  buzzwords         String[] @default([])
  classic_triad     Json? // ["Fever", "Murmur", "Osler Nodes"]
  clinical_pearls   Json? // Full sentences with actionable advice
  gold_standard_dx  String?  @db.Text // Concise badge (< 8 words)
  first_line_rx     String?  @db.Text // Concise badge (< 8 words)
  best_initial_test String?  @db.Text // Screening test done FIRST

  // =========================================================================
  // PHARMACOLOGY CONTEXT (For the First-Line Rx)
  // =========================================================================
  rx_mechanism    String? @db.Text // MOA of first-line treatment
  rx_side_effects String? @db.Text // Top testable side effects

  // =========================================================================
  // VIGNETTE & SEARCH (Board-style recognition)
  // =========================================================================
  classic_patient String? @db.Text // "Fat, Forty, Female, Fertile"
  synonyms        Json? // ["GCA", "Temporal Arteritis", "Horton Disease"]
  mnemonic        String? @db.Text // "SAD for Aortic Stenosis"

  // =========================================================================
  // STRUCTURED DIFFERENTIALS (For comparison tables)
  // =========================================================================
  differentials Json? // [{ condition: "X", rule_out: "Y" }]

  // =========================================================================
  // CLINICAL MANAGEMENT & COUNSELING
  // =========================================================================
  patient_education String? @db.Text // Key counseling points
  disposition       String? @db.Text // Admission criteria, referrals
  prevention        String? @db.Text // Screening guidelines (USPSTF)
  guidelines        String? @db.Text // "2023 ACR Guidelines"

  // =========================================================================
  // DEMOGRAPHICS & STUDY PRIORITIZATION
  // =========================================================================
  age_demographic Json? // ["Child", "Adult", "Elderly"]
  gender_bias     String? // "Female > Male"
  pance_yield     Int? // 1=Low, 2=Medium, 3=High
  image_query     String? // Search term for clinical images

  // =========================================================================
  // WORKFLOW & METADATA
  // =========================================================================
  status  String @default("draft") // draft, pending_review, approved, published, archived
  version Int    @default(1)

  createdAt   DateTime  @default(now())
  createdBy   String // User ID
  updatedAt   DateTime  @updatedAt
  updatedBy   String // User ID
  publishedAt DateTime?
  publishedBy String?
  approvedAt  DateTime?
  approvedBy  String?

  /// Relations
  versions  ContentVersion[]
  auditLogs ContentAuditLog[]

  @@index([conditionId])
  @@index([system])
  @@index([relatedSystems])
  @@index([status])
  @@index([createdBy])
  @@index([updatedAt])
}

/// Represents a high-yield medical buzzword
model Buzzword {
  id          String  @id @default(uuid())
  buzzword    String
  condition   String
  system      String // SystemCode
  subcategory String?
  explanation String?

  dailyWords DailyWordle[] // Used in daily Wordle game

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([system])
  @@index([condition])
}

/// Status for Wordle game
enum WordleStatus {
  playing
  won
  lost
}

/// Daily global word selection so all users share the same target
model DailyWordle {
  id     String   @id @default(uuid())
  date   DateTime @unique @db.Date
  wordId String

  word Buzzword @relation(fields: [wordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wordId])
}

/// Per-user Wordle progress for a given date
model UserWordleState {
  id        String       @id @default(uuid())
  userId    String
  date      DateTime     @db.Date
  guesses   String[]     @default([])
  status    WordleStatus @default(playing)
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// Represents a historical version of content
model ContentVersion {
  id                String   @id @default(uuid())
  contentId         String
  version           Int
  content           Json // Snapshot of content at this version
  changeType        String // create, update, delete, publish, unpublish, approve, reject
  changeDescription String?  @db.Text
  changedBy         String // User ID
  changedAt         DateTime @default(now())

  medicalContent MedicalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([contentId])
  @@index([changedBy])
  @@index([changedAt])
}

/// Audit log for all content changes (immutable)
model ContentAuditLog {
  id                String   @id @default(uuid())
  contentId         String
  conditionId       String
  version           Int
  changeType        String // create, update, delete, publish, unpublish, approve, reject
  changeDescription String?  @db.Text
  changedFields     String[] // Array of field names that changed
  oldValues         Json? // Previous values (for updates)
  newValues         Json? // New values (for updates)
  changedBy         String // User ID
  changedByRole     String // admin, superadmin
  changedAt         DateTime @default(now())
  ipAddress         String?
  userAgent         String?  @db.Text

  medicalContent MedicalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([conditionId])
  @@index([changedBy])
  @@index([changedAt])
  @@index([changeType])
}

/// Content health report from nightly audits
model ContentHealthReport {
  id                  String   @id @default(uuid())
  timestamp           DateTime @default(now())
  totalContent        Int
  missingExplanations Int      @default(0)
  brokenMediaLinks    Int      @default(0)
  invalidFields       Int      @default(0)
  outdatedContent     Int      @default(0)
  reportData          Json // Full report details

  @@index([timestamp])
}

/// Pre-generated AI questions for instant delivery
model PreGeneratedQuestion {
  id           String    @id @default(uuid())
  questionType String // "vignette", "mcq", "clinical"
  system       String? // System code
  conditionId  String? // Related condition
  difficulty   String // "easy", "medium", "hard"
  questionData Json // Full question structure
  generatedAt  DateTime  @default(now())
  usedAt       DateTime?
  usedBy       String? // User ID who received this question
  quality      Int? // AI quality score 1-10

  @@index([questionType])
  @@index([system])
  @@index([difficulty])
  @@index([usedAt])
  @@index([generatedAt])
}

/// Background job queue for async processing
model BackgroundJob {
  id           String    @id @default(uuid())
  jobType      String // "generate_questions", "health_check", "media_processing"
  status       String    @default("pending") // pending, processing, completed, failed
  priority     Int       @default(5) // 1-10, higher = more important
  payload      Json // Job-specific data
  result       Json? // Job result data
  error        String?   @db.Text
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  scheduledFor DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([jobType])
  @@index([status])
  @@index([scheduledFor])
  @@index([priority, status])
}

/// Real-time collaboration tracking
model ContentLock {
  id        String   @id @default(uuid())
  contentId String   @unique
  lockedBy  String // User ID
  lockedAt  DateTime @default(now())
  expiresAt DateTime // Auto-release after timeout

  @@index([contentId])
  @@index([lockedBy])
  @@index([expiresAt])
}

/// Offline sync queue for resilience
model SyncQueue {
  id         String    @id @default(uuid())
  userId     String
  operation  String // "save_progress", "submit_quiz", "update_settings"
  data       Json // Operation data
  status     String    @default("pending") // pending, synced, failed, dead_letter
  attempts   Int       @default(0)
  maxRetries Int       @default(5) // Maximum retry attempts before moving to DLQ
  lastError  String?   @db.Text
  createdAt  DateTime  @default(now())
  syncedAt   DateTime?
  error      String?   @db.Text

  // Version tracking for conflict resolution
  version          Int     @default(1)
  conflictDetected Boolean @default(false)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([attempts])
}

/// Represents educational resources (textbooks, lectures, PDFs)
model EducationalResource {
  id               String  @id @default(uuid())
  title            String
  resourceType     String // "textbook" | "lecture" | "pdf" | "video" | "slides"
  fileUrl          String? // Storage URL for the resource
  originalFilename String? // Original file name when uploaded

  /// Content extraction
  extractedText String?  @db.Text // Full text extracted from resource
  summary       String?  @db.Text // AI-generated summary
  keyTopics     String[] // Extracted medical topics/conditions

  /// Metadata
  author     String?
  source     String? // Textbook name, lecture series, etc.
  pageNumber Int? // For textbook excerpts
  duration   Int? // For videos/lectures (in seconds)
  mimeType   String?
  fileSize   Int?

  /// Linkage to conditions
  conditionIds String[] // Array of related condition IDs
  systemCodes  String[] // CV, PULM, GI, etc.

  /// Approval workflow
  approvalStatus  String    @default("pending") // "pending" | "approved" | "rejected"
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?   @db.Text
  qualityScore    Float? // 0-100 quality/relevance score

  /// Tracking
  uploadedBy String?
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Usage analytics
  viewCount      Int       @default(0)
  lastAccessedAt DateTime?

  @@index([resourceType])
  @@index([approvalStatus])
  @@index([keyTopics])
  @@index([systemCodes])
  @@index([uploadedBy])
  @@index([approvedAt])
}

/// Represents a flagged question reported by a user
model QuestionFlag {
  id            String  @id @default(uuid())
  userId        String // User who flagged the question
  userEmail     String? // Email for notification
  userFirstName String? // User's first name for personalized emails
  questionId    String // Unique identifier for the question
  questionText  String  @db.Text
  correctAnswer String?
  topic         String?
  system        String?
  flagType      String // "typo", "incorrect_answer", "unclear", "outdated", "other"
  description   String  @db.Text // User's description of the issue
  status        String  @default("pending") // pending, under_review, fixed, wont_fix, duplicate
  priority      String  @default("medium") // low, medium, high, critical

  /// Admin tracking
  assignedTo     String? // Admin user ID
  reviewedBy     String? // Admin who reviewed/fixed
  reviewedAt     DateTime?
  resolutionNote String?   @db.Text // Admin's note about the fix

  /// Notification tracking
  notificationSent Boolean   @default(false)
  notifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([questionId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([status, priority]) // For admin queue sorting
}

/// Semantic cache for AI-generated questions
model SemanticCache {
  id             String   @id @default(uuid())
  queryText      String   @db.Text // Original query/prompt
  queryEmbedding String?  @db.Text // Vector embedding as JSON
  questionType   String // "vignette", "mcq", "clinical"
  system         String?
  difficulty     String?
  cachedQuestion Json // The generated question data
  generatedAt    DateTime @default(now())
  lastUsedAt     DateTime @default(now())
  useCount       Int      @default(1)
  qualityScore   Float    @default(0) // User feedback quality

  @@index([queryText(ops: raw("gin_trgm_ops"))], type: Gin) // PostgreSQL trigram for similarity
  @@index([questionType])
  @@index([system])
  @@index([lastUsedAt])
}

/// Question version history for time travel
model QuestionHistory {
  id           String    @id @default(uuid())
  questionId   String // The question identifier
  version      Int // Version number
  questionData Json // Complete question snapshot
  changedBy    String? // User/system that made the change
  changeReason String?   @db.Text
  validFrom    DateTime  @default(now())
  validTo      DateTime? // Null for current version

  @@unique([questionId, version])
  @@index([questionId])
  @@index([validFrom])
  @@index([questionId, validFrom]) // For time-travel queries
}

/// Content branches for Git-like version control
model ContentBranch {
  id          String  @id @default(uuid())
  name        String // "main", "2026-guideline-update", etc.
  description String? @db.Text
  baseBranch  String? // Parent branch name
  status      String  @default("active") // active, merged, archived

  /// Branch metadata
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  mergedAt      DateTime?
  mergedBy      String?
  mergeCommitId String?

  /// Statistics
  contentCount Int @default(0)
  changeCount  Int @default(0)

  /// Relations
  changes BranchChange[]

  @@unique([name])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
}

/// Individual changes within a content branch
model BranchChange {
  id           String @id @default(uuid())
  branchId     String
  contentId    String // Reference to MedicalContent
  conditionId  String
  changeType   String // create, update, delete
  contentData  Json // The changed content
  previousData Json? // For updates/deletes

  createdBy String
  createdAt DateTime @default(now())

  branch ContentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([contentId])
  @@index([conditionId])
  @@index([createdAt])
}

