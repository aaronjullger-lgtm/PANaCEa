  mechanismOfAction   String?
  indications         String[]
  contraindications   String[]
  dosing              String?
  tags                String[]
  isHighYield         Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  aliases             String[]
  antidote            String?
