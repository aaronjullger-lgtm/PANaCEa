/// Represents a vetted, high-quality question in the "Golden Repository"
/// Task 110: The "Golden Repository"
model Question {
  id            String @id @default(uuid())
  vignette      String @db.Text
  question      String @db.Text
  options       Json // Array of strings
  correctAnswer String
  explanation   String @db.Text

  // Metadata
  system     String // CV, PULM, etc.
  tags       Json? // Array of strings
  difficulty String // easy, medium, hard
  source     String // "ai_generated", "manual", "hybrid"

  // Stats
  timesSeen    Int @default(0)
  timesCorrect Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([system])
  @@index([difficulty])
}

/// Represents a generated question waiting for validation
/// Task 108: The "Staging Lake" Architecture
model StagingQuestion {
  id            String @id @default(uuid())
  vignette      String @db.Text
  question      String @db.Text
  options       Json
  correctAnswer String
  explanation   String @db.Text

  // Metadata
  system     String
  tags       Json?
  difficulty String

  // AI Generation Metadata
  generationPrompt String? @db.Text
  aiModel          String?

  // Grading/Validation
  status      String  @default("pending") // pending, graded, approved, rejected
  aiGrade     Json? // { score: number, issues: string[] }
  adminReview String? @db.Text

  createdAt DateTime @default(now())

  @@index([status])
  @@index([system])
}

/// Tracks which questions a user has seen to prevent repeats
/// Task 109: "Infinite" No-Repeat Logic
model UserQuestionHistory {
  id         String @id @default(uuid())
  userId     String
  questionId String

  // Performance
  isCorrect Boolean
  seenAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

/// Tracks every attempt for audit trails and ranked vs sandbox separation
model QuestionAttempt {
  id              String   @id @default(uuid())
  userId          String
  questionId      String
  questionType    String?
  system          String?
  conditionId     String?
  mode            String?
  wasCorrect      Boolean  @default(false)
  isRankedAttempt Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([mode])
  @@index([isRankedAttempt])
}

/// Stores high-yield clinical pearls extracted from questions
/// Task 112: The "Pearl" Harvester
model ClinicalPearl {
  id              String   @id @default(uuid())
  pearlText       String   @db.Text
  fullExplanation String?  @db.Text
  questionId      String?
  system          String
  category        String?
  tags            String[]
  usefulVotes     Int      @default(0)
  viewCount       Int      @default(0)
  extractedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userPearls UserPearl[]

  @@index([system])
  @@index([category])
  @@index([questionId])
}

/// Stores results from the Patient Encounter (OSCE) mode
model EncounterResult {
  id     String @id @default(uuid())
  userId String
  caseId String

  // Performance
  score    Json // { overall: number, history: number, physical: number, ... }
  feedback String @db.Text

  // Detailed Data
  phasesData Json // Snapshot of the interaction (questions asked, tests ordered, etc.)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([caseId])
}

/// Represents a pharmacological drug
model Drug {
  id                String   @id @default(uuid())
  genericName       String   @unique
  brandName         String?
  drugClass         String[]
  mechanismOfAction String?
  indications       String[]
  contraindications String[]
  sideEffects       String[]
  interactions      String[]
  dosing            String?
  displayName       String?
  aliases           String[]
  tags              String[]
  isHighYield       Boolean  @default(false)

  // Extended fields
  clinicalNotes String?
  antidote      String?
  metabolism    String?
  elimination   String?

  // ===== NEW: PANCE Prioritization =====
  panceYield      Int? // 1=Low, 2=Medium, 3=High PANCE yield
  isFirstLine     Boolean  @default(false) // First-line treatment for any condition
  boardYieldFacts String[] @default([]) // High-yield facts for boards

  // ===== NEW: Detailed Pharmacology =====
  mechanismDetailed String? @db.Text // Full mechanism explanation
  pharmacokinetics  Json? // { absorption, distribution, metabolism, elimination, halfLife, bioavailability }
  absorption        String? // Oral absorption characteristics
  distribution      String? // Vd, protein binding
  metabolismDetail  String? // CYP enzymes, active metabolites
  eliminationRoute  String? // Renal, hepatic, fecal
  halfLife          String? // Terminal half-life
  onsetOfAction     String? // Time to effect
  peakEffect        String? // Time to peak
  duration          String? // Duration of effect
  bioavailability   String? // Oral bioavailability percentage

  // ===== NEW: Special Populations =====
  pregnancyCategory String? // A, B, C, D, X or new labeling
  pregnancyNotes    String? @db.Text // Specific pregnancy considerations
  lactationSafety   String? // Safe, Caution, Contraindicated
  lactationNotes    String? @db.Text
  pediatricDosing   String? @db.Text // Weight-based dosing, age restrictions
  pediatricNotes    String? @db.Text
  geriatricDosing   String? @db.Text // Adjusted dosing for elderly
  geriatricNotes    String? @db.Text
  renalDosing       String? @db.Text // CrCl-based adjustments
  hepaticDosing     String? @db.Text // Child-Pugh adjustments

  // ===== NEW: Safety & Monitoring =====
  blackBoxWarnings String[] @default([]) // FDA black box warnings
  riskStrategies   String[] @default([]) // REMS programs
  monitoringParams String[] @default([]) // Required monitoring (labs, vitals)
  reversalAgent    String? // Antidote/reversal agent
  toxicity         String?  @db.Text // Overdose presentation and management
  maxDailyDose     String? // Maximum safe daily dose

  // ===== NEW: Clinical Pearls & Teaching =====
  clinicalPearls   String[] @default([]) // Key clinical points
  commonMistakes   String[] @default([]) // Common prescribing errors
  mnemonics        String[] @default([]) // Memory aids
  testQuestionTips String[] @default([]) // Board exam tips

  // ===== NEW: Drug Interactions (Detailed) =====
  majorInteractions Json? // [{ drug, severity, mechanism, clinicalEffect, management }]
  cyp450Effects     Json? // { inhibits: [], induces: [], substrates: [] }
  foodInteractions  String[] @default([]) // Food/beverage interactions

  // ===== NEW: Administration =====
  routesOfAdmin       String[] @default([]) // PO, IV, IM, SC, etc.
  formulations        String[] @default([]) // Tablet, capsule, solution, etc.
  administrationTips  String?  @db.Text // How to take/give properly
  storageRequirements String? // Storage conditions

  // ===== NEW: Cost & Access =====
  genericAvailable Boolean @default(false)
  typicalCost      String? // $, $$, $$$, $$$$
  insuranceTier    Int? // Formulary tier 1-4

  // ===== NEW: Relations =====
  conditionLinks DrugConditionLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([genericName])
  @@index([panceYield])
  @@index([isFirstLine])
}

/// Represents a study group for social learning
model StudyGroup {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique // Join code
  description String? @db.Text
  ownerId     String
  isPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members StudyGroupMember[]

  @@index([code])
  @@index([ownerId])
}

/// Represents a member of a study group
model StudyGroupMember {
  id       String   @id @default(uuid())
  userId   String
  groupId  String
  role     String   @default("member") // member, admin
  joinedAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

/// Represents a professional cohort (class, program, or study group)
model Cohort {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique // Join code for invitations
  description String? @db.Text
  institution String?
  isPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   CohortMember[]
  peerStats PeerStatistic[]

  @@index([name])
  @@index([isPublic])
}

/// Links users to cohorts with roles
model CohortMember {
  id       String     @id @default(uuid())
  userId   String
  cohortId String
  role     CohortRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([cohortId])
  @@index([userId])
}

/// Cached peer statistics for percentile calculations
model PeerStatistic {
  id         String   @id @default(uuid())
  userId     String
  cohortId   String?
  system     String
  accuracy   Float
  percentile Float
  recordedAt DateTime

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort? @relation(fields: [cohortId], references: [id])

  @@unique([userId, cohortId, system, recordedAt])
  @@index([userId, recordedAt])
  @@index([cohortId, recordedAt])
}

enum CohortRole {
  ADMIN
  MEMBER
}

/// Represents an active Patient Encounter / OSCE session
model PatientEncounterSession {
  id        String               @id @default(uuid())
  userId    String
  caseId    String
  case      PatientEncounterCase @relation(fields: [caseId], references: [id])
  startTime DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  status    String               @default("active") // "active", "completed", "abandoned"
  messages  Json // Array of chat messages: { role: "user"|"model", content: "..." }[]

  // Clinical data collected during the session
  physicalFindings Json? // Array of findings
  diagnosticOrders Json? // Array of orders
  diagnosis        String?
  treatmentPlan    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Represents a clinical case for the Patient Encounter / OSCE mode
model PatientEncounterCase {
  id             String @id @default(uuid())
  patientName    String
  chiefComplaint String
  age            Int
  sex            String // "M", "F", "Other"

  // JSON fields for structured data
  vitalSigns       Json // { bp, hr, rr, temp, o2sat }
  historyData      Json // Key-value pairs of history info
  physicalExamData Json // Key-value pairs of exam findings
  labData          Json // Key-value pairs of lab results

  // Evaluation criteria
  essentialQuestions   String[]
  helpfulQuestions     String[]
  unnecessaryQuestions String[]

  // Outcome data
  correctDiagnosis      String
  differentialDiagnoses String[]
  idealWorkup           String[]
  teachingPoints        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions PatientEncounterSession[]
}

/// Represents a clinical guideline for scoring drills (e.g., Wells, CURB-65)
model ClinicalGuideline {
  id              String  @id // e.g. "wells-dvt"
  name            String
  description     String
  clinicalContext String?
  maxScore        Int

  components Json // GuidelineComponent[]
  scoringMap Json? // ScoreTier[]
  vignettes  Json // GuidelineCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Represents an imaging study
model ImagingStudy {
  id                String   @id @default(uuid())
  name              String   @unique
  modality          String // XR, CT, MRI, US, Nuclear, Fluoroscopy
  bodyRegion        String?
  usesContrast      Boolean  @default(false)
  usesRadiation     Boolean  @default(false)
  description       String?  @db.Text
  indications       String[]
  contraindications String[]

  // ===== NEW: PANCE Prioritization =====
  panceYield      Int? // 1=Low, 2=Medium, 3=High
  isHighYield     Boolean  @default(false)
  boardYieldFacts String[] @default([])

  // ===== NEW: Technical Details =====
  protocol      String? @db.Text // Standard imaging protocol
  preparation   String? @db.Text // Patient preparation
  contrastType  String? // IV, oral, rectal, none
  contrastAgent String? // Specific agent used
  radiationDose String? // Typical radiation exposure
  scanDuration  String? // Typical scan time

  // ===== NEW: Clinical Decision Making =====
  firstLineFor  String[] @default([]) // Conditions where this is first-line
  alternativeTo String[] @default([]) // Alternative imaging options
  advantages    String[] @default([])
  limitations   String[] @default([])
  whenToAvoid   String[] @default([]) // Specific situations

  // ===== NEW: Findings & Interpretation =====
  normalFindings String?  @db.Text
  keyFindings    Json? // [{ finding, significance, associatedConditions }]
  classicSigns   String[] @default([]) // Named radiologic signs
  reportTemplate String?  @db.Text

  // ===== NEW: Safety =====
  pregnancySafety     String? // Safe, Caution, Contraindicated
  renalConsiderations String? @db.Text // Contrast and renal function
  allergyProtocol     String? @db.Text // Contrast allergy prevention

  // ===== NEW: Teaching Points =====
  clinicalPearls   String[] @default([])
  commonMistakes   String[] @default([])
  testQuestionTips String[] @default([])

  // ===== NEW: Relations =====
  conditionLinks ImagingConditionLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modality])
  @@index([bodyRegion])
  @@index([panceYield])
