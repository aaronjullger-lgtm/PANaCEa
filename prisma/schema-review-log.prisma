// Dedicated table for FSRS v6 optimization with proper time-series indexes
// =============================================================================

/// ReviewLog: Optimized table for FSRS batch queries and time-series analysis
/// Replaces UserProgress.reviewHistory (Json[]) with queryable relational data
model ReviewLog {
  id        String   @id @default(cuid())
  userId    String
  
  // Question/Content identification
  conditionId      String?  // MedicalContent.conditionId
  medicalContentId String?  // Direct FK to MedicalContent
  questionId       String?  // Source question ID
  questionType     String?  // 'pre_generated' | 'question' | 'seed'
  
  // FSRS v6 State Snapshot (at time of review)
  grade         Int     // FSRS rating: 1 (Again), 2 (Hard), 3 (Good), 4 (Easy)
  state         Int     // 0=New, 1=Learning, 2=Review, 3=Relearning
  stability     Float   // S value at time of review
  difficulty    Float   // D value at time of review
  retrievability Float? // R value at time of review (calculated)
  
  // Timing (critical for FSRS optimization)
  reviewedAt    DateTime @default(now())
  scheduledAt   DateTime? // When this review was scheduled (for adherence tracking)
  elapsedDays   Float?    // Days since last review
  
  // Performance metrics
  responseTimeMs Int?     // Time to answer (milliseconds)
  wasCorrect     Boolean  // Actual correctness (for Brier score calculation)
  
  // Context
  sessionId      String?  // FK to StudySession
  attemptId      String?  // FK to QuestionAttempt
  deviceType     String?  // 'mobile' | 'tablet' | 'desktop'
  
  // System categorization (denormalized for fast aggregation)
  system         String?  // Normalized system code (e.g., 'CV', 'PULM')
  
  // Behavioral telemetry (snapshot)
  telemetry      Json?    // Compact behavioral metrics (MVRT, hesitation, etc.)
  
  // Metadata
  fsrsVersion    String   @default("6.0") // FSRS algorithm version
  createdAt      DateTime @default(now())
  
  // Relations
  User           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  MedicalContent MedicalContent? @relation(fields: [medicalContentId], references: [id], onDelete: SetNull)
  
  // === CRITICAL INDEXES FOR FSRS OPTIMIZER ===
  
  // 1. Time-series queries for optimization (fetch user's reviews in chronological order)
  @@index([userId, reviewedAt])
  
  // 2. Condition-specific optimization (per-topic FSRS params)
  @@index([userId, conditionId, reviewedAt])
  
  // 3. System-level aggregation (cardiovascular, pulmonary, etc.)
  @@index([userId, system, reviewedAt])
  
  // 4. Global time-series for batch processing
  @@index([reviewedAt])
  
  // 5. Condition lookup (for content-based queries)
  @@index([conditionId, reviewedAt])
  
  // 6. Medical content join performance
  @@index([medicalContentId])
  
  // 7. FSRS state filtering (e.g., only Review state cards)
  @@index([userId, state, reviewedAt])
  
  // 8. Grade-based queries (e.g., only "Good" or "Easy" grades)
  @@index([userId, grade, reviewedAt])
}

